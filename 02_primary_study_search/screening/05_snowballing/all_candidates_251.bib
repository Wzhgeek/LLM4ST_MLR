  note = {Snowball round: 1; directions: forward; sources: OpenCitations Index v2; seed records: merged_1486: Requirements Engineering Using Generative AI: Prompts and Prompting Patterns},
  title = {Exploring the Use of Generative AI in Software Development: A Preliminary Study},
  url = {https://doi.org/10.1051/e3sconf/202564504002},
  year = {2025}
}

