@inproceedings{10.1145/3788851.3815058,
author = {Trindade Moura, Fl\'{a}vio and C\'{e}sar da Rocha Seruffo, Marcos},
title = {Translating Multimodal UX Requirements into System Architecture: The Implementation of the UX-Tracking Framework},
year = {2026},
isbn = {9798400724480},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788851.3815058},
doi = {10.1145/3788851.3815058},
abstract = {Evaluating User Experience (UX) in modern interactive systems requires comprehensive methodologies that combine multiple data modalities. This Work-in-Progress paper presents the architectural design and software implementation of the UX-Tracking framework, building upon a validated conceptual model of foundational requirements from a previous work. We detail the system’s transition from theory to a robust microservices architecture comprising four independent modules: (i) cross-platform data capture and instrumentation for Web and Mobile environments, (ii) high-throughput ingestion of multimodal telemetry, (iii) an isolated Artificial Intelligence service for affective computing and data analysis, and (iv) a dynamic visualization layer driven by automated data storytelling. By providing a scalable, open-source infrastructure, this work reduces the methodological fragmentation of existing evaluation tools, offering the Human-Computer Interaction (HCI) community accessible technology for rigorous in-the-wild UX studies.},
booktitle = {Proceedings of the 2026 ACM International Conference on Interactive Media Experiences},
pages = {651–657},
numpages = {7},
keywords = {User Experience, Multimodal Framework, Web Systems, UX-Tracking, System Architecture},
location = {Athlone, Ireland},
series = {IMX '26}
}

@inproceedings{10.1145/3589610.3596273,
author = {Gollenstede, Niklas and Kulau, Ulf and Dietrich, Christian},
title = {reUpNix: Reconfigurable and Updateable Embedded Systems},
year = {2023},
isbn = {9798400701740},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3589610.3596273},
doi = {10.1145/3589610.3596273},
abstract = {Managing the life cycle of an embedded Linux stack is difficult, as we have to integrate in-house and third-party services, prepare firmware images, and update the devices in the field. Further, if device deployment is expensive (e.g. in space), our stack should support multi-mission setups to make the best use of our investment.    With reUpNix, we propose a methodology based on NixOS that provides reproducible, updateable, and reconfigurable embedded Linux stacks. For this, we identify the shortcomings of NixOS for use on embedded devices, reduce its basic installation size by up to 86 percent, and make system updates failure atomic and significantly smaller. We also allow integration of third-party OCI images, which, due to fine-grained file deduplication, require up to 24 percent less on-disk space.},
booktitle = {Proceedings of the 24th ACM SIGPLAN/SIGBED International Conference on Languages, Compilers, and Tools for Embedded Systems},
pages = {40–51},
numpages = {12},
keywords = {NixOS, embedded systems, reproducible systems},
location = {Orlando, FL, USA},
series = {LCTES 2023}
}

