@article{10.1145/3757414,
author = {Liu, Yuanhao and Cao, Qi and Shen, Huawei and Zhang, Kaike and Wu, Yunfan and Cheng, Xueqi},
title = { 'I Know You Are Discriminatory!': Automated Substantiating for Individual Fairness Auditing of AI Systems},
year = {2025},
issue_date = {November 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {7},
url = {https://doi.org/10.1145/3757414},
doi = {10.1145/3757414},
abstract = {Artificial intelligence (AI) systems are playing an increasingly crucial role in people's lives, and their frequent unfair behaviors raise concerns about fairness. To unveil the unfairness in AI systems, researchers conduct fairness auditing on these systems. However, existing fairness auditing works often focus on group fairness while ignoring discriminatory phenomena among individuals. To unearth discriminatory phenomena against individuals within AI systems, this paper proposes an individual fairness auditing framework, termed ''substantiating'', which can identify discrimination instances within AI systems by constructing individual samples. To construct these samples for substantiating, auditors often have to rely on subjective prior knowledge, lacking guidelines on how to construct unfair samples. To address this issue, this paper introduces two categories of automated sample generation methods that can rapidly find unfair samples within a limited number of queries to the system and demonstrate their effectiveness through experiments. This paper evaluates the proposed auditing framework among three categories of stakeholders in AI fairness: auditors, AI model developers, and non-technical personnel. The research findings point out their demand for individual fairness audits of AI systems and highlight how the framework supports a reliable and convenient individual fairness audit.},
journal = {Proc. ACM Hum.-Comput. Interact.},
month = oct,
articleno = {CSCW233},
numpages = {38},
keywords = {ai systems, automated substantiating, individual fairness auditing}
}

@inproceedings{10.1145/3786484.3786552,
author = {Sun, Lingxin},
title = {Designing Inclusive Interfaces: Accessibility Challenges and Solutions in Digital Products},
year = {2026},
isbn = {9798400721267},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786484.3786552},
doi = {10.1145/3786484.3786552},
abstract = {Background: The compliance standards and accessibility of digital products have long been mismatched, and vulnerable groups have borne excessive interaction pressure in key tasks.Methods: The A11y-OPS cycle structure was implemented, with the goal (J) as the core, to achieve comprehensive management of (C) operational risks (R) and (ECE) calibration errors; multi-engine automated detection and AT-in-the-loop manual testing were incorporated into the continuous integration and continuous deployment process, and the traceability matrix was used as a means to consolidate evidence.Results: Across multiple sample sets, the violation density of high, moderate, and low-level violation categories was reduced to 50% to 80% of the original level. The success rate of settlement and login processes was significantly improved, and the median screen reading and navigation time and the distribution range at both ends were narrowed. Compared with the common automation framework, the recall and coverage effects were simultaneously increased, and the audit costs were controlled within a reasonable limit.Conclusion: To achieve interface inclusiveness, A11y-OPS established a standards-based, unified measurement, and verifiable engineering approach, helping to synchronize governance expansion with business goals. Future work is needed to improve generalization and stability for WCAG 3.0, non-web environments, and diverse audiences.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence and Sustainable Development},
pages = {447–456},
numpages = {10},
keywords = {Inclusive interface, WCAG, accessibility assessment, actionable risk, engineering closed loop, screen reader},
location = {
},
series = {ICAISD '25}
}

