@proceedings{10.1145/3736181,
title = {CompEd 2025: Proceedings of the ACM Global Computing Education Conference 2025 - Volume 1},
year = {2025},
isbn = {9798400719295},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {1},
abstract = {Welcome to ACM SIGCSE CompEd 2025. It is my great honor to welcome you to the 3rd ACM Global Computing Education Conference (CompEd 2025), which is being held in Gaborone, Botswana. The Working Groups are meeting on October 21-22, the Doctoral Consortium on October 22, and the main conference from October 23-25, 2025.Every two years, CompEd brings the SIGCSE community to new regions of the world, creating opportunities to grow computing education research in places not traditionally reached by its other conferences. After Chengdu, China (2019) and Hyderabad, India (2023), we are proud to host CompEd on the African continent for the first time.The choice of Botswana is deeply significant. Africa is witnessing rapid growth in computing education and research. Once only a small fraction of participation at SIGCSE conferences, African voices are now emerging with strength and visibility. CompEd 2025 marks not just a geographic milestone, but a moment of growth for our global community.Continuing its mission, CompEd fosters global dialogue, builds partnerships across borders, and amplifies diverse perspectives in computing education. More than a conference, it is a space for collaboration, innovation, and community building.We invite you to celebrate this milestone with us, to engage with colleagues from across the globe, and to help shape the future of computing education together.Welcome to Botswana. Welcome to Africa. Welcome to CompEd 2025.},
location = {Gaborone, Botswana}
}

