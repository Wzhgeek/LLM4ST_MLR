@inproceedings{10.1145/3597503.3639192,
author = {Sa\u{g}lam, Timur and Br\"{o}del, Moritz and Schmid, Larissa and Hahner, Sebastian},
title = {Detecting Automatic Software Plagiarism via Token Sequence Normalization},
year = {2024},
isbn = {9798400702174},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3597503.3639192},
doi = {10.1145/3597503.3639192},
abstract = {While software plagiarism detectors have been used for decades, the assumption that evading detection requires programming proficiency is challenged by the emergence of automated plagiarism generators. These generators enable effortless obfuscation attacks, exploiting vulnerabilities in existing detectors by inserting statements to disrupt the matching of related programs. Thus, we present a novel, language-independent defense mechanism that leverages program dependence graphs, rendering such attacks infeasible. We evaluate our approach with multiple real-world datasets and show that it defeats plagiarism generators by offering resilience against automated obfuscation while maintaining a low rate of false positives.},
booktitle = {Proceedings of the IEEE/ACM 46th International Conference on Software Engineering},
articleno = {113},
numpages = {13},
keywords = {software plagiarism detection, plagiarism obfuscation, obfuscation attacks, code normalization, PDG, tokenization},
location = {Lisbon, Portugal},
series = {ICSE '24}
}

@proceedings{10.1145/3810988,
editor = {Dan-Cristian Stanciu, Bogdan Ionescu, Symeon Papadopoulos, Giorgos Kordopatis-Zilos, Adrian Popescu, Roberto Caldelli, Milica Gerhardt and Vera Schmitt},
title = {MAD '26: Proceedings of the 5th ACM International Workshop on Multimedia AI against Disinformation},
year = {2026},
isbn = {9798400727009},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {It is our great pleasure to welcome you to the 5th ACM International Workshop on Multimedia AI against Disinformation - MAD '26. In today's interconnected digital society, information can be shared with billions of people almost instantly through social media platforms, online services, and real-time communication channels. While these technologies have transformed the way information is created and distributed, they have also accelerated the spread of misinformation, disinformation, and propaganda. Modern AI systems are capable of generating and manipulating images, videos, audio, and text with remarkable realism, making it increasingly difficult to distinguish authentic media from synthetic or altered content. These developments have raised serious concerns regarding the credibility and trustworthiness of digital media. Consequently, there is a growing demand for robust AI-based tools that can effectively detect manipulated content and support journalists, researchers, fact-checkers, and policymakers in combating the spread of false information.Looking ahead, addressing disinformation will require advanced multimodal AI approaches capable of analyzing and verifying information across diverse media formats. Now in its fifth edition, MAD '26 continues to provide a forum for researchers and practitioners to share innovative ideas, emerging technologies, and recent advances in AI-powered disinformation detection, multimedia verification, and mitigation strategies. We hope this workshop will foster fruitful discussions, interdisciplinary collaboration, and new research directions toward building more trustworthy and resilient digital information ecosystems.},
location = {
}
}

