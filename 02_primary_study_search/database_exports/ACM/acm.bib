@inproceedings{10.1145/3768740.3768744,
author = {Cheng, Yuqing and Yan, Jungang and Liu, Xiaolu and Yao, Feng},
title = {A Model-Based Systems Engineering Approach for Space-Ground Integrated Network Resource Allocation System in LEO Mega-Constellations},
year = {2025},
isbn = {9798400720987},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768740.3768744},
doi = {10.1145/3768740.3768744},
abstract = {Low Earth Orbit (LEO) mega-constellations require efficient resource allocation systems to manage complex space-ground integrated networks. Traditional text-based systems engineering approaches face significant challenges in addressing the multi-dimensional design requirements of these systems. This paper proposes a Model-Based Systems Engineering (MBSE) framework based on the MagicGrid methodology, employing MagicDraw and SysML to systematically design resource allocation systems for Low Earth Orbit (LEO) satellite constellations. Our approach analyzes system organization across four dimensions: requirements, behavior, architecture, and performance indicators. This methodology facilitates a systematic design of the resource allocation framework by introducing traceability matrices that ensure verifiable design validation and explicitly link user requirements with the system's logical architecture. The proposed framework transforms empirical design practices into systematic simulation-based approaches, marking the first comprehensive digitization of LEO constellation resource allocation knowledge. Implementation results show improved design consistency and reduced development cycles compared to traditional approaches.},
booktitle = {Proceedings of the 2025 International Conference on Simulation, Modeling and Big Data},
pages = {12–20},
numpages = {9},
keywords = {Digital twin, LEO mega-constellations, Model-Based Systems Engineering, Resource allocation, Space-Ground Integrated Network, SysML},
location = {
},
series = {SMBD '25}
}

