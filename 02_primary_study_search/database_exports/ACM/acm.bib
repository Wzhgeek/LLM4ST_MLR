@book{10.1145/3803520,
author = {Devi, Umamaheswari and Narayanam, Krishnasuri and Caldeira, Vincent and Tantawi, Asser N. and Narayanaswami, Chandra},
title = {Sustainable Computing: State-of-the-Art and Future Outlook},
year = {2026},
isbn = {9798400727795},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The evolution and breakthroughs in the field of computing and communication have ushered in the Fourth Industrial Revolution, promising significantly higher productivity and efficiency in various spheres of work, as well as a better overall quality of life. On the flip side, these benefits are juxtaposed with drawbacks such as the widening digital divide, lack of fairness, and compromised security and privacy, among others.The digital technologies driving this revolution tend to be compute and data intensive, and consequently, power hungry as well as carbon-intensive, making them environmentally unsustainable. Increasingly, many business and enterprise applications are being hosted in data centers and the cloud owing to the multiplexing benefits they provide. This type of workload constitutes a large part of Information and Communication Technologies (ICT) sector and is also amenable to its resources, power, and carbon emissions being optimized. Given the global mandate to achieve net zero emissions of greenhouse gases by 2050, there is genuine concern among policymakers and practitioners to ensure that emissions from the ICT sector, and cloud computing in particular, reach net zero — or even carbon negativity — while continuing to advance in ways that are critical to the global economy and have the potential to support sustainability efforts across other sectors.This minigraph provides an overview of the technologies and practices that define the domain of sustainable computing, which operates with the aim of having zero environmental impact. The various facets of sustainable computing and their interdependencies, which enable the development and adoption of holistic solutions to sustainability challenges of the ICT sector are also discussed.}
}

