abstract = {Aiming at the inefficiency and not enough coverage of traditional Q&amp;A models in the “Introduction to Artificial Intelligence” course, this paper comes up with an AI agent design scheme based on the DeepSeek platform. First of all,it constructs a  knowledge base specific to the course. Then it designs a multimodal interaction interface. Also,it integrats a real-time WeCom push mechanism. Though these steps, it enables 24-hour personalized Q&amp;A for students. The experimental results turn out that the system boosts the student question resolution rate to 92%. What's more, it cuts down teachers' repetitive Q&amp;A workload by 75%. It actually shows quite significant advantages when it comes to solving complex problems like algorithm optimization and formula derivation. This paper offers a practical reference that can be quantified for the implementation of intelligent educational tools in course group scenarios.},
booktitle = {Proceedings of the 2025 2nd International Conference on Computer and Multimedia Technology},
pages = {712–718},
numpages = {7},
keywords = {AI Agent, DeepSeek, Multimodal Learning, Online Education, Q&amp;A System},
