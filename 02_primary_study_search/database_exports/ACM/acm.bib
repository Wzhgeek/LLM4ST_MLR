@inproceedings{10.1145/3764687.3769914,
author = {Hermann, Julia and Jansen, Nadine and Dogang\"{u}n, Ayseg\"{u}l},
title = {Surfacing Tensions in Digital Inclusion: A World Caf\'{e} Synthesis},
year = {2025},
isbn = {9798400720161},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3764687.3769914},
doi = {10.1145/3764687.3769914},
abstract = {Digital inclusion requires more than legal compliance or isolated accessibility fixes; it depends on the meaningful, sustained participation of people with diverse access and support needs in design and decision making. Focusing on people with disabilities in our context, we report findings from an online, interdisciplinary symposium that paired short, thematically targeted keynotes with a World Caf\'{e}. Keynotes from research, practice, and lived experience, covering participatory design in computing education, ethical responsibilities including AI, and practice-centered accessibility, seeded the World Caf\'{e} tables, and the speakers co-facilitated the discussions. Using a deductive–inductive qualitative content analysis of the recorded discussions, we synthesize five practice-grounded tensions: (1) tokenism versus empowered participation, (2) features that benefit many without flattening specific needs, (3) legal mandates versus adoption in everyday work, (4) digital sovereignty as a function of competence, configurability, and control, and (5) prioritization under conflicting access needs. In our case, the symposium format helped surface situated insights and enabled inclusive agenda setting across stakeholders, including experts by experience, practitioners, educators, and HCI researchers. Our contributions are twofold: an empirical map of current tensions grounded in participant accounts, and a methodological positioning of participatory symposia as agenda-setting instruments. We outline implications for technology design, computing education, and policy.},
booktitle = {Proceedings of the 37th Australian Conference on Human-Computer Interaction},
pages = {638–646},
numpages = {9},
keywords = {Digital Inclusion, World Caf\'{e}, Accessibility, People with disabilities, Ethics, Participation},
location = {
},
series = {OzCHI '25}
}

