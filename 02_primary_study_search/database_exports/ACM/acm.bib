@inproceedings{10.1145/3745238.3745280,
author = {Li, Yapeng and Wang, Fengfeng and Chen, Qi and Su, Maogen and Xiang, Pingan},
title = {Research on the Construction Process of Digital Twin Maturity Evaluation Model},
year = {2025},
isbn = {9798400712791},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3745238.3745280},
