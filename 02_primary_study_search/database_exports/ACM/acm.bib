@article{10.1145/3631974,
author = {Zhang, Quanjun and Fang, Chunrong and Ma, Yuxiang and Sun, Weisong and Chen, Zhenyu},
title = {A Survey of Learning-based Automated Program Repair},
year = {2023},
issue_date = {February 2024},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {33},
number = {2},
issn = {1049-331X},
url = {https://doi.org/10.1145/3631974},
doi = {10.1145/3631974},
abstract = {Automated program repair (APR) aims to fix software bugs automatically and plays a crucial role in software development and maintenance. With the recent advances in deep learning (DL), an increasing number of APR techniques have been proposed to leverage neural networks to learn bug-fixing patterns from massive open-source code repositories. Such learning-based techniques usually treat APR as a neural machine translation (NMT) task, where buggy code snippets (i.e., source language) are translated into fixed code snippets (i.e., target language) automatically. Benefiting from the powerful capability of DL to learn hidden relationships from previous bug-fixing datasets, learning-based APR techniques have achieved remarkable performance.In this article, we provide a systematic survey to summarize the current state-of-the-art research in the learning-based APR community. We illustrate the general workflow of learning-based APR techniques and detail the crucial components, including fault localization, patch generation, patch ranking, patch validation, and patch correctness phases. We then discuss the widely adopted datasets and evaluation metrics and outline existing empirical studies. We discuss several critical aspects of learning-based APR techniques, such as repair domains, industrial deployment, and the open science issue. We highlight several practical guidelines on applying DL techniques for future APR studies, such as exploring explainable patch generation and utilizing code features. Overall, our article can help researchers gain a comprehensive understanding about the achievements of the existing learning-based APR techniques and promote the practical application of these techniques. Our artifacts are publicly available at the repository: .},
journal = {ACM Trans. Softw. Eng. Methodol.},
month = dec,
articleno = {55},
numpages = {69},
keywords = {Automatic program repair, deep learning, neural machine translation, AI and software engineering}
}

@inproceedings{10.1145/3789595.3789623,
author = {Karkalas, Sokratis},
title = {YaBRI: A Browser-Based REPL Architecture for Extensible, Event-Driven, and Data-Aware Software Integration},
year = {2026},
isbn = {9798400722721},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789595.3789623},
doi = {10.1145/3789595.3789623},
abstract = {Browser-based code execution environments have become integral to modern software education, developer tooling, and interactive documentation. However, existing browser REPLs often lack extensibility, data observability, and seamless integration with surrounding systems. This paper presents YaBRI (Yet another Browser-based REPL Interface) — a lightweight, embeddable JavaScript REPL designed from a software engineering perspective to support safe, extensible, and data-aware in-browser code execution.YaBRI introduces a modular, event-driven architecture that enables dynamic API injection, allowing hosting applications to expose their own functions and objects directly to the REPL environment without compromising safety. Through a comprehensive event emission system, YaBRI provides deep observability of user interactions, offering real-time analytic capabilities and enabling integration with data pipelines, AI models, and adaptive interfaces. Furthermore, its session persistence layer captures complete execution context—including input, output, and state—supporting reproducibility, learning continuity, and collaborative experimentation.From a software engineering standpoint, YaBRI contributes a generalizable architectural model for client-only, extensible REPL systems, illustrating principles of modular design, runtime adaptability, and data-driven observability. We evaluate its architecture and integration flexibility through practical use cases in education, prototyping, and developer toolchains, and discuss implications for the design of next-generation, browser-based software development environments.},
booktitle = {Proceedings of the 2026 14th International Conference on Software and Information Engineering},
pages = {16–25},
numpages = {10},
keywords = {Browser-based REPL systems, event-driven architecture, observability, runtime extensibility, API injection, GenAI-integration readiness, client-side safety, learning analytics, ATAM evaluation, educational technology},
location = {
},
series = {ICSIE '26}
}

@article{10.1145/3626234,
author = {Lu, Qinghua and Zhu, Liming and Xu, Xiwei and Whittle, Jon and Zowghi, Didar and Jacquet, Aurelie},
title = {Responsible AI Pattern Catalogue: A Collection of Best Practices for AI Governance and Engineering},
year = {2024},
issue_date = {July 2024},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {56},
number = {7},
issn = {0360-0300},
url = {https://doi.org/10.1145/3626234},
doi = {10.1145/3626234},
abstract = {Responsible Artificial Intelligence (RAI) is widely considered as one of the greatest scientific challenges of our time and is key to increase the adoption of Artificial Intelligence (AI). Recently, a number of AI ethics principles frameworks have been published. However, without further guidance on best practices, practitioners are left with nothing much beyond truisms. In addition, significant efforts have been placed at algorithm level rather than system level, mainly focusing on a subset of mathematics-amenable ethical principles, such as fairness. Nevertheless, ethical issues can arise at any step of the development lifecycle, cutting across many AI and non-AI components of systems beyond AI algorithms and models. To operationalize RAI from a system perspective, in this article, we present an RAI Pattern Catalogue based on the results of a multivocal literature review. Rather than staying at the principle or algorithm level, we focus on patterns that AI system stakeholders can undertake in practice to ensure that the developed AI systems are responsible throughout the entire governance and engineering lifecycle. The RAI Pattern Catalogue classifies the patterns into three groups: multi-level governance patterns, trustworthy process patterns, and RAI-by-design product patterns. These patterns provide systematic and actionable guidance for stakeholders to implement RAI.},
journal = {ACM Comput. Surv.},
month = apr,
articleno = {173},
numpages = {35},
keywords = {Responsible AI, ethical AI, trustworthy AI, AI governance, AI engineering, MLOps, software engineering, software architecture, pattern, best practice}
}

@article{10.1145/3635439.3635444,
author = {Arbab, Farhad and Autili, Marco and Ciccozzi, Federico and Poizat, Pascal and Tivoli, Massimo},
title = {Summary of the 5th International Workshop on Automated andverifiable Software sYstem DEvelopment (ASYDE)co-located with the 38th IEEE/ACM ASE 2023},
year = {2023},
issue_date = {January 2024},
publisher = {Association for Computing Machinery},
