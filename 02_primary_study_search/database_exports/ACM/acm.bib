@inproceedings{10.1145/3795546.3795566,
author = {Ren, Daowen and Chen, Wei},
title = {Research on Intellectual Capital Accounting and Innovation Correlation in New - Type R&amp;D Institutions under Blockchain Technology},
year = {2026},
isbn = {9798400721571},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3795546.3795566},
doi = {10.1145/3795546.3795566},
abstract = {As key nodes in the national innovation system, new-type R&amp;D institutions confront severe obstacles from traditional accounting models in the recognition, measurement, and management of their core asset—intellectual capital (IC). The problems of the information opacity, subjectivity in valuation, and difficulties in ownership verification seriously obstruct their financing efficiency and the construction of an innovation ecosystem. This work investigates how the blockchain technology,which are acted as a distributed, tamper-proof, and programmable trust infrastructure, can basically remould the accounting paradigm for IC. We construct a new framework integrated on the basis of blockchain including the entire process of “identification-measurement-recording-reporting” for IC within new-type R&amp;D institutions. This framework integrates specialized smart contracts for rights confirmation, dynamic valuation, and automated revenue distribution, which work on a consortium blockchain with a practical consensus mechanism. We think that the framework obviously improves the objectivity, real-time capability, verifiability, and granularity of accounting information. Moreover, using the correlation analysis and an simulation case study deeply, we display how this blockchain,which are augmented accounting data stream, can effectively show and quantify the micro-dynamic correlations between different components of IC (human, structural, relational) and tangible innovation performance indicators (patent output, technology transfer revenue). This affords a more accurately and timely decision-making foundation for internal governance, external investment, and science &amp; technology policy formulation. The study solves a critical problem in the literature by putting foreword an end-to-end solution tailored for the new-type R&amp;D institutions and explains the transformative potential of the blockchain in linking accounting data to innovation dynamics.},
booktitle = {Proceedings of the 2025 International Conference on Digital Transformation and Management},
pages = {133–138},
numpages = {6},
keywords = {Accounting, Blockchain, Dynamic Valuation, Innovation Performance, Intellectual Capital, New-Type R&amp;D Institutions, Smart Contract},
location = {
},
series = {DTM '25}
}

