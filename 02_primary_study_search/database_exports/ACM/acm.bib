@inproceedings{10.1145/3789037.3789043,
author = {van Meerten, John and Smit, Koen and Leewis, Sam and Versendaal, Johan},
title = {An Ethics-included Ontological Model for the Design and Evaluation of Digital Twins Technology for Spatial Planning},
year = {2026},
isbn = {9798400723223},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789037.3789043},
doi = {10.1145/3789037.3789043},
abstract = {Digital Twins (DTs) are increasingly used in public sector decision-making, particularly in complex domains such as local and regional spatial planning. While their technical capabilities are well established, societal impact and ethical implications remain insufficiently theorized. Because of their complexity, not only in terms of technology but also in the number and diversity of stakeholders, each with their own interests and values, this paper adopts an ethical lens. Drawing on recent critiques that emphasize the representational and performative role of Digital Twins, especially when deployed by governmental organizations, this paper defines the problem space with an ontology to guide the design and evaluation of Digital Twins Technology for spatial planning. By relating principles from different ethical traditions, the ontological model offers a normative orientation for designing and evaluating Digital Twins as socio-technical systems. It aims to inform the development of a normative approach. In doing so, the paper contributes to ongoing debates in the philosophy of technology, through an example addressing the ethical complexity of Digital Twins and laying the groundwork for their responsible design and implementation.},
booktitle = {Proceedings of the 2025 9th International Conference on Software and E-Business},
pages = {86–92},
numpages = {7},
keywords = {Digital Twins, Ethics, Model, Normative, Public, Socio-Technical Systems, Values},
location = {
},
series = {ICSeB '25}
}

@article{10.1145/3757731,
author = {Pandey, Abhishek Kumar and Zeadally, Sherali and Das, Ashok Kumar and Kumar, Neeraj},
title = {Secure Integration of Cyber Engineering and Medical Cyber-Physical System: A Survey and Open Issues},
year = {2025},
issue_date = {January 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {58},
number = {1},
issn = {0360-0300},
url = {https://doi.org/10.1145/3757731},
doi = {10.1145/3757731},
abstract = {Medical Cyber-Physical Systems (MCPS) are the prerequisites for a highly digital environment in medical facilities. All the technologies, methods, and problems that arise in developing MCPS should be mitigated systematically and continuously to meet this need. This study analytically discusses the currently available MCPS models, threat scenarios, attacks, and data breach statistics to evaluate the current security situation of the research community in the MCPS domain. The large and complex components of MCPS comprise many computational and physical aspects, making managing secure reliability challenging. To address this challenge, there is a need for security by design that incorporates built-in security functionality in the development of an MCPS. Our comprehensive review critically analyzes the current state-of-the-art in MCPS by considering various aspects, such as functionality, communication media, design characteristics, and security. Furthermore, we explore the security threats posed by MCPS as well as their potential impact. Finally, we propose a potential future pathway to effectively mitigate the identified threats by providing a promising direction for further investigation.},
journal = {ACM Comput. Surv.},
month = sep,
articleno = {9},
numpages = {36},
keywords = {Medical cyber-physical system, security, cybernetics, smart healthcare, threat}
}

