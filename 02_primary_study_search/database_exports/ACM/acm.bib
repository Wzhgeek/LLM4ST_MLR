@inproceedings{10.1145/3696630.3727253,
author = {Bayat Esfandani, Somayeh and Aalberg, Trond},
title = {The Impact of Multi-Peer Feedback Summary Organization on Review and Implementation of Feedback},
year = {2025},
isbn = {9798400712760},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3696630.3727253},
doi = {10.1145/3696630.3727253},
abstract = {Student peer assessment is commonly utilized in software engineering education and typically students will receive diverse feedback from multiple peers. Summarizing the feedback entries may help alleviate the burden of reading and evaluating the feedback and this study investigates the impact of the visual organization of multi-peer feedback summaries on the feedback review process and implementation likelihood. We conducted an exploratory focus group study and findings emphasize the importance of proper visual organization to ease the review process and likelihood of feedback to be implemented.},
