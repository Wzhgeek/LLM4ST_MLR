@inproceedings{10.1145/3748522.3779962,
author = {Souza, Carlos and Silva, Izabella and Sousa, Hiago and Albuquerque, Danyllo and Perkusich, Mirko and Gorg\^{o}nio, Kyller and Perkusich, Angelo},
title = {Towards a Semi-Automated Pipeline for User Story Curation and Classification},
year = {2026},
isbn = {9798400722943},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3748522.3779962},
doi = {10.1145/3748522.3779962},
abstract = {[Context] User Stories are central in Agile Software Development (ASD) but often lack structural consistency, limiting reuse, automation, and traceability. Although taxonomies exist, their manual application is costly and error-prone. [Objective] We examine whether a semi-automated pipeline that couples rule-based diagnostics with Large Language Models (LLMs) can improve both structural quality and functional classification in real backlogs. [Method] Our pipeline runs AQUSA to detect structural defects, then iteratively rewrites stories with an LLM to conform to QUS. It subsequently classifies stories via structured prompts aligned with the WIS taxonomy, resorting to a fallback that proposes new entries when no category fits. We evaluated 191 stories filtered from 211 items across ten WIS projects, combining automated checks with expert annotations. [Results] On average, 0.66 AQUSA-LLM iterations were needed (most required 1); two AQUSA warnings were false positives. The LLM identified and corrected all true structural defects, achieving a fair-to-moderate level of agreement with two experts. Fifteen of 18 WIS operations were exercised; the fallback proposed two new operations within WIS modules and two non-WIS modules, which were subsequently validated by experts. A reliability check revealed stable classifications for 8 out of 9 stories. [Conclusion] Pairing AQUSA with LLMs meaningfully improves structure and taxonomy-guided classification in real backlogs. The approach is scalable and practical, while still benefiting from human oversight for prompt design and interpretive validation.},
booktitle = {Proceedings of the 41st ACM/SIGAPP Symposium on Applied Computing},
pages = {1717–1726},
numpages = {10},
keywords = {agile software development, user stories, software requirements quality, software reuse, large language models},
location = {Grand Hotel Palace, Thessaloniki, Greece},
series = {SAC '26}
}

@inproceedings{10.1145/3747912.3747913,
author = {Ma, Jie and Li, Kechen and Zhao, Lining and Yu, Tao and Zhu, Xishou},
title = {Digital Twin-Integrated Dynamic Reuse Mechanism for Heterogeneous Functions in Oilfield Software: Towards Secure and Intelligent Collaborative Development},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747913},
doi = {10.1145/3747912.3747913},
abstract = {The heterogeneity of oilfield software ecosystem leads to duplication of function module development, inefficient cross-system collaboration and insufficient security protection, which seriously restricts the digital transformation process. The study proposes a digital twin-driven framework for dynamic reuse of heterogeneous functions, integrating microservice architecture, knowledge graph semantic matching and reinforcement learning optimisation algorithms, and constructing a ‘virtual simulation-dynamic adaptation-security control’ technology chain. Based on the verification of actual data from an oilfield, the module reuse rate has been increased by 42%, the development efficiency has been improved by 36.6%, and the peak consumption of resources has been reduced by 33.4%; and the blockchain-enhanced security mechanism has achieved a 99.1% attack detection rate and 100% data tampering traceability. The framework provides a theoretical model and engineering practice paradigm for oilfield software ecosystem collaboration, and its dynamic reuse mechanism has universal reference value for process industry intelligence.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {1–11},
numpages = {11},
keywords = {Blockchain security, Digital twins, Function reuse, Intelligent Oilfield, Micro service architecture},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3785987.3786106,
author = {Jiang, Shan and Wan, Xiaoqing},
title = {Research on the Reform of Teaching Compiler Principles Empowered by GraphRAG},
year = {2026},
isbn = {9798400720956},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785987.3786106},
doi = {10.1145/3785987.3786106},
abstract = {With the rapid advancement of artificial intelligence technology, traditional teaching models are undergoing profound transformation. Compiler Theory courses are widely regarded as one of the most challenging in computer science due to their abstract theoretical concepts, tightly interconnected knowledge systems, and significant gap between theory and practice. This creates substantial challenges for students' learning process and makes it difficult for instructors to achieve expected teaching objectives. To address these challenges, this paper applies Graph-Augmented Retrieval Generation (GraphRAG) technology to teaching compiler theory. By integrating knowledge graphs with large language models, it visualizes knowledge, enhances AI's personalized semantic question-answering capabilities, and reduces students' knowledge barriers in understanding abstract concepts, thereby achieving intelligent teaching assistance. Through teaching practice, we validated student learning outcomes. Results indicate this method enhances students' comprehension of abstract concepts and improves their self-directed learning abilities to a certain extent, demonstrating practical value.},
booktitle = {Proceedings of the 2025 2nd International Conference on Artificial Intelligence and Future Education},
pages = {718–723},
numpages = {6},
keywords = {Artificial intelligence empowerment, Compiler principles, GraphRAG, Knowledge graph},
location = {
},
series = {AIFE '25}
}

@article{10.1145/3702980,
author = {Majdinasab, Vahid and Nikanjam, Amin and Khomh, Foutse},
title = {Trained without My Consent: Detecting Code Inclusion in Language Models Trained on Code},
year = {2025},
issue_date = {May 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {34},
number = {4},
issn = {1049-331X},
url = {https://doi.org/10.1145/3702980},
doi = {10.1145/3702980},
abstract = {Code auditing ensures that the developed code adheres to standards, regulations, and copyright protection by verifying that it does not contain code from protected sources. The recent advent of Large Language Models (LLMs) as coding assistants in the software development process poses new challenges for code auditing. The dataset for training these models is mainly collected from publicly available sources. This raises the issue of intellectual property infringement as developers’ codes are already included in the dataset. Therefore, auditing code developed using LLMs is challenging, as it is difficult to reliably assert if an LLM used during development has been trained on specific copyrighted codes, given that we do not have access to the training datasets of these models. Given the non-disclosure of the training datasets, traditional approaches such as code clone detection are insufficient for asserting copyright infringement. To address this challenge, we propose a new approach, TraWiC; a model-agnostic and interpretable method based on membership inference for detecting code inclusion in an LLM’s training dataset. We extract syntactic and semantic identifiers unique to each program to train a classifier for detecting code inclusion. In our experiments, we observe that TraWiC is capable of detecting 83.87% of codes that were used to train an LLM. In comparison, the prevalent clone detection tool NiCad is only capable of detecting 47.64%. In addition to its remarkable performance, TraWiC has low resource overhead in contrast to pairwise clone detection that is conducted during the auditing process of tools like CodeWhisperer reference tracker, across thousands of code snippets.},
journal = {ACM Trans. Softw. Eng. Methodol.},
month = apr,
articleno = {87},
numpages = {46},
keywords = {Large Language Models, Intellectual Property Infringement, Code Licensing, Dataset Inclusion Detection, Membership Inference Attack}
}

@article{10.1145/3777518.3777542,
author = {Sommer, Alexander and Bazan, Peter and Babaeian, Behnam and Fellerer, Jonathan and Powell, Warren B. and German, Reinhard},
title = {Adaptive Self-Improvement for Smarter Energy Systems Using Agentic Policy Search},
year = {2025},
issue_date = {September 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {5},
number = {3},
url = {https://doi.org/10.1145/3777518.3777542},
doi = {10.1145/3777518.3777542},
abstract = {Controlling energy systems usually involves manually designed policies for decision-making, which can be complex and time-consuming to develop. This process requires interdisciplinary collaboration among multiple domain experts, resulting in slow and inflexible adaptation to rapidly changing environments. Large Language Models (LLMs) offer a promising paradigm shift by integrating extensive contextual knowledge with the capability to generate structured, executable code.We present Agentic Policy Search (APS)—a novel hierarchical optimization framework in which LLMs act as autonomous agents that propose complete control logics, translate them into executable code, and iteratively improve them through direct system feedback. We apply APS to a residential energy system with PV, battery, demand, and dynamic electricity prices. Within just seven simulated days, the method yields a net profit of up to 6.20 € compared to the no-battery reference scenario (-10.70 €), nearly matching the global optimum of a perfectly informed linear program. By combining LLM-driven policy search with the generation of human-interpretable control logic, APS effectively bridges adaptability and traceability in energy management— while also offering a transferable framework for agentic optimization in other domains.},
journal = {SIGENERGY Energy Inform. Rev.},
month = dec,
pages = {259–274},
numpages = {16},
keywords = {large language models, code generation, hierarchical decision-making, smart energy systems, self-improving systems, energy control, battery management, stochastic optimization, meta-learning}
}

