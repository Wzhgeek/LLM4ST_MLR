url = {https://doi.org/10.1145/3811238.3811550},
doi = {10.1145/3811238.3811550},
abstract = {Repair planning in compliance-critical industrial settings requires engineers to reconcile heterogeneous knowledge sources, including inspection reports, procedure specifications, equipment constraints, and applicable standards. In practice, decision outputs must be both actionable and auditable. This paper presents a pilot demo that couples (i) large language model (LLM)-assisted information extraction for bootstrapping a repair-oriented knowledge graph (KG) in Neo4j and (ii) a dual-layer reasoning engine that integrates retrieval-grounded generation with KG- and rule-based validation. Layer 1 generates candidate plans grounded in retrieved KG facts and supporting documents, while Layer 2 checks standard compliance, process/equipment feasibility, and inter-rule consistency, and flags unresolved conflicts for engineer review. To improve reproducibility, all final pilot runs use the same Open AI-compatible endpoint (Deep Seek API, model: deepseek-chat) with fixed generation settings archived by run ID. The current study should be interpreted as a pilot benchmark rather than a full engineering validation: it demonstrates a reproducible workflow for structured repair planning, traceable evidence packaging, and constraint-aware post-checking, while larger test sets and completed domain-expert evaluation remain future work.},
booktitle = {Proceedings of the 2026 International Conference on Artificial Intelligence and Agents},
articleno = {6},
numpages = {8},
keywords = {Neo4j, explainable decision support, information extraction, knowledge graph, repair planning, retrieval-augmented generation},
location = {
},
series = {ICAIAgent '26}
}

