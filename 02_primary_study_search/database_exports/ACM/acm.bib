@inproceedings{10.1145/3748522.3780008,
author = {Li, Wangfan and Toxtli, Carlos},
title = {Requirement Bot: Enhancing Software User Requirement List Through Retrieval-Augmented Human–AI Co-Authoring},
year = {2026},
