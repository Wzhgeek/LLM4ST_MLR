@CONFERENCE{Talha Talukder20251,
	author = {Talha Talukder, A.A. and Alam, Omar and Azim, Akramul},
	title = {Leveraging LLMs for Automatic Feature Extraction in Embedded Systems to Support Software Reuse},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Information Reuse and Integration and Data Science, IRI 2025},
	pages = {1 - 6},
	doi = {10.1109/IRI66576.2025.00009},
	url = {https://www.scopus.com/pages/publications/105017846606?origin=resultslist},
	affiliations = {Trent University, Peterborough, ON, Canada; Ontario Tech University, Department of Electrical, Computer and Software Engineering, ON, Canada},
	abstract = {Embedded systems often accumulate complex, monolithic code, making identifying and reusing functionality across projects difficult. This paper presents an automated approach for extracting reusable software features from embedded C code using six pre-trained large language models (CodeBERT, GraphCodeBERT, CodeT5, CodeGPT-small, PLBART, and UniXcoder). The system embeds code-level features (e.g., functions and global variables) and textual artifacts (e.g. comments, control-flow conditions, and README entries) into a shared semantic vector space. Cosine similarity matches each feature with its most relevant textual artifact, and a coherence score is assigned to capture the strongest alignment across models. High-confidence matches are then clustered using unsupervised learning to reveal logical subsystems within the codebase. We evaluate the method on a heating system controller by manually curating 14 feature-requirement description pairs. Each feature is a functional unit selected from the code, and each description summarizes its intended behavior. These pairs serve as the benchmark for assessing extraction performance. Our method successfully traced features with 86% recall, using conservative thresholding that accepts only semantically strong matches. Clustering based on coherence scores produced interpretable groupings corresponding to logical subsystems such as heating control, safety monitoring, and user interface. Compared to single-model baselines (with recall as low as 22%), the multimodel ensemble method significantly improved coverage by leveraging the semantic diversity of different LLM models. These results demonstrate the feasibility of combining diverse pretrained embeddings with multiple textual sources to support feature extraction and modular reuse in embedded software.  © 2025 IEEE.},
	author_keywords = {clustering; code embeddings; cosine similarity; embedded systems; feature extraction; large language models (llms); modularization; pre-trained language models; requirements traceability; software reuse},
	keywords = {Benchmarking; C (programming language); Codes (symbols); Computer software reusability; Embedded software; Embeddings; Modular construction; Semantics; Software design; Unsupervised learning; User interfaces; Clusterings; Code embedding; Cosine similarity; Embedded-system; Embeddings; Features extraction; Language model; Large language model; Modularizations; Pre-trained language model; Requirements traceability; Software-reuse; Embedded systems},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159944-7},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Inf. Reuse Integr. Data Sci., IRI},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; Conference name: 26th IEEE International Conference on Information Reuse and Integration and Data Science, IRI 2025; Conference sponsors: IEEE TCMC; Society for Information Reuse and Integration (SIRI); Conference code: 212660; Conference date: 6 August 2025 through 8 August 2025}
}

@CONFERENCE{North2024321,
	author = {North, Marc and Atapour-Abarghouei, Amir and Bencomo, Nelly},
	title = {Code Gradients: Towards Automated Traceability of LLM-Generated Code},
	year = {2024},
	journal = {Proceedings of the IEEE International Conference on Requirements Engineering},
	pages = {321 - 329},
	doi = {10.1109/RE59067.2024.00038},
	url = {https://www.scopus.com/pages/publications/85202781451?origin=resultslist},
	affiliations = {CS, Durham University, Durham, United Kingdom; Method Grid, Bath, United Kingdom},
	abstract = {Large language models (LLMs) have recently seen huge growth in capability and usage. Within software engineering, LLMs are increasingly being used by developers to generate code. Code generated by an LLM can be seen essentially a continuous mapping from requirements to code. This represents a great opportunity within requirements engineering to use this mapping to provide traceability from requirements to LLM-generated code. The challenge is that the black-box nature of LLMs makes it difficult to trace requirements, while traditional approaches require extensive post-hoc testing or expert analysis. In this research preview, we explore the use of LLM explainability techniques to trace LLM-generated code back to requirements. By inspecting the gradients of LLM output, we develop a first attempt at tracing LLM inputs through to its generated code. We use this to estimate which low-level requirements have been met. Furthermore, through an automated iterative process, we re-query the LLM, instructing it to rewrite its code to meet the missing requirements. Our results suggest that the gradients of LLM outputs can be used to trace requirements through LLM code generation and that this traceability could potentially be used to improve generated code to better meet requirements. Future work is required to fully validate this result, but this represents a first step towards automatic traceability and verification of AI generated code.  © 2024 IEEE.},
	author_keywords = {Large Language Models; Requirements Engineering; Traceability},
	keywords = {Black-box testing; Query languages; Query processing; Requirements engineering; Structured Query Language; Black boxes; Code gradients; Continuous mappings; Language model; Large language model; Model outputs; Requirement engineering; Trace requirements; Traceability; Traditional approachs; Mapping},
	editor = {Liebel G. and Hadar I. and Spoletini P.},
	publisher = {IEEE Computer Society},
	issn = {1090705X},
	isbn = {979-835039511-2},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Requir. Eng.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 18; Conference name: 32nd IEEE International Requirements Engineering Conference, RE 2024; Conference sponsors: ; Conference code: 201946; Conference date: 24 June 2024 through 28 June 2024; All Open Access; Green Open Access}
}

@ARTICLE{Lomovtsev2026,
	author = {Lomovtsev, Alexander},
