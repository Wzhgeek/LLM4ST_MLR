@ARTICLE{Shafikuzzaman2025159439,
	author = {Shafikuzzaman, Md and Islam, Md Rakibul and Zaman, Shuaib and Ma, Andrew and Islam Sifat, Anwarul},
	title = {On the Effectiveness of Zero-Shot and Few-Shot Pretrained Language Models for Software Requirement Classification},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {159439 - 159453},
	doi = {10.1109/ACCESS.2025.3607813},
	url = {https://www.scopus.com/pages/publications/105015477813?origin=resultslist},
	affiliations = {Lamar University, Department of Computer Science, Beaumont, 77705, TX, United States; California State University at Los Angeles, Department of Computer Science, Los Angeles, 90032, CA, United States; West Brook High School, Beaumont, 77706, TX, United States; Lamar University, Phillip M. Drayer Department of Electrical and Computer Engineering, Beaumont, 77705, TX, United States},
	abstract = {Accurate classification of software requirements, particularly distinguishing between fun- ctional and non-functional requirements, is essential for enabling traceability, guiding system design, and ensuring project success. Traditional supervised machine learning methods have shown promise in this domain but suffer from limited generalizability, high labeling costs, and overfitting. Recent advances in pretrained language models (PLMs) offer new opportunities for effective requirement classification through zero-shot (ZS) and few-shot (FS) learning. This study investigates the effectiveness of ZS and FS PLMs, including prompt-based generative large language models (e.g., GPT-4o and Llama3), in classifying functional vs. non-functional requirements and non-functional subtypes, such as usability, security, operational, and performance requirements. We conduct a comprehensive empirical evaluation across five classification tasks using two widely adopted datasets: PROMISE and SecReq. The study compares six PLMs, including two ZS, two FS transformer models, and two generative Large Language Models under both ZS and FS settings. We benchmark these models against state-of-the-art and domain-specific baselines, and complement the quantitative analysis with a detailed qualitative error analysis. FS models, such as All-MPNET, All-DistilRoBERTa, and GPT-4o in the FS setting, consistently outperform ZS models across all tasks, achieving superior performance in multi-class NFR and security requirement classification. While NoRBERT remains superior in binary FR/NFR classification, our FS models outperform or match its performance in other scenarios. ZS models, such as GPT-4o, also demonstrate strong results without requiring training data, highlighting their practical utility. Error analysis reveals that annotation issues and lack of context are major sources of misclassification. Our findings establish that ZS and FS PLMs, especially prompt-based generative large language models, offer viable and scalable alternatives to traditional supervised approaches. This study lays the foundation for the broader adoption of prompt-based PLMs in requirement engineering. © 2013 IEEE.},
	author_keywords = {few-shot; GPT-4o; Requirement classification; software engineering; zero-shot},
	keywords = {Computer software; Learning systems; Requirements engineering; Supervised learning; Systems analysis; Few-shot; Functionals; GPT-4o; Language model; Non-functional requirements; Performance; Requirements classifications; Security requirements; Software requirements; Zero-shot; Classification (of information)},
	correspondence_address = {M.R. Islam; Lamar University, Department of Computer Science, Beaumont, 77705, United States; email: mislam108@lamar.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
