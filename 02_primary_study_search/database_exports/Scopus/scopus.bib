@CONFERENCE{Arora20254,
	author = {Arora, Chetan},
	title = {RAG to RichEs: Bridging RE Automation Pains with RAG Gains: Keynote Abstract},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 33rd International Requirements Engineering Conference Workshops, REW 2025},
	pages = {4},
	doi = {10.1109/REW66121.2025.00005},
	url = {https://www.scopus.com/pages/publications/105020981467?origin=resultslist},
	affiliations = {Monash University, Faculty of It, Melbourne, Australia},
	abstract = {We've all felt it: the gap between what stakeholders say, what developers understand, and what actually gets built. Requirements Engineering (RE) has always been a delicate dance - and often, a painful one. Enter Large Language Models (LLMs), and suddenly the dance floor is crowded with auto-generated specifications, hallucinated user stories, and AIpowered enthusiasm. But enthusiasm alone doesn't bridge RE gaps. This keynote presents our work on Retrieval-Augmented Generation (RAG) as a way to anchor LLMs in real, contextual information - such as domain documents, UI wireframes, or stakeholder updates. Based on evaluations in real-world settings, RAG-based approaches consistently outperform "vanilla"LLMs on RE automation tasks by keeping generation grounded and focused. We will explore how RAG helps address core automation challenges in RE, share what worked (and what didn't), and reflect on why RAG is more than another AI buzzword. While not a silver bullet, RAG offers a promising path to contextual, traceable, and human-aligned RE automation.  © 2025 IEEE.},
	author_keywords = {Large Language Models(LLMs); Requirements Engineering; Retrieval-Augmented Generation (RAG)},
