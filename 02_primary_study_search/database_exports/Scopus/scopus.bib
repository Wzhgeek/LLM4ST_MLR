@CONFERENCE{Schüring2025249,
	author = {Schüring, Ben Luca and Herrmann, Marc and Specht, Alexander and Ehl, Marco and Elsofi, Duaa Adel Ali and Großer, Katharina and Jürjens, Jan and Schneider, Kurt},
