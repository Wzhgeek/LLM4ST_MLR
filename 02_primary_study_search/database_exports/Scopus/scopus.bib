}

@CONFERENCE{Chovanec2025169,
	author = {Chovanec, Daniel and Kollár, Boris and Ristvej, Jozef and Jelšík, Jozef and Andrassy, Vladimír},
	title = {APPLICATION OF ARTIFICIAL INTELLIGENCE FOR DECISION SUPPORT WITHIN CRISIS MANAGEMENT},
	year = {2025},
	journal = {Modelling and Simulation 2025 - 39th Annual European Simulation and Modelling Conference 2025, ESM 2025},
	pages = {169 - 173},
	url = {https://www.scopus.com/pages/publications/105024202279?origin=resultslist},
	affiliations = {Department of Crisis Management, University of Žilina, www.uniza.sk Univerzitná 1, Žilina, 01026, Slovakia; Department of Crisis Management, University of Žilina, www.uniza.sk Univerzitná 1, Žilina, 0126, Slovakia; Department of Math. Methods and Operations Research, University of Žilina, www.uniza.sk Univerzitná 1, Žilina, 0126, Slovakia; Department of Security and Defence, Armed Forces Academy of General Milan Rastislav Štefánik, Demänová 393, Liptovský Mikuláš, 031 01, Slovakia},
	abstract = {Artificial intelligence (AI) can process vast amounts of data that would normally be difficult for human teams to handle or would require an enormous amount of time. Its potential is especially high when it comes to analysing documents and providing the right information precisely when it is most needed. By examining these data, AI can generate recommendations, propose effective steps for resolving crisis situations, identify critical points and vulnerabilities, predict possible development scenarios, and suggest suitable preventive or reactive measures. Retrieval-Augmented Generation (RAG) couples large language models (LLMs) with an external knowledge base, dynamically injecting retrieved passages into the prompt to ground generative outputs in verifiable facts. Since its introduction in 2020, RAG has improved factuality and traceability across knowledge-intensive NLP tasks. Recent prototypes (e.g. SafeMate and WildfireGPT) show promise for high-stakes domains such as disaster response, where operators must fuse live sensor feeds, historical incident reports and procedural documents under severe time constraints. We survey RAG's core architecture, present an open-source prototype using FAISS, Sentence-BERT and LLaMA-2, and discuss concrete emergency-service use case. Empirical evidence indicates that RAG-grounded answers outperform baseline LLM outputs in correctness, relevance and completeness. Limitations such as hallucination risk, data-quality dependence, human and AI trust are analysed, along with mitigation strategies such as hierarchical retrieval (RAPTOR) and chain-of-verification. We conclude that RAG is a compelling, yet cautiously adoptable, addition to crisis management toolkits. © 2025 Modelling and Simulation 2025 - 39th Annual European Simulation and Modelling Conference 2025, ESM 2025. All rights reserved.},
	author_keywords = {Artificial Intelligence; Crisis Management; Decision Support},
	keywords = {Computer aided software engineering; Decision making; Emergency services; Knowledge based systems; Open systems; Crises situations; Crisis management; Decision supports; Development scenarios; Disaster-response; External knowledge; Incident reports; Language model; Open-source; Time constraints; Decision support systems},
	editor = {Bhonsale S.S. and Polanska M.E. and Impe J.F.M.V.},
	publisher = {EUROSIS},
	isbn = {978-949285938-9},
	language = {English},
	abbrev_source_title = {Modelling Simul. - Annu. European Simul. Model. Conf. , ESM},
	type = {Conference paper},
