@CONFERENCE{Amin2026331,
	author = {Amin, Md Faizul Ibne and Watanobe, Yutaka and Rahman, Md. Mostafizer and Mia, Md. Shahajada and Muepu, Daniel M.},
	title = {Source Code Error Categorization and Explanation by Retrieval Augmented Generation},
	year = {2026},
	journal = {2026 International Conference on Advances in Artificial Intelligence and Machine Learning, AAIML 2026},
	pages = {331 - 336},
	doi = {10.1109/AAIML67890.2026.11498214},
	url = {https://www.scopus.com/pages/publications/105040527026?origin=resultslist},
	affiliations = {The University of Aizu, Dept. of Computer and Information Systems, Aizu-Wakamatsu, Japan; Tulane University, Dept. of Computer Science, New Orleans, United States},
	abstract = {Large language models (LLMs) are highly capable across various tasks but can sometimes be prone to hallucination, stale knowledge, and ungrounded explanations. Retrievalaugmented generation (RAG) mitigates these by conditioning outputs on retrieved, up-to-date domain evidence, improving factual accuracy and traceability without retraining. However, in educational source code analysis, producing grounded error explanations alongside consistent multi-label categorizations, especially at fine granularity, remains underexplored. This study investigates a controlled BM25-based RAG pipeline for Python student submissions, producing a citation-backed error explanation and a set of predicted labels from two ontologies (58 original and 11 summarized labels). Code-only shards are indexed with BM25, each erroneous submission retrieves similar examples (self-retrieval), and a fixed LLM (gpt-4o-mini, temperature =0) prompt outputs structured predictions, explanations, citations, and confidence. Retrieval quality is saturated for both ontologies (Recall @10=1.0; M R R ≈ 1.0), confirming that retrieval is not a bottleneck. However, label correctness and evidence-supported reasoning degrade sharply under the 58-label ontology, whereas the 11 -label ontology yields substantially higher standard and faithful F1 scores and more consistent grounding. A small qualitative assessment using an LLM-as-judge further shows that both ontologies produce reasonably clear explanatory feedback with small pedagogical improvements under fine-grained labeling. These results establish a transparent and reproducible baseline for RAG-based error feedback, clarifying how ontology granularity drives correctness, groundedness, and interpretability in programming learning systems. © 2026 IEEE.},
	author_keywords = {BM25; error categorization and explanation; LLM; programming learning; RAG; source code analysis},
	keywords = {Computer systems programming; Education computing; Errors; Feedback; Information retrieval; Intelligent systems; Learning systems; Ontology; Software engineering; Teaching; Bm25; Error categorizations; Error explanation; Language model; Large language model; Ontology's; Programming learning; Retrievalaugmented generation; Source code analysis; Source codes; Codes (symbols)},
