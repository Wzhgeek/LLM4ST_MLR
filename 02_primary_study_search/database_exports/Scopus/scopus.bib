@CONFERENCE{Wang2025812,
	author = {Wang, Wenqing and Wang, Ye and Zhao, Liping and Huang, Qiao and Jiang, Bo},
	title = {Enhancing Requirement-to-Code Traceability via Chain-of-Thought Prompting in Large Language Models},
	year = {2025},
	journal = {Proceedings - Asia-Pacific Software Engineering Conference, APSEC},
	pages = {812 - 816},
	doi = {10.1109/APSEC66846.2025.00083},
	url = {https://www.scopus.com/pages/publications/105035191937?origin=resultslist},
	affiliations = {Zhejiang Gongshang University, School of Computer Science and Technology, Hangzhou, China; The University of Manchester, Department of Computer Science, Manchester, United Kingdom},
	abstract = {Leveraging the code comprehension capabilities of Large Language Models (LLMs), we propose an automated approach to enhance Requirement-to-Code (R2C) traceability through Chain-of-Thought (CoT) prompting. Traditional Information Retrieval (IR) techniques (e.g., VSM, LSI) exhibit limited accuracy due to the semantic gap between natural language requirements and syntactic code structures. Our framework addresses this gap via two key innovations: (1) CoT-guided generation of functional code summaries through iterative reasoning steps (language identification, comment analysis, naming pattern interpretation), and (2) a similarity-based reordering strategy utilizing SimCSE embeddings to refine candidate links. Evaluations on four industrial datasets (iTrust, eTour, eANCI, SMOS) show 125.47%, 63.2% and 62.13% average MAP improvements over LSI, FTLR+ and FQETLR+ baselines respectively. The approach demonstrates particular strength in low-coverage scenarios (106.19% average MAP improvement on eANCI). This study establishes novel approaches for LLM-driven traceability link recovery and provides actionable insights for integrating prompt engineering into software lifecycle tools. © 2025 IEEE.},
	author_keywords = {Chain-of-thought prompting; Code comprehension; Large language models; Requirement-to-code links; Requirements traceability; Similarity metrics},
	keywords = {Artificial intelligence; Codes (symbols); Iterative methods; Life cycle; MapReduce; Syntactics; Automated approach; Chain-of-thought prompting; Code comprehension; Language model; Large language model; Requirement-to-code link; Requirements traceability; Retrieval techniques; Similarity metrics; Via chain; Semantics},
