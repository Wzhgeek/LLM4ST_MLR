@CONFERENCE{Suresh Thangakrishnan2025,
	author = {Suresh Thangakrishnan, M. and Somasundaram, K. and Nayagam, M. Gomathy and Amanullah, M. and Veerappa Dinesh, S. Erana},
	title = {LLM-Based Requirement Traceability Matrix Generator from SRS Documents},
	year = {2025},
	journal = {2025 IEEE 3rd Global Conference on Wireless Computing and Networking, GCWCN 2025},
	pages = {},
	doi = {10.1109/GCWCN66157.2025.11448459},
	url = {https://www.scopus.com/pages/publications/105037324806?origin=resultslist},
	affiliations = {Einstein College of Engineering, Department of Computer Science and Engineering, Tamil Nadu, Tirunelveli, India; Sri Muthukumaran Institute of Technology, Department of Computer Science and Engineering, Tamil Nadu, Chennai, 600069, India; Ramco Institute of Technology, Department of Computer Science and Business Systems, Tamil Nadu, Rajapalayam, India; Saveetha Institute of Medical and Technical Sciences, Saveetha School of Engineering, Department of Computer Science and Engineering, Tamil Nadu, Chennai, India},
	abstract = {Requirement Traceability is a major prerequisite in the process of software quality assurance but the process of building Requirement Traceability Matrix (RTM) using Software Requirement Specification (SRS) documents is largely fraught with manual, error-prone, and tedious procedures. The paper introduces a new, modular framework by Large Language Model (LLM) that can generate a RTM based on a dynamically informed interpretation of the semantics of requirements via domain-specific prompting, block segmentation based on the semantic context, as well as a multi-agent LLM system. In contrast to other methods based on a rigid static similarity measure or fine-tuned models, the proposed approach uses a zero-shot, rule-injected LLM ensemble to define the strong traceability relationships across the classes of requirements. Analysis on a new curated synthetic benchmark of 15 SRS documents (150-500 requirements each) showed that trace-link accuracy was 92.4%, which is 21% higher than heuristic baselines and 13% better than generic LLM prompting. Also, the system saved manual checking by 47%, which is indicative of the scalable integration in SDLC pipelines. These findings affirm that it is possible to automate the generation of RTM, with great success and without using any legacy rule sets or retraining the models that we have at present.  © 2025 IEEE.},
	author_keywords = {Automation in SDLC; Large Language Models; Requirement Traceability; Software Requirement Specification; Zero-Shot Learning},
	keywords = {Computer software selection and evaluation; Learning systems; Matrix algebra; Quality assurance; Requirements engineering; Semantic Segmentation; Semantics; Software quality; Specifications; Automation in SDLC; Building requirements; Language model; Large language model; Model-based requirements; Requirements traceability; Requirements traceability matrix; Software quality assurance; Software requirements specifications; Specifications document; Multi agent systems},
	correspondence_address = {M. Suresh Thangakrishnan; Einstein College of Engineering, Department of Computer Science and Engineering, Tirunelveli, Tamil Nadu, India; email: suresh.nellai@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
