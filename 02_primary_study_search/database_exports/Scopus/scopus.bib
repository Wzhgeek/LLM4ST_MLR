	affiliations = {NOKIA, Kraków, Poland; AGH University, Institute of Telecommunications, Kraków, Poland},
	abstract = {This paper introduces Linear Model of Latent Dirichlet Allocation (LMLDA), a novel methodology for software test optimization that directly addresses the gap between computationally-prohibitive large language models (LLMs) and semantically-shallow heuristics. Our primary contribution is a lightweight, interpretable, and cost-efficient model specifically designed for high-stakes industrial Continuous Integration and Continuous Development (CI/CD) environments where security and traceability are essential. The novelty of LMLDA lies in its integration of Latent Dirichlet Allocation (LDA) for the semantic analysis of code modifications and test content, with a classifier based on logistic regression concepts for the training phase, yet offering prediction capabilities that align with the computational simplicity of linear regression. This approach uniquely predicts the probability of test failure based on semantic interactions, enabling precise, bug-centric prioritization rather than relying on indirect diversity proxies. A large-scale industrial case study at NOKIA demonstrates LMLDA’s practical effectiveness, achieving an average 64% reduction in test suite size while maintaining 88% precision in bug detection and accelerating critical bug discovery by an average of 8 h per cycle. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {Bug localization; Bug reports; Continuous integration testing; Latent Dirichlet allocation (LDA); Natural language processing; Regression testing; Software engineering; Test prioritization; Test suite reduction},
	keywords = {Artificial intelligence; Heuristic methods; Integration; Latent semantic analysis; Linear regression; Logistic regression; Model checking; Natural language processing systems; Semantics; Bug localizations; Bug reports; Continuous integration testing; Language processing; Latent Dirichlet allocation; Natural language processing; Natural languages; Regression testing; Test prioritization; Test suite reduction; Integration testing},
