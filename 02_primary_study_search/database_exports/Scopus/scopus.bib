@ARTICLE{Salem2026,
	author = {Salem, Ziad and Tahat, Luay and Humaidan, Yasmeen and Tahat, Noor},
	title = {AI-Driven Approaches to System Requirements and Test Case Generation: A New Paradigm in Software Engineering},
	year = {2026},
	journal = {Technologies},
