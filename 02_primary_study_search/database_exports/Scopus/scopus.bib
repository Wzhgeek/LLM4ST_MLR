	publisher = {Association for Computing Machinery, Inc},
	isbn = {979-840070504-5},
	language = {English},
	abbrev_source_title = {Proc. - MODELS : ACM/IEEE Int. Conf. Model Driven Eng. Lang. Syst.},
	type = {Conference paper},
