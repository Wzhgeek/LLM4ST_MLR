}

@CONFERENCE{Korn2025603,
	author = {Korn, Alexander},
	title = {Smells Like Trouble: Investigating the Impact of Requirements Quality on LLM-Supported Software Engineering},
	year = {2025},
	journal = {Proceedings of the IEEE International Conference on Requirements Engineering},
	pages = {603 - 606},
	doi = {10.1109/RE63999.2025.00075},
