@ARTICLE{Agbese202692,
	author = {Agbese, Mamia and Rousi, Rebekah and Abrahamsson, Pekka},
	title = {The Ethical Requirements Stack: Operationalizing Adaptive Ethical Requirements with Human-AI Collaboration and GPT-Based LLMs},
	year = {2026},
	journal = {Lecture Notes in Business Information Processing},
	volume = {574 LNBIP},
	pages = {92 - 107},
	doi = {10.1007/978-3-032-14518-5_8},
