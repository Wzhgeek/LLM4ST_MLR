@CONFERENCE{Xie2025165,
	author = {Xie, Wei and Zhao, Yi and Zhang, Min and Huang, Yinghua},
	title = {Constructing Cross-Level Traceability Links in the Automotive Domain: A Case Study},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 33rd International Requirements Engineering Conference Workshops, REW 2025},
	pages = {165 - 172},
	doi = {10.1109/REW66121.2025.00026},
	url = {https://www.scopus.com/pages/publications/105020908269?origin=resultslist},
	affiliations = {Shanghai Key Laboratory of Trustworthy Computing, East China Normal University, China; Beijing Automotive Research Institute Co., Ltd., China},
	abstract = {During the development of automotive systems, establishing cross-layer traceability links between system-level and component-level requirements is crucial for ensuring the consistency and integrity of system development. However, this process faces numerous challenges: there are significant semantic differences between requirements at different levels, and system-level functions often correspond to multiple component-level functions, creating complex one-to-many mapping relationships that further increase the difficulty of traceability. To address these issues, we propose a method for constructing cross-layer traceability links for automotive systems. The method first categorizes the typical mapping relationships between system-level and component-level requirements into two patterns: aggregation and cascading. Based on predefined structured requirements meta-models and prompting engineering techniques, it utilizes LLMs to perform semantic parsing and structured modeling of natural language requirements documents. Subsequently, a terminology dictionary is constructed to unify and normalize synonymous terms across layers. Additionally, a signal dependency graph of component-level requirements is built to assist in identifying semantic links and execution paths between requirements. We use a case study to demonstrate that this method shows good adaptability in dealing with issues such as terminology heterogeneity, semantic inconsistency, and structural complexity. It significantly improves the efficiency and accuracy of constructing cross-layer traceability links, providing strong support for subsequent requirements change management, system verification, and testing.  © 2025 IEEE.},
	author_keywords = {Automotive systems; Dependency graph; Large language models; Metamodel; Requirements traceability},
	keywords = {Building components; Computational linguistics; Mapping; Requirements engineering; Semantics; Automotive Systems; Component levels; Cross layer; Dependency graphs; Language model; Large language model; Meta model; Requirements traceability; System levels; Traceability links; Modeling languages; Terminology},
	correspondence_address = {M. Zhang; Shanghai Key Laboratory of Trustworthy Computing, East China Normal University, China; email: zhangmin@sei.ecnu.edu.cn; Y. Huang; Beijing Automotive Research Institute Co., Ltd., China; email: huangyinghua@bjev.com.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833153834-7},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Requir. Eng. Conf. Workshops, REW},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; Conference name: 33rd IEEE International Requirements Engineering Conference Workshops, REW 2025; Conference sponsors: ; Conference code: 213891; Conference date: 1 September 2025 through 5 September 2025}
}

@CONFERENCE{Loose2025,
	author = {Loose, Davis C. and Gunn, Megan E. and Linkov, Igor and Gunn, Matthew C. and Moghadasi, Negin and Collier, Zachary A. and Lambert, James H.},
	title = {Knowledge Automation and Requirements Analysis in E-Commerce Fraud Detection},
	year = {2025},
	journal = {ISSE 2025 - 11th IEEE International Symposium on Systems Engineering, Symposium Proceedings},
	pages = {},
	doi = {10.1109/ISSE65546.2025.11370116},
	url = {https://www.scopus.com/pages/publications/105034967446?origin=resultslist},
	affiliations = {University of Virginia, Department of Systems and Information Engineering, Charlottesville, VA, United States; U.S. Army Corps of Engineers, U.S. Army Engineer Research and Development Center, Concord, MA, United States; Radford University, Department of Management, Radford, VA, United States; Center for Risk Management of Engineering Systems, University of Virginia, Charlottesville, VA, United States},
	abstract = {Fraud in e-commerce storefronts undermines consumer trust and inject counterfeit goods into global supply chains. This paper introduces a requirements-driven workflow that couples large language models (LLMs) with the machine learning operations pipeline to continuously refine and adapt storefront-fraud detection models, updating feature sets, thresholds, and evaluation criteria, without adding new data sources, improving performance and maintaining full traceability. The paper reproduces a public benchmark with labelled e-commerce storefront URLs and associated fraud indicators to establish a transparent baseline (random forest accuracy ≈ 0.970). An LLM module augmented with content from prior benchmarks, design docs, and other relevant information is used to iteratively revise the algorithm requirements during the model-creation, training, and testing phases. Several enhancements to the baseline are tested, with best results from a stacking ensemble model that showed statistically significant improvement in recall, with nominal improvements across four other metrics. The LLM-augmented method for requirements engineering in machine learning is adaptable to other supply-chain risk analytics where lightweight models must keep pace with evolving threats. Results indicate that coupling an LLM feedback layer with minimal-feature classifiers is a practical method to improve detection performance as fraud tactics evolve. © 2025 IEEE.},
	author_keywords = {digital supply networks; large language models; Machine learning operations; risk management; security and trust},
	keywords = {Benchmarking; Crime; Electronic commerce; Feature extraction; Learning systems; Network security; Requirements engineering; Supply chains; Digital supply network; E- commerces; Fraud detection; Language model; Large language model; Machine learning operation; Machine-learning; Risks management; Security and trusts; Supply networks; Iterative methods},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833157550-2},
	language = {English},
	abbrev_source_title = {ISSE - IEEE Int. Symp. Syst. Eng., Symp. Proc.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; Conference name: 11th IEEE International Symposium on Systems Engineering, ISSE 2025; Conference sponsors: IEEE; Conference code: 220181; Conference date: 28 October 2025 through 30 October 2025}
}

@ARTICLE{Hajjarzadeh2026432,
	author = {Hajjarzadeh, Sahar and Shakeri Hossein Abad, Zahra and Far, Behrouz},
	title = {LLM-Based MaSE, A Software Development Framework for Developing Multi-agent Systems},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {15706 LNAI},
	pages = {432 - 443},
	doi = {10.1007/978-981-96-8889-0_37},
	url = {https://www.scopus.com/pages/publications/105010817368?origin=resultslist},
	affiliations = {Department of Electrical and Software Engineering, University of Calgary, Calgary, T2N 1N4, AB, Canada; Institute of Health Policy, Management and Evaluation, Dalla Lana School of Public Health, University of Toronto, Toronto, M5S 1A1, ON, Canada},
	abstract = {The automation of software development prompted extensive research for decades. Recent advancements in AI, particularly large language models (LLMs), are driving transformative changes in the field. While LLMs have demonstrated impressive performance in code generation, challenges remain in generating complex and domain-specific code. To fully realize their potential, it is crucial to extend their application throughout the entire software development lifecycle. This necessity has driven us to explore and evaluate the role of these models in supporting all stages of the software engineering process. In this article, we propose an LLM-based framework tailored for the development of multi-agent systems (MAS). By focusing on MAS and leveraging the MaSE methodology in conjunction with the JADE platform, our framework ensures the generation of accurate, traceable, and reliable software artefacts efficiently. The framework uses predefined prompts to guide the LLM through each step of the methodology, producing outputs that adhere to domain-specific requirements. Empirical evaluations on sample projects demonstrate that this approach not only accelerates the development process but also results in artefacts that are more comprehensive and modular compared to those produced by human developers, showcasing the transformative potential of LLMs in software engineering. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2026.},
	author_keywords = {Large Language Models; Multi-Agent Systems; Software Development Methodology},
	keywords = {Application programs; Life cycle; Software agents; Software design; Codegeneration; Domain-specific codes; Language model; Large language model; Model-based OPC; Multiagent systems (MASs); Performance; Software development framework; Software development life-cycle; Software development methodologies; Multi agent systems},
	correspondence_address = {S. Hajjarzadeh; Department of Electrical and Software Engineering, University of Calgary, Calgary, T2N 1N4, Canada; email: sahar.hajjarzadeh@ucalgary.ca},
	editor = {Fujita H. and Watanobe Y. and Ali M. and Wang Y.},
