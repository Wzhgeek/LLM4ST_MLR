	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang2025,
	author = {Wang, Lei and Wang, Ming-Chao and Zhang, Yuan-Rong and Ma, Jian and Shao, Hong-Yu and Chang, Zhi-Xing},
	title = {Automated Identification and Representation of System Requirements Based on Large Language Models and Knowledge Graphs},
	year = {2025},
	journal = {Applied Sciences (Switzerland)},
