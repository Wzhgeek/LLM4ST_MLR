@ARTICLE{Wang20261097,
	author = {Wang, Chunhui and Zhao, Jiaqi and Chen, Xiaohong and Jin, Zhi},
	title = {LLM-Based Interpretable Embedded System Requirements Specification; [基于 LLM 的可解释嵌入式系统需求规约方法]},
	year = {2026},
	journal = {Jisuanji Yanjiu yu Fazhan/Computer Research and Development},
	volume = {63},
	number = {5},
	pages = {1097 - 1116},
	doi = {10.7544/issn1000-1239.202550898},
	url = {https://www.scopus.com/pages/publications/105042550693?origin=resultslist},
	affiliations = {College of Computer Science and Technology, Inner Mongolia Normal University, Hohhot, 010022, China; Shanghai Key Laboratory of Trustworthy Computing, East China Normal University, Shanghai, 200062, China; Key Lab of High Confidence Software Technologies (Peking University), Ministry of Education, Beijing, 100871, China; School of Computer Science, Peking University, Beijing, 100871, China},
	abstract = {The embedded system requirements specification serves as the cornerstone of system development, playing a crucial role in transforming high-level user intentions into clear and executable software requirements. Currently, this process remains highly dependent on manual derivation and composition by domain experts, with inherent limitations such as low efficiency and insufficient interpretability. Although automated requirements generation is regarded as a potential solution, its development still faces two core challenges: how to effectively embed domain-specific device knowledge, and how to strictly adhere to the standards of intent satisfiability and traceability to construct an interpretable requirements system. To address these issues, we propose an interpretable requirements specification method based on large language models (LLMs). By constructing a prompt chain that integrates domain knowledge and requirements engineering, our method gradually complements and refines user intentions into device, system, and software requirements level by level under human-computer interaction collaboration, ensuring the satisfiability of requirements. Additionally, it introduces the problem diagram and scenario diagram model to guarantee the traceability of requirements. Experiments on four embedded system cases show that compared with manual methods, our method reduces time cost by approximately 73% and improves the quality of requirements specification documents by 82%. Moreover, its interpretability increases by about 15% and 21% compared with both manual methods and single-step LLM methods, providing an efficient and reliable new approach for requirements specification of complex embedded systems. © 2026 Science Press. All rights reserved.},
	author_keywords = {embedded systems; LLM (large language model); requirements completion; requirements interpretability; requirements specification},
	keywords = {Embedded software; Formal specification; Human computer interaction; Requirements engineering; Embedded-system; Interpretability; Language model; Large language model; Requirement completion; Requirement interpretability; Requirements specifications; Software requirements; System requirements specifications; User's intentions; Embedded systems},
