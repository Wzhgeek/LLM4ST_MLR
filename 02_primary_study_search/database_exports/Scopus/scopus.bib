	editor = {Bianculli D. and Sartaj H. and Andrikopoulos V. and Pautasso C. and Mikkonen T. and Perez J. and Bureš T. and De Sanctis M. and Muccini H. and Navarro E. and Soliman M. and Zdun U.},
