@inbook{doi:https://doi.org/10.1002/9781394374175.ch06,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394374175},
title = {Accelerate Knowledge Transformation with Curation and Feedback Systems},
booktitle = {Architected Intelligence},
chapter = {SIX},
pages = {173-202},
doi = {https://doi.org/10.1002/9781394374175.ch06},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394374175.ch06},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394374175.ch06},
year = {2026},
keywords = {Company policy, News from reputable wire services, Flexibility, Knowledge system, Sensitive data, Knowledge curation pyramid, Shutdown, Knowledge system, Context engineering, Streamlined systems},
abstract = {This chapter explores the challenges of knowledge management in AI-first settings, focusing on the tension between documented and undocumented information. The scenario of a Network Controller facing a decision under ambiguity highlights the reliance on informal relationships and improvisation in traditional settings. The core issue is not the absence of information but the lack of trusted authority to discern truth from noise. The chapter introduces the Knowledge Transformation Cycle and its Curate phase, which involves synthesizing feedback to improve data quality. The Knowledge Curation Pyramid is proposed as a framework to categorize information by trust and liability, aiming to establish a Canon of trusted truth for AI systems. The chapter underscores the necessity of structured curation to prevent ambiguity from causing unpredictability in automated decision-making processes. A hierarchical model of information quality for AI systems is introduced, categorizing data into four layers: Well-retrieved, Well-sourced, Well-informed, and Canon. The base layer, Well-retrieved, involves raw data retrieval with high variance, suitable for research but not actionable decisions. Well-sourced information is derived from trusted sources, though content-specific validation is pending.}
}

@article{https://doi.org/10.1002/bte2.70127,
author = {Wang, Yiming and Du, Ziwei and Chen, Yuhui and Qiu, Yicheng and Yan, Dong and Hou, Bo},
title = {Accelerating Perovskite Solar Cell Development Through High-Throughput Technologies: Computational Simulation, Automated Experimentation, and Intelligent Integration},
journal = {Battery Energy},
volume = {5},
number = {4},
pages = {e70127},
keywords = {automated experimentation, high-throughput computation, machine learning, perovskite solar cell},
doi = {https://doi.org/10.1002/bte2.70127},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bte2.70127},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/bte2.70127},
abstract = {ABSTRACT Perovskite solar cells have emerged as promising candidates for next-generation photovoltaics. However, optimizing their efficiency and long-term stability is complicated by the vast parameter space involving composition, processing, and device architecture, and so on. Conventional trial-and-error approaches are labor-intensive and often inefficient for navigating these complex multidimensional interactions. Consequently, the field is shifting toward high-throughput (HT) data-driven methodologies capable of accelerating the development cycle. This review highlights recent progress in HT computational and experimental strategies, along with their synergistic integration. Regarding computational efforts, we summarize the use of density functional theory and machine learning to identify single, double, and derivative perovskite candidates, as well as emerging techniques in literature data mining. We also discuss automated experimental platforms utilizing automatic processing and combinatorial characterization to optimize material compositions, device fabrication processes, and operational stability. Furthermore, we examine the integration of these domains through closed-loop workflows that combine computational prediction with automated experimentation to establish intelligent prediction, fabrication, and validation cycles. Finally, we provide an outlook on prevailing challenges regarding data acquisition, machine learning integration, HT platform infrastructure, and multi-modal data processing, alongside potential solutions for achieving fully autonomous material discovery and device optimization.},
year = {2026}
}

@article{https://doi.org/10.1049/cim2.70006,
author = {Xie, Kunyu and Zhang, Lin and Wang, Xiaohan and Wang, Kunyu and Li, Yingjie},
title = {Integrated modelling and simulation method of hybrid systems based on X language},
journal = {IET Collaborative Intelligent Manufacturing},
volume = {6},
number = {4},
pages = {e70006},
keywords = {logistics, manufacturing industries, manufacturing systems},
doi = {https://doi.org/10.1049/cim2.70006},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1049/cim2.70006},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1049/cim2.70006},
abstract = {Abstract Model-based systems engineering is now leading the way in supporting the design of complex products or systems. The integration of modelling and simulation of continuous-discrete hybrid systems is the key of model-based systems engineering. But the existing languages, formalisms and tools cannot support the unified modelling and simulation of hybrid systems and therefore reduces the efficiency of complex system development. To address this issue, this paper develops a design method of complex hybrid systems, which integrates modelling and simulation of the continuous-discrete hybrid behaviour. Specifically, the authors provided a modelling method of hybrid systems based on the X language, a simulation method based on XDEVS, and a compilation algorithm to transform the hybrid model constructed with X language into XDEVS simulation files. In this way, the X language hybrid model can be automatically translated into XDEVS simulation files by a compiler. The simulation files can then be simulated by the XDEVS simulation engine. The obtained simulation results will be used to verify whether the design scheme meets the design requirements of the hybrid system. Finally, the correctness and feasibility of the proposed method are verified using a car-driving model.},
year = {2024}
}

@inbook{doi:https://doi.org/10.1002/9781394423088.ch22,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394423088},
title = {Annual Audit Planning and Capability Development},
booktitle = {Cybersecurity Auditing},
chapter = {22},
pages = {399-418},
doi = {https://doi.org/10.1002/9781394423088.ch22},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394423088.ch22},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394423088.ch22},
year = {2026},
keywords = {annual audit plan development, risk-based audit universe, audit scheduling and cadence, resource planning and skill matrix, auditor training and upskilling, methodology and workpaper standards, quality assurance and improvement program, KPIs and KRIs for audit, toolset selection and governance, coordination with second line, reliance strategy on external assurance, continuous improvement road map, stakeholder engagement model, change management for methodology, audit program maturity assessment},
abstract = {This chapter looks ahead to the evolving landscape of cybersecurity auditing and the skills, technologies, and mindsets that will define the profession in the coming decade. It explains how accelerating digital transformation, cloud-native architectures, artificial intelligence, and regulatory complexity are reshaping what assurance means and how it must be delivered. Readers learn how automation, analytics, and continuous auditing are replacing traditional point-in-time reviews with real-time, data-driven insight. This chapter emphasizes that the future auditor must blend technical fluency with strategic perspective—able to interpret emerging risks, challenge assumptions, and provide forward-looking assurance that supports innovation without sacrificing control. The discussion explores how the audit function itself is undergoing transformation. It describes how teams are adopting continuous monitoring tools, predictive analytics, and risk-sensing technologies to detect anomalies and control failures proactively. Readers learn how artificial intelligence can enhance evidence analysis, pattern recognition, and audit coverage while introducing new responsibilities for transparency and ethical oversight. This chapter also examines how new standards and frameworks are evolving to address automation, digital ecosystems, and resilience, requiring auditors to stay adaptable and continuously educated. Emphasis is placed on agility, collaboration, and communication as key differentiators for next-generation cybersecurity auditors. In conclusion, this chapter challenges readers to view auditing as a strategic discipline that advances organizational confidence in an era of constant change. It highlights how the auditor's role will increasingly blend assurance with advisory influence, helping leaders navigate uncertainty with data-backed insight. Readers are encouraged to invest in lifelong learning, interdisciplinary collaboration, and technological literacy to remain effective in a rapidly shifting field. By embracing innovation while preserving independence, the future cybersecurity auditor becomes a catalyst for trust—ensuring that as technology evolves, the principles of accountability, transparency, and assurance evolve alongside it.}
}

@article{https://doi.org/10.1002/sys.70030,
author = {Velthuizen, Marjolein Antoinette Jannyne and Hofman, Erwin and Pessôa, Marcus Vinicius Pereira},
title = {A Bibliometric Review of the INCOSE's Model-Based Systems Engineering Roadmap},
journal = {Systems Engineering},
volume = {29},
number = {3},
pages = {567-588},
keywords = {bibliometric analysis, digitalization trend, INCOSE MBSE roadmap, model-based systems engineering (MBSE), research trends},
doi = {https://doi.org/10.1002/sys.70030},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/sys.70030},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/sys.70030},
abstract = {ABSTRACT Over the past decade, model-based systems engineering (MBSE) has gained attention as an approach for managing system complexity, offering a shift from a document-based to a model-based approach. The International Council on Systems Engineering (INCOSE) sparked increasing interest when it introduced MBSE and its roadmap as part of its systems engineering vision for 2020. The MBSE roadmap spans 15 years and is the principal stimulus behind this study. This paper's main objective is to assess the current progress in the MBSE literature from 2007 to 2025 compared to the INCOSE MBSE roadmap and to identify areas needing further research attention. The paper uses bibliometric analysis techniques to identify past, present, and emerging themes within the MBSE research domain. The findings are compared to the INCOSE roadmap. The comparison shows that MBSE is increasingly applied for systems architecting. However, INCOSE's envisioned state has not been achieved. Key areas requiring further research attention are MBSE theories, standardized MBSE methodologies, MBSE standards, MBSE metrics, integration with hardware and software models, and tool interoperability. In addition, future research should focus on advancing and formalizing MBSE's role in digitalization, expanding model-based safety analysis (MBSA) methods, exploring how MBSE can support sustainable system design, and formulating adoption strategies. Continued research efforts are essential for MBSE to achieve INCOSE's vision for widespread adoption and application.},
year = {2026}
}

@article{https://doi.org/10.1002/aaai.12185,
author = {Jiomekong, Azanzi and Oelen, Allard and Auer, Soren and Anna-Lena, Lorenz and Lars, Vogt},
title = {Food information engineering},
journal = {AI Magazine},
volume = {45},
number = {3},
pages = {338-353},
doi = {https://doi.org/10.1002/aaai.12185},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/aaai.12185},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/aaai.12185},
abstract = {Abstract Food information engineering relies on statistical and AI techniques (e.g., symbolic, connectionist, and neurosymbolic AI) for collecting, storing, processing, diffusing, and putting food information in a form exploitable by humans and machines. Food information is collected manually and automatically. Once collected, food information is organized using tabular data representation schema, symbolic, connectionist or neurosymbolic AI techniques. Once collected, processed, and stored, food information is diffused to different stakeholders using appropriate formats. Even if neurosymbolic AI has shown promising results in many domains, we found that this approach is rarely used in the domain of food information engineering. This paper aims to serve as a good reference for food information engineering researchers. Unlike existing reviews on the subject, we cover all the aspects of food information engineering and we linked the paper to online resources built using Open Research Knowledge Graph. These resources are composed of templates, comparison tables of research contributions and smart reviews. All these resources are organized in the “Food Information Engineering” observatory and will be continually updated with new research contributions.},
year = {2024}
}

