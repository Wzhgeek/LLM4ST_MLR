@article{https://doi.org/10.1049/tje2.70166,
author = {Malik, Maaz Tahir and Muqeet, Hafiz Abdul and Akram, Rizwan and Obaid, Hafiz Muhammad and Rehman, Atiq ur and Bermak, Amine},
title = {Artificial Intelligence Applications in Smart Cities: Integrating Communication, Energy Management, Cybersecurity and Internet of Things},
journal = {The Journal of Engineering},
volume = {2026},
number = {1},
pages = {e70166},
keywords = {Artificial intelligence, cybersecurity, energy management, Internet of Things, information and communication technologies, machine learning, smart cities, smart transportation system},
doi = {https://doi.org/10.1049/tje2.70166},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1049/tje2.70166},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1049/tje2.70166},
abstract = {ABSTRACT Smart cities represent transformative urban ecosystems, leveraging advanced technologies to address challenges posed by rapid urbanisation, energy efficiency demands, and sustainability goals. Despite extensive research, a comprehensive and integrated literature analysis combining AI-based communication, energy management, cybersecurity, and IoT for smart city applications remains limited, which motivates this study. So, this study provides a comprehensive appraisal of critical enablers, including Artificial Intelligence (AI), the Internet of Things (IoT), Machine Learning (ML), and Information and Communication Technologies (ICT), in shaping the next generation of smart cities. Special emphasis is placed on the role of 5G and emerging 6G communication paradigms in enabling real-time data exchange and seamless IoT integration. Furthermore, the paper explores the significance of advanced energy management systems in optimising resource allocation and mitigating environmental impacts. Cybersecurity, a cornerstone of resilient smart city frameworks, is examined in-depth, highlighting strategies to safeguard interconnected infrastructures against potential threats. Through an extensive review of state-of-the-art methodologies, this paper identifies existing research gaps and presents actionable recommendations to overcome challenges in the smart city domain. The insights provided aim to propel future innovations, fostering sustainable, secure, and intelligent urban environments.},
year = {2026}
}

@inbook{doi:https://doi.org/10.1002/9781394375806.ch3,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394375806},
title = {Engineering Principles},
booktitle = {The AI‐Enabled Engineer},
chapter = {3},
pages = {41-108},
doi = {https://doi.org/10.1002/9781394375806.ch3},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394375806.ch3},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394375806.ch3},
year = {2026},
keywords = {conservative thinking, engineering principles, first principles, non-absoluteness, open-mindedness, optimization},
abstract = {Engineers have created a set of engineering philosophies spanning methods and principles to approaches over years of practice. This chapter captures both widely recognized and less commonly articulated principles, acknowledging that personal experience may suggest modifications. First principles thinking is the cornerstone of engineering problem-solving and system design. Unlike science and mathematics, engineering practices do not pursue absoluteness since this is different from what engineering is after. Open-mindedness in engineering refers to the receptivity to diverse ideas, approaches, and solutions regardless of their origin or initial appearance of feasibility. Conservative thinking in engineering prioritizes safety, reliability, and thorough validation throughout development, ensuring products perform consistently even under unexpected conditions. Engineering distinctively aims to increase efficiency, separating engineered products from ordinary artifacts. Optimization—the process of making systems more effective by systematically adjusting parameters to minimize constraints and maximize outcomes—is central to this pursuit.}
}

@inbook{doi:https://doi.org/10.1002/9781394413997.ch13,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394413997},
title = {Testing Models},
booktitle = {Model‐Driven Power System Automation},
chapter = {13},
pages = {329-360},
doi = {https://doi.org/10.1002/9781394413997.ch13},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394413997.ch13},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394413997.ch13},
year = {2026},
keywords = {IEC 61850 testing, verification, model-based testing, conformance, interoperability, performance testing, UML Test Profile, OCL, FAT/SAT, digital substations},
abstract = {This chapter details the testing framework for IEC 61850-based Substation Automation Systems, emphasizing structured validation throughout the entire engineering lifecycle. It differentiates verification—formal confirmation of design accuracy—from empirical testing carried out after implementation and describes how safety and liveness requirements influence both processes. The shift from manual and capture–replay testing to keyword-driven and model-based techniques is explained, culminating in automated test-case generation using Unified Modeling Language (UML) models, digital twins, and the OMG UML Test Profile. IEC 61850’s object-oriented models facilitate conformance, interoperability, and performance testing through standardized SCD descriptions, logical-node test modes, and controlled GOOSE/SV injection. The chapter covers factory and site testing (Type, Routine, FAT, SAT), conformance certification via UCAIug, and supporting documents such as PICS, MICS, and PIXIT. The use of model checkers and OCL extends validation beyond XML schema constraints, enabling formal rule verification, regression management, and integration into Waterfall, V-Model, or Agile development cycles for dependable digital substation deployment.}
}

