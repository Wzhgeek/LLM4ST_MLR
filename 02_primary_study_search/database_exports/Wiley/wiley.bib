publisher = {John Wiley & Sons, Ltd},
isbn = {9781119842316},
title = {Different Applications and Importance of Digital Twin},
booktitle = {Digital Twin Technology},
chapter = {12},
pages = {189-203},
doi = {https://doi.org/10.1002/9781119842316.ch12},
