@article{https://doi.org/10.1002/imm3.70044,
author = {Zhu, Junye and Yang, Mengqi and Ouyang, Chenxi and Zhang, Lin},
title = {Closing the Loop in Precision Oncology: A Digital Twin-Driven Paradigm for Dynamic Decision-Making},
journal = {iMetaMed},
volume = {2},
number = {2},
pages = {e70044},
doi = {https://doi.org/10.1002/imm3.70044},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/imm3.70044},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/imm3.70044},
abstract = {ABSTRACT Precision oncology is evolving from a predictive paradigm towards adaptive decision-making with dynamic data. This paper systematically presents a forward-looking conceptual framework for a Closed-Loop Intelligent Oncology System (CIOS), which aims to support iterative evaluation of candidate treatment strategies and inform timely adjustments in care by updating a patient-specific digital twin that approximates key aspects of the patient's pathophysiological state. The core idea of CIOS is that it does not only predict tumor evolution but frames decision-making as a closed-loop process that evaluates candidate policies within a computational environment under explicit constraints. A five-layer reference architecture is described to elucidate the operational mechanism of CIOS: (1) Perception Layer: Multimodal data fusion. (2) Simulation Layer: PINN-based digital twins. (3) Decision Layer: Safe RL for adaptive therapy. (4) Evolution Layer: Meta learning \& federated learning. (5) Trust Layer: XAI \& uncertainty reporting. This paper systematically reviews the preliminary research progress and application explorations of the key technologies at each of these layers within the field of oncology. It also provides an in-depth discussion of the technical challenges, clinical translation barriers, and future research directions, aiming to provide a theoretical reference and potential guidance for further research and eventual realization of this conceptual framework.},
year = {2026}
}

@inbook{doi:https://doi.org/10.1002/9783527839599.ch25,

publisher = {John Wiley & Sons, Ltd},
isbn = {9783527839599},
title = {Model-Based Systems Engineering},
booktitle = {Field Simulation for Accelerator Magnets},
chapter = {25},
pages = {983-1014},
doi = {https://doi.org/10.1002/9783527839599.ch25},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9783527839599.ch25},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9783527839599.ch25},
year = {2025},
keywords = {data-driven modeling, field transducers, MBSE, model artifacts, numerical field simulations, numerical models, software interfaces},
abstract = {Summary This chapter presents Model-based systems engineering (MBSE) as a methodology that enables data-driven modeling and traceable design workflows of magnets and field transducers by combining numerical field simulations with tests and magnetic measurements. The aim is to create models that are updated by magnetic measurements and allow the extrapolation of performance parameters regarding different powering cycles, manufacturing defects, and varying material parameters. Software interfaces must be standardized to enable communication between tools and packages. The input and output formats must move from individual file-based exchange to a unified workflow using community standards, particularly for multiphysics simulations using several linked models. The software environment for MBSE contains a magnet model management layer to handle the storage of models and the retrieval of model information in terms of model artifacts and queries.}
}

@inbook{doi:https://doi.org/10.1002/9781394195336.ch2,
author = {Janani, Kariyappa and Ramamoorthy, Sriramulu and Poorvadevi, Ramamoorthy and Gopal, R.},
publisher = {John Wiley & Sons, Ltd},
isbn = {9781394195336},
title = {The State-of-the-Art Digital Twin Components in Industrial IoT Production: Theoretical and Practical Applications},
booktitle = {Digital Twins in Industrial Production and Smart Manufacturing},
chapter = {2},
pages = {23-58},
doi = {https://doi.org/10.1002/9781394195336.ch2},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394195336.ch2},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394195336.ch2},
year = {2024},
keywords = {attacks, blockchain, digital twinIIoT},
abstract = {Summary Digital twin (DT) technology is an innovative strategy that creates virtual representations of physical assets and systems by leveraging the industrial Internet of Things (IIoT). The DT technology provides a comprehensive view of the physical thing and the activities it is performing in actual time by integrating sensor data with advanced analytics. This technology offers considerable potential to improve operating efficiency in various industries, including manufacturing, aerospace, energy, and healthcare, as well as lowers maintenance costs and boosts overall performance. Constructing an automated clone of a physical resource or system, linked to its analog in the actual world using sensors and communication networks, is central to how DT technology operates. The DT model can simulate various scenarios, predicting future performance, and identifying potential problems before they arise. This enables preventative maintenance and the improvement of operational processes. In addition, DT technology provides remote monitoring and control of assets, which makes the management of complex systems and processes more efficient and effective. There is a significant variety of possible uses for DT technology in the production industry, between the range of improving the efficiency of production processes to enhancing the monitoring and upkeep of essential infrastructure. It is reasonable to anticipate that as technology advances more industries will adopt DT technology to enhance their operations and achieve a competitive edge in the market. This paper identifies DT with IIoT network security concerns; scalability, interoperability, security, privacy, dependability, and low latency are the primary IIoT architectural goals.}
}

@article{https://doi.org/10.1049/cim2.70041,
author = {Gálvez del Postigo Gallego, Lucía and Lazarova-Molnar, Sanja and del Real Torres, Alejandro and Acevedo Galicia, Luis E.},
title = {Decision Support Within Digital Twins in Manufacturing Ecosystems: A Review},
journal = {IET Collaborative Intelligent Manufacturing},
volume = {7},
number = {1},
pages = {e70041},
keywords = {decision making, intelligent manufacturing systems, learning (artificial intelligence), manufacturing industries, manufacturing systems, resource allocation, scheduling},
doi = {https://doi.org/10.1049/cim2.70041},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1049/cim2.70041},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1049/cim2.70041},
abstract = {ABSTRACT The dynamic nature of manufacturing and evolving customer demands require agile adaptation within Manufacturing Ecosystems—interconnected networks of enterprises and institutions collaborating to develop market—oriented solutions. To support this adaptation, it is crucial to evaluate large volumes of data and assess alternative scenarios electively. Digital Twins (DTs) enable the replication of physical systems into virtual models, facilitating the exploration of such scenarios. In most applications, Decision Support (DS) is essential and can be considered intrinsic to DTs. By integrating DS within DTs, the loop can be closed—transforming simulation information into actionable decisions. This study investigates recent advances and trends in the use of DTs for DS in production processes, with a focus on applications in Manufacturing Ecosystems. A systematic review is conducted to examine how DTs contribute to complex and holistic decision-making, including tasks such as production planning, maintenance scheduling, and defect management. Special attention is given to how decisions are made within DT-based applications and the extent of their autonomy and complexity. The review contributes to the identification of current research directions and gaps regarding the integration of DTs and DS, with the aim of supporting more effective and adaptive manufacturing strategies.},
year = {2025}
}

