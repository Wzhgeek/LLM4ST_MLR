booktitle = {Cybersecurity and Traceability in Factory 4.0},
chapter = {1},
pages = {1-56},
doi = {https://doi.org/10.1002/9781394469475.ch1},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394469475.ch1},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394469475.ch1},
year = {2026},
keywords = {cybersecurity threats, Factory 4.0, industrial traceability, security flaws, vulnerabilities},
abstract = {Summary The implementation of Industry 4.0 consists on the one hand of collecting as much information as possible about industrial activity in order to digitize it, process it and aggregate it with other information. On the other hand, working in Factory 4.0 is perceived differently due to the implementation of combined processes between machines and operators. The new technologies of Industry 4.0 are actually based on the use of collected and historical data, of which a significant part is created by industrial traceability. This chapter focuses on defining and describing vulnerabilities, threats and risks. It analyzes security flaws in the various predefined perimeters of the factory. The chapter provides a detailed examination of some of the existing solutions against cybersecurity threats. These solutions have been selected in order to present the main trends concerning conventional and innovative solutions that can be applied in the different perimeters.}
}

@inbook{doi:https://doi.org/10.1002/9781119842316.ch12,
