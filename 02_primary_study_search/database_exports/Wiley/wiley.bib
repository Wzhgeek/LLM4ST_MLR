url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394298334.ch06},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394298334.ch06},
year = {2026},
keywords = {deployment, operation, life-cycle management, distributed systems, AI integration, data management, resource management, organizational impact, industrial adoption, continuous evolution},
abstract = {It explores the critical phases of deploying and operating Digital Twin systems in real environments. It discusses strategies for distributing DT components—centralized versus distributed deployments—and presents deployment scenarios illustrating practical implementation challenges. Focus is given to managing DT life-cycle phases from product design through operation, including phase transitions and continuous evolution. Operational management encompasses functional oversight, resource allocation, and system infrastructure management. The integration of Artificial Intelligence enhances DT management by optimizing operations and automating routine tasks. Data management practices are detailed for ensuring data integrity and availability, vital for synchronizing DT and physical system states. The chapter also examines organizational impacts, addressing how DT adoption influences processes, roles, and collaboration within organization. Industrial experiences reveal lessons on enablers, barriers, and benefits in deploying DTs at scale, emphasizing effort versus value trade-offs.}
}

