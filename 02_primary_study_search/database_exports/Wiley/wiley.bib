eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394298334.ch08},
year = {2026},
keywords = {future Digital Twins, AI integration, extensible architecture, interoperability, ethics, privacy, human-in-the-loop, sustainability, societal impact, standards},
abstract = {It explores the evolutionary trajectory and future evolution of Digital Twin technologies. It evaluates Digital Twins as general-purpose solutions applicable across several domains, highlighting promising application areas including industrial, urban, and societal contexts. Anticipated technology advancements are outlined, with emphasis on improved software platforms, modular and extensible architectures, and integrated development methodologies. The chapter discusses the deep integration of artificial intelligence, including generative and explainable AI, to enhance Digital Twin capabilities. Testing, assessment, and interoperability with open standards are addressed as critical for wider adoption of DT-based solutions. Ethical, privacy, and trust considerations are highlighted, along with human-in-the-loop design principles to improve user experience and visualization. The chapter also covers the societal impact of Digital Twins, including sustainability and digital inclusion, and sets a roadmap for future research and development to advance this revolutionary technology.}
}

@inbook{doi:https://doi.org/10.1002/9781394298334.ch06,

publisher = {John Wiley & Sons, Ltd},
