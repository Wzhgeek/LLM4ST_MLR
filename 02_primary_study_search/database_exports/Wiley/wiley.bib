@inbook{doi:https://doi.org/10.1002/9781394298334.ch01,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394298334},
title = {What Is a Digital Twin?},
booktitle = {The Foundation for Digital Twins},
chapter = {1},
pages = {1-26},
doi = {https://doi.org/10.1002/9781394298334.ch01},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394298334.ch01},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394298334.ch01},
year = {2026},
keywords = {Digital Twin, model, behavior, software architecture, system life cycle, data integration, predictive modeling, domain knowledge, software platform},
abstract = {It introduces the Digital Twin (DT) concept as a software counterpart of physical systems or processes. It defines foundational terms including systems, behavior, model, and software architecture, establishing a shared ground for subsequent discussions. The DT is presented as an integrated software representation that mirrors the physical system's major features, its behavior, and state in real or near-real time through models and data collected via sensors. Critical DT properties are introduced and discussed, such as representational capacity, reflection, entanglement, communication, persistency, and predictability, emphasizing the bidirectional relationship between physical and virtual entities. The chapter discusses different approaches for DT design, from top-down system specifications to bottom-up data-driven modeling, highlighting the importance of integrating data models and behavior models for actionable and adaptive twins. It also stresses the role of domain expertise and operational integration for practical DT adoption. The software architecture aspects essential for sound, flexible DT platform development are emphasized.}
}

@inbook{doi:https://doi.org/10.1002/9781394298334.ch05,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394298334},
title = {Architecting and Implementing Digital Twin Systems: Approaches, Guidelines, and Best Practices},
booktitle = {The Foundation for Digital Twins},
chapter = {5},
pages = {127-160},
doi = {https://doi.org/10.1002/9781394298334.ch05},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394298334.ch05},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394298334.ch05},
year = {2026},
keywords = {Digital Twin architecture, modularity, componentization, deployment, microservices, life-cycle management, software interaction, top-down modeling, bottom-up modeling, testing and validation, ISO 23247},
abstract = {It addresses architectural principles, design guidelines, and best practices for building effective Digital Twin systems. It outlines core requirements and structural concepts, emphasizing modularity and scalability in Digital Twin architecture. A versatile architecture is proposed, incorporating communication, data management, DT engines, and life-cycle management subsystems. The chapter highlights software interaction paradigms and the advantages of componentization for implementing maintainable and extensible DT solutions. It discusses various modeling approaches: top-down, i.e., starting from an initial specification of features and supporting models to the actual implementation of it; bottom-up, i.e., deriving descriptive and behavior models from the observation of the existing system; and hybrid comprising aspects of both. The possibility of using microservices for decomposing DT functionality into reusable components is also considered and analyzed. Practical considerations include preparing and packaging components for deployment and aligning architecture with standards such as ISO 23247. Testing and validation methodologies are underscored as critical for ensuring reliable DT operation and continuous improvement, with attention to techniques that span unit testing to enterprise-wide impact assessment.}
}

@inbook{doi:https://doi.org/10.1002/9781394345106.ch01,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394345106},
title = {The Start of the Journey},
booktitle = {Model Based System Engineering},
chapter = {1},
pages = {1-22},
doi = {https://doi.org/10.1002/9781394345106.ch01},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394345106.ch01},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394345106.ch01},
year = {2025},
keywords = {Model-based System Engineering, Abstraction, System Thinking, System Modeling, System Lifecycle, Digital Engineering, SysML},
abstract = {Model-based systems engineering (MBSE) is a new way of thinking about, designing, and making complex systems. This chapter presents my personal learning path, showing how MBSE has developed as a robust tool for system thinking, decision-making, and collaborative teamwork. By focusing on high-quality, abstract models that meet the needs of stakeholders, MBSE helps create systems that are reliable, efficient, and aim to serve a specific purpose. This approach goes against the traditional focus on documents, providing a clearer, more cooperative, and repetitive way of designing systems. Key ideas presented include the importance of abstraction, the benefits of different viewpoints, and the crucial importance of communication when developing systems. This chapter shows how MBSE brings together ideas from philosophy, linguistics, knowledge theory, and sociology to tackle the tough issues in today's system engineering.}
}

@inbook{doi:https://doi.org/10.1002/9781394293773.ch09,
author = {Mirakhorli, Mehdi and Greene, Kevin E.},
publisher = {John Wiley & Sons, Ltd},
isbn = {9781394293773},
title = {Secure by Design},
booktitle = {
                                                       
                    
                    AI
                                         for Cybersecurity
                
                },
chapter = {9},
pages = {267-288},
doi = {https://doi.org/10.1002/9781394293773.ch09},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394293773.ch09},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394293773.ch09},
year = {2025},
keywords = {Secure by Design, Artificial Intelligence},
abstract = {The “Secure by Design” approach has become pivotal in ensuring that security is embedded as a foundational attribute throughout the software development life cycle. This chapter explores the principles and methodologies underpinning Secure by Design, emphasizing proactive strategies that address vulnerabilities at the architectural level rather than through reactive measures. Key topics include the integration of security into system architecture, leveraging tactics such as software minimization, defense in depth, resilience, and user-centric design. The chapter also examines the critical role of requirements engineering, misuse and abuse cases, and the identification of common architectural weaknesses in mitigating security risks. Emerging advancements in artificial intelligence (AI) offer transformative potential for Secure by Design practices. AI-driven tools can enhance threat modeling, automate validation of security requirements, and predict potential vulnerabilities, enabling scalable and adaptive security solutions. This chapter highlights the intersection of AI and Secure by Design, discussing both opportunities and challenges, including ethical considerations and the risk of adversarial AI. Through case studies, empirical findings, and actionable frameworks, the chapter provides a comprehensive guide to fortifying modern systems against evolving cyber threats. Future directions focus on integrating explainable AI and advanced learning techniques to sustain the relevance and efficacy of Secure by Design in an increasingly complex digital landscape.}
}

@inbook{doi:https://doi.org/10.1002/9781394319749.ch3,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394319749},
title = {How to Do a Test},
booktitle = {Taking Testing Seriously},
chapter = {3},
pages = {75-136},
doi = {https://doi.org/10.1002/9781394319749.ch3},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394319749.ch3},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394319749.ch3},
year = {2025},
keywords = {boundary testing, bug reporting, equivalence classes, incidental coverage, intentional coverage, rapid software testing, scientific method},
abstract = {Summary The Rapid Software Testing (RST) methodology is a mindset and a skill set. Test coverage is the extent to which users have examined the product with respect to some model related to it. Coverage can be intentional or incidental. To cover something intentionally during testing means that users have a particular model in mind, as well as a specific way of sampling that product according to that model. Equivalence class partitioning is just a way of talking about the differences that users suspect matter. In RST, users define boundary testing as any testing intended to explore risk associated with boundaries. A good tester ought to be able to design, document, and perform a procedure in some manner that fits the context of the project. Bug reporting is central to testing. Good testing is a process of creating the most reliable, effective, and efficient pipeline for reporting bugs that matter.}
}

@article{https://doi.org/10.1002/stvr.70006,
author = {Schwarz, Georg-Daniel and Quast, Felix and Riehle, Dirk},
title = {Ensuring Syntactic Interoperability Using Consumer-Driven Contract Testing},
journal = {Software Testing, Verification and Reliability},
volume = {35},
number = {5},
pages = {e70006},
keywords = {action research, consumer-driven contract testing, guidelines, literature review, microservices, testing},
doi = {https://doi.org/10.1002/stvr.70006},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/stvr.70006},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/stvr.70006},
abstract = {ABSTRACT Integrating services in service-based architectures is a major concern and challenge to their developers. A key problem is that today's compilers cannot ensure syntactic interoperability of web APIs. Without further help, invalid calls surface only at runtime. Microservice-based architectures exacerbate this problem due to their use of polyglot software stacks and independent deployments. As a result, maintaining API compatibility with consumers has become increasingly complex. This study presents a systematic literature review on consumer-driven contract testing, a testing technique that ensures syntactic compatibility between microservices through isolated test execution. We develop a theory on when and how to use consumer-driven contract testing to address the problem of syntactic interoperability. We build out our theory with the insights of an action research study, contributing rare empirical data to the field. Our theory posits that consumer-driven contract testing can ensure syntactic interoperability between microservices and complement the testing strategy of such systems. The action research study confirmed this and revealed that introducing consumer-driven contract testing can promote the design and development of higher-quality APIs and code.},
year = {2025}
}

@inbook{doi:https://doi.org/10.1002/9781394345106.ch05,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781394345106},
title = {Model Verification and Validation},
booktitle = {Model Based System Engineering},
chapter = {5},
pages = {183-224},
doi = {https://doi.org/10.1002/9781394345106.ch05},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394345106.ch05},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394345106.ch05},
year = {2025},
keywords = {MBSE, Abstraction, System Modeling, Verification, Validation, Formal Methods, Simulation, Testing, Model Checking},
abstract = {In the field of complex systems engineering, having clear and feasible objectives is very important. As shown in earlier chapters, achieving agreement among different teams, each having their own tools and viewpoints, can be tricky. Still, there is some hope in managing this complexity carefully. By using models wisely and applying a sound methodology for narrowing down design alternatives, we can manage the tricky parts of system development. By making smart choices and quickly eliminating irrelevant solutions, we can move toward a system that meets the needs of all stakeholders, especially the customer. In this chapter, we embark on a journey to the heart of discourse verification and validation (V\&V). We will examine the important role of different logics that underpin the modeling techniques discussed in the previous chapter. Understanding the fundamentals of our models will help us keep our discussion clear, consistent, and feasible.}
}

@article{https://doi.org/10.2903/sp.efsa.2025.EN-9434,
author = {European Food Safety Authority (EFSA)},
title = {Symposium on Data Readiness for Artificial Intelligence},
journal = {EFSA Supporting Publications},
volume = {22},
number = {4},
pages = {9434E},
doi = {https://doi.org/10.2903/sp.efsa.2025.EN-9434},
url = {https://onlinelibrary.wiley.com/doi/abs/10.2903/sp.efsa.2025.EN-9434},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.2903/sp.efsa.2025.EN-9434},
note = {9434E EFSA-2025-0227},
abstract = {Abstract The Advisory Group on Data (AGoD) and the European Food Safety Authority (EFSA) organised a joint Symposium on Data Readiness for Artificial Intelligence on 23 and 24 October 2024 in Parma. The objective of the symposium was the exploration of the transformative impact of AI technologies within the food safety ecosystem. Given the in-person format of the event, particular attention was given to fostering increased cooperation between attendees working in the food safety field around Europe and beyond. This was the first opportunity for the AGoD and EFSA to host a meeting together, and it had been an objective of the AGoD since its first mandate. This event report contains the information from all the sessions and the ensuing conversations. Particular attention is to be given to the way in which the present report was generated; in fact, large language models were leveraged for summarising the speeches given during the symposium, and a specific methodology, which ensured several human-oversight checkpoints, was designed around it. All in all, the symposium was a very productive opportunity for this diverse crowd of experts to come together, learn from each other and discover new challenges. This positive outlook on the event was supported by a post-event feedback survey that showed that the majority of attendees were satisfied. As a follow-up to the event, the AGoD roadmap was updated to incorporate insights and opportunities from the symposium.},
year = {2025}
}

@article{https://doi.org/10.1002/cae.70180,
author = {Ai, Xiaozhu and Zhao, Feng},
title = {Redefining Project-Based Learning (PBL) With AIGC: Exploring a New Paradigm for Architectural Decoration Engineering Education},
journal = {Computer Applications in Engineering Education},
volume = {34},
number = {2},
pages = {e70180},
keywords = {architectural decoration education, artificial intelligence generated content (AIGC), human-machine collaborative creation, paradigm shift in education, Project-Based Learning (PBL)},
doi = {https://doi.org/10.1002/cae.70180},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cae.70180},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/cae.70180},
abstract = {ABSTRACT AI-Generated Content (AIGC) technology is profoundly reshaping architectural engineering education. Traditional PBL (Project-Based Learning) in architectural decoration faces challenges such as rigid teaching processes, difficulty in inspiring student creativity, lack of logical design development, and limited teacher guidance. This study aims to explore how AIGC technology can empower and fundamentally reconstruct the traditional PBL teaching process, thereby facilitating a shift in teaching objectives from ‘imparting software operation skills’ to ‘fostering human-machine collaboration’. Based on constructivist learning theory and design thinking, a five-stage PBL teaching model that deeply integrates AIGC tools was constructed. A prototype of a teaching support system was developed and implemented, and its effectiveness was validated through a one-semester experimental study. The empirical results indicate that, compared to students in the traditional PBL model, the experimental group students demonstrated significant improvements across multiple dimensions. The present research confirms that the systematic integration of AIGC is not merely a superposition of tools but a structural innovation of the PBL teaching process and educational paradigm, providing a practical and theoretical pathway for constructing a “human-machine collaborative creation” future in architectural engineering education.},
year = {2026}
}

