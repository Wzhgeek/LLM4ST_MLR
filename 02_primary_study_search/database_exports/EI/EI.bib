journal = {Proceedings of the ACM Symposium on Applied Computing},
author = {Nagata, Izumi and Mendonca, Israel and Utsunomiya, Kaito and Takaki, Yuto and Sasaki, Keisuke and Aritsugi, Masayoshi},
year = {2026},
pages = {1409 - 1417},
