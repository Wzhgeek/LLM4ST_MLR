@inproceedings{20262020728143 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2026 Elsevier Inc.},
copyright = {Compendex},
title = {Beyond Input Maturity: Evolving LLM-Based Test Generation},
journal = {Proceedings of the 19th Innovations in Software Engineering Conference, ISEC 2026},
author = {Karmarkar, Hrishikesh and Arora, Nishtha and Agrawal, Pankaj},
year = {2026},
pages = {ACM India; et al.; IBM; Metacube Software; Microsoft Research; TCS Research - },
address = {Jaipur, India},
abstract = {LLMs are increasingly used to generate tests from input natural language artefacts, with most approaches assuming a single, mature specification as input. Yet, in real world settings, documentation evolves from capability-level intent (Category 1), through explicit rules and constraints (Category 2), to screen-level UI manuals (Category 3). In this paper, we present a qualitative case study examining how this evolution affects the LLM-generated tests. Using a fixed prompt-based pipeline, we generate tests starting from Category 1-3 input artefacts for five web applications and analyze the resulting test sets along multiple dimensions such as intent invariants, rule completeness, adversarial coverage, traceability, and automation readiness. We further illustrate these effects through pairs of evolutionary and UI-only runs on two publicly documented systems. The study reveals a consistent pattern: UI manuals yield highly executable tests but bias generation toward workflow confirmation, often leaving intent-level invariants and global constraints implicit. Rule oriented artefacts enable more systematic boundary and negative testing, while early intent artefacts surface obligation-style invariants and misuse scenarios that are difficult to recover once intent is translated into UI narratives. These findings highlight structural blind spots introduced by deferring LLM-based test generation to late-stage UI artefacts. © 2026 Copyright held by the owner/author(s).},
key = {Surface testing},
keywords = {Human computer interaction;Human engineering;Software testing;},
note = {Case-studies;LLM-based testing;Natural languages;Qualitative case studies;Real world setting;Requirement-based testing;Rule and constraint;Test generations;UI testing;Web analysis;},
URL = {http://dx.doi.org/10.1145/3796563.3796587},
} 


@inproceedings{20261620552535 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2026 Elsevier Inc.},
copyright = {Compendex},
title = {Towards Generating High Quality Requirements For Space Missions Using RAG and Knowledge Graphs},
journal = {Proceedings of the International Astronautical Congress, IAC},
author = {Kenyon, Shaun and Arora, Chetan},
volume = {1-F219602},
year = {2025},
pages = {491 - 500},
issn = {00741795},
address = {Sydney, NSW, Australia},
abstract = {Traditional space missions demand that all project requirements are clearly specified, high-quality, and compliant to applicable regulatory policies. Requirements Engineering (RE) is the first and most critical phase in complex systems development projects (including space projects), as it defines mission expectations, objectives, and scope. Given the high criticality of these of projects, effective RE ensures stakeholder alignment, system feasibility, and compliance with stringent regulatory frameworks (e.g., national space laws, space standards). However, traditional RE methods struggle with scalability, evolving mission constraints, and cross-agency regulations, necessitating automation-assisted approaches that maintain accuracy, traceability, and explainability. Until recently, the complexity of natural language has meant that augmented RE workflows were beyond the capability of digital processing systems. The advent of transformer-based language models with contextualised attention mechanisms has enabled revitalised momentum in developing automated and/or augmented RE workflows. This research proposes a framework to structure and categorise Artificial Intelligence for Requirements Engineering (AI4RE) applications, and describes a single step advancement within the roadmap, moving from a basic LLM-assisted workflow to a more sophisticated one in the elicitation stage of the RE lifecycle. The paper discusses how ultimately, hybrid approaches that integrate Retrieval-Augmented Generation (RAG) pipelines, Knowledge Graphs (KGs), and Human-in-the-Loop (HITL) validation are the most appropriate techniques for enhancing the efficiency and reliability of complex and highly technical development projects. The integration of KG-enhanced RAG pipelines into RE tasks and activities does not (and should not) completely remove the role for qualified human involvement in RE. However it reduces the total cognitive load on engineers, which in turn allows them to focus on the tasks that most require human input. We suggest that this will improve traceability and enhance compliance verification, addressing one of the most persistent challenges in space systems engineering. By leveraging automated, knowledge-driven, and human-supervised RE processes, this work contributes a framework for structuring AI4RE development roadmaps. By developing this common language we hope to enable strategic collaborations towards trustworthy, Al-augmented RE for space exploration and satellite systems, delivering Pareto principle benefits while ensuring the precision and robustness required for mission success. Copyright ©2025 by the International Astronautical Federation (IAF). All rights reserved.},
key = {Ontology},
keywords = {Automation;Cognitive systems;Compliance control;Criticality (nuclear fission);Interplanetary flight;Large scale systems;Life cycle;Natural language processing systems;Regulatory compliance;Software design;Space research;Specifications;Systems analysis;},
note = {AI framework;Critical phasis;Engineering workflows;High quality;Knowledge graphs;Ontology's;Quality requirements;Regulatory policies;Requirement engineering;Space missions;},
URL = {http://dx.doi.org/10.52202/083091-0048},
} 


@unpublished{20260284757 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2026 Elsevier Inc.},
copyright = {Compendex},
title = {From Code-Centric to Intent-Centric Software Engineering: A Reflexive Thematic Analysis of Generative AI, Agentic Systems, and Engineering Accountability},
journal = {arXiv},
author = {De La Cruz, Elyson},
year = {2026},
issn = {23318422},
abstract = {Generative artificial intelligence (GenAI) and agentic systems are moving software engineering from code-centric production toward intent-centric human-agent work in which natural language, repository context, tools, tests, and governance shape delivery. Prior studies examine code generation, AI pair programming, and software engineering agents, but less is known about how public technical discourse and peer-reviewed evidence together frame the profession’s near-term transition. This study addresses that gap through a reflexive thematic analysis (RTA) dominant and interpretative phenomenological analysis (IPA) informed public-discourse and document analysis. The corpus combines peer-reviewed software engineering and AI literature, technical benchmarks, public talks and interviews, essays, product-facing technical announcements, and X-originated discourse from prominent AI and software engineering voices. Sources were organized through a corpus register, codebook, coding matrix, theme-to-source traceability table, DOI/reference audit, and reproducibility protocol. The analysis shows that GenAI lowers the cost of producing plausible code while increasing the importance of intent specification, context curation, architecture knowledge, verification, security, provenance, governance, and accountable human judgment. The findings indicate that software engineering is becoming less about isolated code authorship and more about supervising, validating, and governing socio-technical systems of humans, agents, tools, and evidence gates. This matters because speed-focused adoption can accumulate hidden technical debt and accountability gaps, whereas bounded autonomy can preserve quality, security, maintainability, and trust. © 2026, CC BY.},
key = {Computer software selection and evaluation},
keywords = {Artificial intelligence;Codes (symbols);Computer programming;Distributed computer systems;Human engineering;Intelligent agents;Professional aspects;Software architecture;Software quality;Software testing;Verification;},
note = {Agentic system;AI pair programming;Generative AI;Human-AI collaboration;Interpretative phenomenological analyze;Pair-programming;Phenomenological analysis;Reflexive thematic analyze;Software engineering agent;Software Quality;Thematic analysis;},
