@unpublished{20250218308 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2026 Elsevier Inc.},
copyright = {Compendex},
title = {LDIR: Low-Dimensional Dense and Interpretable Text Embeddings with Relative Representations},
