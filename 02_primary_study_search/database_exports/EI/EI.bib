title = {A Semantically Integrated Approach for MBSEMDAO Model Transformation},
journal = {SysCon 2026 - The 20th Annual IEEE International Systems Conference, Conference Proceedings},
author = {Xu, Tianxiao and Moalla, Nejib and Bentaha, Mohand-Lounes and Cereda, Giuseppe and Agostinelli, Claudia},
year = {2026},
pages = {IEEE Advancing Technology for Humanity; IEEE Systems Council - },
address = {Halifax, NS, Canada},
abstract = {In the automotive domain, Model-Based Systems Engineering (MBSE) has been widely adopted as an effective approach to managing system complexity, enabling the establishment of traceability between system requirements and various design elements. Integrating Multidisciplinary Design Analysis and Optimization (MDAO) into MBSE provides a quantitative verification mechanism that supports multidisciplinary trade-off analysis. Similarly, MBSE also enhances MDAO's capability to manage complex problems. However, a large number of MBSE and MDAO integration applications are tool-dependent, which means that when modeling languages or software tools are upgraded, the model transformation applications require significant time to modify or even complete redesign. Developing a reusable, scalable, and tool-independent integration approach that enables model transformation between MBSE and MDAO remains a significant challenge. This research proposes an MBSE and MDAO integrated workflow based on a semantic integration approach. It provides metamodel mapping between system models created in System Modelling Language (SysML) v1 and v2 and multidisciplinary models written in Python, thus achieving model transformation as well as guaranteeing digital continuity between the complex system design and analysis processes. The proposed approach is validated through a multidisciplinary trade-off case study in the automotive domain and is implemented by using a specific SysML tool together with an open-source MDAO tool. © 2026 IEEE.},
