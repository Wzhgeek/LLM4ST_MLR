note = {Attribution reasoning;Graph neural networks;Heterogeneous graph;Language model;Large language model;Requirements traceability;Software Quality;Source codes;Traceability links;Traceability methods;},
URL = {http://dx.doi.org/10.1109/APSEC66846.2025.00070},
