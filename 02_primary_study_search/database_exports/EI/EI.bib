copyright = {Compendex},
title = {RHLMA: A Role-Hierarchical LLM Multi-Agent Framework for Airborne Software Requirement Review},
journal = {Conference Proceedings - 2026 International Conference on Multi-Scale Artificial Intelligence: Drive Innovation Multi-Scale AI, MAI 2026},
author = {Sun, Jinghua and Yang, Rongtai and Gu, Jingjing and Chen, Lili and Zhao, Yige and Yang, Xin},
year = {2026},
pages = {IEEE; Shenyang Aerospace University - },
address = {Shenyang, China},
abstract = {The development of airborne software must strictly adhere to airworthiness standards such as DO-178C, where a rigorous review of requirements is crucial to ensure software quality and flight safety. However, existing automated methods encounter three critical limitations when processing the complex semantics of airborne software requirements: poor domain knowledge adaptation, inefficient multi-agent collaboration, and trustworthiness degradation caused by LLM overconfidence. To address these issues, this paper proposes RHLMA, a review framework based on Role-Hierarchical Large Language Model Multi-Agent collaboration. First, we construct a multi-task instruction dataset for the airborne domain and enhance the base model’s domain adaptation capability via supervised fine-tuning. Subsequently, a hierarchical collaborative architecture is designed, comprising task coordination, specialized review, and trusted aggregation. Through role-specific division of labor and hierarchical communication, the framework significantly reduces interaction overhead while ensuring comprehensive, multi-dimensional review depth. Furthermore, we integrate a retrieval-augmented generation (RAG) module and a confidence calibration mechanism to dynamically reference authoritative knowledge, thereby improving the trustworthiness and traceability of the review outcomes. Experiments conducted on real-world airborne software requirement data demonstrate that RHLMA substantially outperforms baseline methods on core review metrics, achieving higher accuracy alongside efficiency and reliability. The proposed framework thus offers an efficient and trustworthy solution for automated requirement review in safety-critical domains. © 2026 IEEE.},
key = {Multi agent systems},
keywords = {Automation;Calibration;Computer software selection and evaluation;Domain Knowledge;Information retrieval;Intelligent agents;Requirements engineering;Reviews;Safety engineering;Software quality;Software reliability;},
note = {Agent collaboration;Airborne software;Confidence calibration;Fine tuning;Language model;Large language model;Multi agent;Multi-agent collaboration;Requirement review;Retrieval-augmented generation;Supervised fine-tuning;},
URL = {http://dx.doi.org/10.1109/MAI69289.2026.11543713},
} 


@inproceedings{20252918807084 ,
language = {English},
