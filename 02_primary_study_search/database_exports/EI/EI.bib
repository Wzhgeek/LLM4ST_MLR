keywords = {Aerospace engineering;Formal verification;International cooperation;Pipelines;Requirements engineering;Safety engineering;Space flight;},
note = {Aerospace projects;Automated extraction;Cross documents;Documents analysis;Human-in-the-loop;Large programs;Project documents;Requirement engineering;Traditional approaches;Traditional approachs;},
