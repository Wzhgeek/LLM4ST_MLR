title = {SmartCommit: An AI-Powered Commit Message Solution},
journal = {9th SLAAI - International Conference on Artificial Intelligence, SLAAI-ICAI 2025},
author = {Epasinghe, S.K. and Gunarathne, K.P.A.N. and Priyadarshana, D.M.R.K. and Pasandul, H.W.T.P. and Karunananda, A.S. and Adhikari, A.M.A.M.},
year = {2025},
address = {Sri Lanka, Sri lanka},
abstract = {Modern software development heavily relies on clear, consistent, and standardized commit messages to ensure effective collaboration, traceability, and maintainability. A commit message is a brief description of the changes made to the program code in a version control system; it helps developers understand what was changed and why. However, manually written commit messages often lack clarity and consistency, leading to inefficiencies. This project introduces an AI-powered Commit Support System designed to automate and enhance the commit message generation process. The system analyzes code changes and generates meaningful, context-aware commit messages that align with organizational standards. It also offers next-word prediction and suggestions to assist developers during manual commit writing and provides insightful analytics based on commit history to help teams track development patterns and identify issues. The solution integrates contemporary front-end and back-end technologies, a structured database, and modern software engineering practices. Through intelligent automation and contextual understanding, this system reduces manual effort, improves commit quality, and enhances the overall software development workflow. © 2025 IEEE.},
