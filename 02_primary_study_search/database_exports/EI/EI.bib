title = {Knowledge Graph Construction and Quality Optimization for Airborne Software Requirement Generation},
journal = {Conference Proceedings - 2026 International Conference on Multi-Scale Artificial Intelligence: Drive Innovation Multi-Scale AI, MAI 2026},
author = {Xu, Yao and Cao, Guanyu and Fu, Linjuan and Sun, Jinghua and Zhao, Yige},
year = {2026},
pages = {IEEE; Shenyang Aerospace University - },
address = {Shenyang, China},
abstract = {Generating High-Level Requirements (HLRs) for airborne software in compliance with DO-178C is traditionally labor-intensive because engineering documents contain complex structures and stringent traceability constraints. Retrieval-Augmented Generation (RAG) can assist this task by grounding Large Language Models (LLMs) in domain evidence, but many existing studies emphasize retrieval efficiency while paying less attention to the construction quality of the underlying knowledge base and the explicit modeling of document logic. To address this gap, this paper proposes a knowledge graph construction and quality optimization method tailored for airborne software requirement generation. First, to preserve hierarchical and referential semantics in airborne engineering documents, we design a structured graph modeling strategy that encodes section hierarchies, cross-document references, and tabular constraints into the graph topology, reducing context fragmentation introduced by conventional chunk-based indexing. Second, to reduce noise from automated extraction, we develop a graph quality optimization mechanism based on LLM self-consistency, where multi-perspective reasoning is used to validate triples and detect logical conflicts. An in-domain evaluation on 14 airborne engineering documents shows that StructuGraphRAG improves Triple F1, Schema-Valid Rate, Provenance Grounding Rate, and downstream HLR traceability coverage over flat and partially ablated baselines, while maintaining structured provenance for certification-oriented review. The proposed approach provides a traceable knowledge-base construction process for assisted development in safety-critical software engineering. © 2026 IEEE.},
