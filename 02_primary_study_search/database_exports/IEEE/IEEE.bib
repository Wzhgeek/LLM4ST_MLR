@INPROCEEDINGS{11576374,
  author={Lee, TzeHoung and Sim, Hong Seng and Goh, Yong Kheng},
  booktitle={2026 IEEE 16th Symposium on Computer Applications & Industrial Electronics (ISCAIE)},
  title={A Formal Framework for Requirements Engineering in Large Language Model-Integrated Cyber-Physical Systems},
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models demonstrate sophisticated reasoning capabilities that could enhance cyber-physical systems, but their integration presents fundamental engineering challenges. LLM inference spans 2-5 seconds while safety-critical control requires millisecond response, creating six orders of magnitude temporal heterogeneity. LLMs exhibit probabilistic behavior incompatible with deterministic verification. LLM decision processes remain opaque, violating conventional traceability assumptions. This paper presents a systematic requirements engineering framework through three contributions: Temporal Requirement Stratification managing heterogeneous time scales, Probabilistic Requirement Verification providing safety despite non-deterministic behavior, and AI-Extended Requirements Traceability Matrix capturing emergent capabilities and reasoning chains. Validation across 1000 simulation trials demonstrates $\mathbf{7 4 \%}$ tactical quality [71.2%, 76.8%], 99.9% safety, and complete traceability. Physical hardware validation on DOFBOTSE 6-DOF arm (50 trials) confirms 72% quality [58.3%, 83.1%] with maintained safety.},
  keywords={Safety;Large language models;Modeling;Timing;Cognition;Cognitive systems;Printing;Simulation;Artificial intelligence;Planning;requirements engineering;cyber-physical systems;large language models;formal verification;systems integration;AI safety},
  doi={10.1109/ISCAIE68866.2026.11576374},
  ISSN={2836-4317},
  month={April},
}

@INPROCEEDINGS{11137286,
  author={Zhang, Xiaoning and Chen, Muyao and Wu, Rui and Luo, Weichao and Liang, Xiaojun},
  booktitle={2025 IEEE 26th China Conference on System Simulation Technology and its Applications (CCSSTA)},
  title={Closed-Loop Multi-Agent Framework for Airborne Systems MBSE Requirements Standardization},
  year={2025},
