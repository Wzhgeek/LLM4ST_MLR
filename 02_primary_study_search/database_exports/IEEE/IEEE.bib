@INPROCEEDINGS{11483940,
  author={Parthiban, M. and Priyanka, Mutyala Hari and Teja, Pavan and Kumari, Ratna and Narim, Subbalakshmi},
  booktitle={2026 IEEE International Conference on Intelligent Systems, Smart and Green Technologies (ICISSGT)},
  title={Systematic Review of Cloud Enabled AI Framework for Optimizing the Software Development Life Cycle},
  year={2026},
  volume={1},
  number={},
  pages={1-5},
  abstract={Software Development Life Cycle (SDLC) remains a solid engineering base on developing failure free software; however, traditional models are commonly fraught with in-efficiencies, human error, and redundancy. Cloud computing and the advent of Artificial Intelligence (AI) in the forms of Large Language Models (LLMs) and Generative AI have provided new possibilities for SDLC efficiency and scalability optimization. This paper formally surveys the current literature and frameworks on cloud-based AI-optimized SDLC. It delineates how AI simplifies requirement extraction, de-sign modeling, auto-coding, testing, and project risk management, whereas cloud infrastructure provides scalability, integration, and flexibility. Comparative evaluation of 22 peer-reviewed articles emphasizes greater precision, development velocity, and resource utilization but also the limitations of traceability, cross-phase orchestration, and security integration. The research highlights major future directions including integrated AI-SDLC systems, agentic orchestration, security conformity to OWASP standards, and sustainability integration. Generally, cloud-enabled AI provides a revolutionary approach to software engineering.},
