}

@INPROCEEDINGS{11190341,
  author={Ly, Delina and Radhakrishnan, Sruthi and Aydemir, Fatma Başak and Dalpiaz, Fabiano},
  booktitle={2025 IEEE 33rd International Requirements Engineering Conference (RE)},
  title={Navigating through Work Items in Issue Tracking Systems via Natural Language Queries},
  year={2025},
  volume={},
  number={},
  pages={308-319},
  abstract={Issue Tracking Systems (ITSs) serve multiple purposes in software development: they represent requirements and bugs, facilitate communication between team members, and support project management by assigning tasks. As software systems and projects increase in complexity, the number of work items and their relationships grows considerably, forming a complex network that is difficult and time-consuming for team members to navigate using traditional ITSs. Motivated by the interest of two companies in exploring the use of Artificial Intelligence in software development, we introduce the GraphRAG Dialogue Insights (GDI) framework. GDI uses knowledge graphs, Retrieval-Augmented Generation (RAG), and Large Language Models (LLMs) to enable users to query work items in natural language (NL). In addition to a NL response, GDI returns supporting information to help users understand how the LLMs queried the knowledge graph. We empirically validate GDI through two proof-of-concept implementations, each addressing a use case: i) onboarding and ii) trace link recovery. Initial user-centered validations indicate that practitioners find the system intuitive, useful, and accurate in generating responses. Moreover, they express willingness to adopt the system and identify additional potential use cases, including impact analysis, troubleshooting, and issue resolution. However, further refinement is required to deploy the system in practice.},
  keywords={Surveys;Accuracy;Navigation;Large language models;Scalability;Natural languages;Knowledge graphs;Companies;Syntactics;Software systems;Issue Tracking Systems;Large Language Models;Prompt Engineering;GraphRAG;Onboarding;Trace Link Recovery},
  doi={10.1109/RE63999.2025.00037},
  ISSN={2332-6441},
  month={Sep.},
}

@INPROCEEDINGS{11453865,
  author={Jayasingha, Chathura Prabath and Kumari, Suriyaa},
  booktitle={2026 6th International Conference on Advanced Research in Computing (ICARC)},
  title={Automating Voice-Based Conversations into Formal User Stories Using LLM and Speech Recognition},
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Agile software development relies heavily on informal verbal discussions for requirements gathering, leading to documentation gaps, inconsistencies, and scalability challenges. This paper proposes an automated pipeline that combines Automatic Speech Recognition (ASR) with fine-tuned Large Language Models (LLMs) to convert Agile voice conversations directly into formal user stories. We employ OpenAI's Whisper model for accurate transcription of multi-speaker Agile meetings and fine-tune a GPT-2 model (ReqWeaver-GPT2) to extract and structure requirements into “As a [role], I want [feature], so that [benefit]” templates. Evaluation on a custom dataset of Agile conversations shows the pipeline achieves BLEU scores of 0.68, ROUGE-L of 0.72, and reduces documentation time by approximately 50 % compared to manual methods. While the system demonstrates strong performance in controlled settings, we acknowledge limitations in handling extreme speaker overlaps and domain-specific jargon without further tuning. The proposed approach significantly enhances documentation consistency, traceability, and team productivity in Agile workflows.},
  keywords={Adaptation models;Terminology;Large language models;Pipelines;Agile software development;Documentation;Oral communication;Feature extraction;Tuning;Automatic speech recognition;Agile software development;Large language models;Requirement elicitation;Speech-to-text;User stories},
  doi={10.1109/ICARC68737.2026.11453865},
  ISSN={},
  month={Feb},
}

@INPROCEEDINGS{11190276,
  author={Wang, Chunhui and Zhao, Jiaqi and Jin, Zhi},
  booktitle={2025 IEEE 33rd International Requirements Engineering Conference Workshops (REW)},
  title={Prompting LLM for Embedded SRS Generation: A Case Study of Elder Care System},
  year={2025},
  volume={},
  number={},
  pages={149-156},
  abstract={The elderly care system, as a typical software-hardware co-designed embedded system, requires its requirements specification process to start with understanding user intention. By clarifying core elements such as control software, devices, interfaces, and interactive information, it systematically acquires system requirements and software requirements to ultimately form standardized documentation. This process faces complexity challenges arising from the intersection of multi-dimensional knowledge, notably the difficulty in maintaining the completeness, consistency, and traceability of requirements. This paper proposes a guided large language model (LLM)-based software requirements specification (SRS) generation method. This method starts with user intention analysis, integrates requirements modeling knowledge to design guidance templates, directs LLMs to generate hierarchical requirements information from software-hardware environments to interaction relationship construction, and organizes it into structured documents according to the IEEE requirements specification template. Validated through the elderly care system case, this method effectively improves the quality of requirements documents.},
  keywords={Industries;Embedded systems;Large language models;Medical services;Quality assessment;Requirements engineering;Reliability;Older adults;Monitoring;Faces;Embedded system;Software requirements specification generation;Prompting LLM;Case study;Elder care system},
  doi={10.1109/REW66121.2025.00024},
  ISSN={2770-6834},
  month={Sep.},
}

@INPROCEEDINGS{10764997,
  author={Fazelnia, Mohamad and Mirakhorli, Mehdi and Bagheri, Hamid},
  booktitle={2024 39th IEEE/ACM International Conference on Automated Software Engineering (ASE)},
  title={Translation Titans, Reasoning Challenges: Satisfiability-Aided Language Models for Detecting Conflicting Requirements},
  year={2024},
  volume={},
  number={},
  pages={2294-2298},
  abstract={Detecting conflicting requirements early in the software development lifecycle is crucial to mitigating risks of system failures and enhancing overall reliability. While Large Language Models (LLMs) have demonstrated proficiency in natural language understanding tasks, they often struggle with the nuanced reasoning required for identifying complex requirement conflicts. This paper introduces a novel framework, SAT-LLM, which integrates Satisfiability Modulo Theories (SMT) solvers with LLMs to enhance the detection of conflicting software requirements. SMT solvers provide rigorous formal reasoning capabilities, complementing LLMs’ proficiency in natural language understanding. By synergizing these strengths, SAT-LLM aims to overcome the limitations of standalone LLMs in handling intricate requirement interactions. The early experiments provide empirical evidence supporting the effectiveness of our SAT-LLM over pure LLM-based methods like ChatGPT in identifying and resolving conflicting requirements. These findings lay a foundation for further exploration and refinement of hybrid approaches that integrate NLP techniques with formal reasoning methodologies to address complex challenges in software development.CCS CONCEPTS• Software and its engineering → Traceability; • Computing methodologies → Knowledge representation and reasoning.},
  keywords={Computational modeling;Large language models;Knowledge representation;Reliability theory;Chatbots;Cognition;Software;Software reliability;Software development management;Software engineering;Software Requirements Conflict;Large Language Models;Formal Reasoning;Satisfiability;SMT;Conflict Detection;LLMs;Reasoning},
  doi={},
  ISSN={2643-1572},
  month={Oct},
}

@INPROCEEDINGS{11156083,
  author={Zakkiya, Salsa Arifah and Selviandro, Nungki and Utomo, Rio Guntur},
  booktitle={2025 IEEE International Conference on Artificial Intelligence for Learning and Optimization (ICoAILO)},
  title={A Guideline for the Adoption of Generative AI to Support Secure Software Development Life Cycle (SSDLC): A Case Study of ChatGPT},
  year={2025},
  volume={},
  number={},
  pages={62-68},
  abstract={Secure software development using generative AI is gaining traction, particularly in academic environments where undergraduate teams often lack structured guidance. A key challenge is aligning documentation outputs with formal standards such as OWASP ASVS when using large language models (LLMs) like ChatGPT-4o. This study proposes a Secure SDLC guideline incorporating a six-element prompting framework Context, Task, Instruction, Clarify, Refine, and Warning combined with OWASP ASVS principles. A case study involving a student-developed village information system applied the guideline from Project Charter to Secure Design phases. Results demonstrated improved completeness and standard alignment in early phases, though limitations were found in traceability during Business Requirements and Threat Modeling.},
  keywords={Threat modeling;Documentation;Reliability engineering;Software reliability;Security;Prompt engineering;Standards;Guidelines;Software development management;Software engineering;secure SDLC;OWASP ASVS;security documentation;generative AI;chatGPT-4o;prompt engineering},
  doi={10.1109/ICoAILO66760.2025.11156083},
  ISSN={},
  month={Aug},
}

@INPROCEEDINGS{11525613,
  author={Chen, Hao and Liu, Feiyang and Li, Bin and Li, Zhiyun and Zhang, Yunfei},
  booktitle={2026 7th International Conference on Mechatronics Technology and Intelligent Manufacturing (ICMTIM)},
  title={LLM/VLM-Driven Integrated Testing Framework for Autonomous Driving Assistance Systems: From Requirements to Failure Attribution},
  year={2026},
  volume={},
  number={},
  pages={85-91},
  abstract={The validation of Advanced Driver Assistance Systems (ADAS) including Automatic Emergency Braking (AEB), Lane Keeping Assist (LKA), Adaptive Cruise Control (ACC), and Navigate on Autopilot (NOA) faces significant challenges in addressing complex weather conditions, irregular objects, dynamic interactions, and long-tail scenarios. This paper proposes a comprehensive Large Language Model (LLM) and Vision Language Model (VLM) driven testing methodology that integrates requirement understanding, scenario generation, risk coverage, test execution, result determination, and failure attribution into a unified framework. Our approach transforms natural language regulations, functional specifications, accident cases, and Operational Design Domain (ODD) constraints into structured testing knowledge graphs and executable scenario parameter spaces. We establish hierarchical validation loops through simulation, hardware-in-the-loop, and real-vehicle testing environments. To ensure reliability, we introduce verifiability design through formal constraints, scenario traceable encoding, coverage metrics, risk triggering conditions, and LLM output consistency validation. Rather than directly replacing testing decisions, LLMs serve as test case expanders, boundary condition discoverers, and failure interpreters. Experimental results demonstrate significant improvements: 87.3 % scenario coverage compared to 52.7 % for traditional methods, 34.2 % improvement in risk detection sensitivity, and 68.5 % increase in testing efficiency while maintaining 94.1 % consistency validation accuracy.},
  keywords={Testing;Modeling;Large language models;Printing;Advanced driver assistance systems;Safety;Scenario generation;Equations;Measurement;Knowledge graphs;Autonomous driving;Advanced driver assistance systems;Large language models;Vision language models;Testing framework;Scenario generation;Formal verification},
  doi={10.1109/ICMTIM69588.2026.11525613},
  ISSN={},
  month={April},
}

@INPROCEEDINGS{9920081,
  author={Ajagbe, Muideen and Zhao, Liping},
  booktitle={2022 IEEE 30th International Requirements Engineering Conference (RE)},
  title={Retraining a BERT Model for Transfer Learning in Requirements Engineering: A Preliminary Study},
  year={2022},
  volume={},
  number={},
  pages={309-315},
  abstract={In recent years, advanced deep learning language models such as BERT, ELMO, ULMFiT and GPT have demonstrated strong performance on many general natural language processing (NLP) tasks. BERT, in particular, has also achieved promising results on some domain-specific tasks, including the requirements classification task. However, in spite of its great potential, BERT under-performs on domain specific tasks. In this paper, we present BERT4RE, a BERT-based model retrained on requirements texts, aiming to support a wide range of requirements engineering (RE) tasks, including classifying requirements, detecting language issues, identifying key domain concepts, and establishing requirements traceability links. We demonstrate the transferability of BERT4RE, by fine-tuning it for the task of identifying key domain concepts. Our preliminary study shows that BERT4RE achieved better results than the BERTbase model on the demonstrated RE task.},
  keywords={Deep learning;Bit error rate;Transfer learning;Natural language processing;Requirements engineering;Task analysis;Requirements Engineering;Requirements Classification;Language Models;BERT;Domain-Specific Language Models;Transfer Learning;Deep Learning;Machine Learning;Natural Language Processing},
  doi={10.1109/RE54965.2022.00046},
  ISSN={2332-6441},
  month={Aug},
}

@INPROCEEDINGS{10703827,
  author={Dahiya, Mahima and Li, Mark and Horton, Glen and Scherz, Thomas and Niu, Nan},
  booktitle={2024 IEEE International Conference on Information Reuse and Integration for Data Science (IRI)},
  title={Tracing Feature Tests to Textual Requirements},
  year={2024},
  volume={},
  number={},
  pages={120-125},
  abstract={Software features deliver values to the end users, and thus their qualities shall be assured. While the mainstream quality assurance technique is software testing, its adequacy can only be assessed by tracing the testing artifacts to system requirements. In this paper, we report an in-depth case study aiming to trace all the feature tests of a Web application to textual requirements. To that end, we experiment two automated trace recovery methods: vector space model and transformer-based semantic embedding. The tracing results, unfortunately, are not satisfactory. We then explore the use of large language models, OpenAI’s ChatGPT in particular. We engage the original developers into evaluating the tracing and ChatGPT-prompting results. Our study reveals the promises of exploiting large language models to assist in software tracing activities.},
  keywords={Software testing;Quality assurance;Large language models;Semantics;Data science;Chatbots;Transformers;Software;Vectors;Rough surfaces;requirements traceability;software testing;trace recovery;large language models},
  doi={10.1109/IRI62200.2024.00035},
  ISSN={2835-5776},
  month={Aug},
}

@INPROCEEDINGS{11190335,
  author={Sharfuddin, Ateeq and Breaux, Travis},
  booktitle={2025 IEEE 33rd International Requirements Engineering Conference (RE)},
  title={Generative Goal Modeling},
  year={2025},
  volume={},
  number={},
  pages={92-103},
  abstract={In software engineering, requirements may be acquired from stakeholders through elicitation methods, such as interviews, observational studies, and focus groups. When supporting acquisition from interviews, business analysts must review transcripts to identify and document requirements. Goal modeling is a popular technique for representing early stakeholder requirements as it lends itself to various analyses, including refinement to map high-level goals into software operations, and conflict and obstacle analysis. In this paper, we describe an approach to use textual entailment to reliably extract goals from interview transcripts and to construct goal models. The approach has been evaluated on 15 interview transcripts across 29 application domains. The findings show that GPT-4o can reliably extract goals from interview transcripts, matching 62.0% of goals acquired by humans from the same transcripts, and that GPT-4o can trace goals to originating text in the transcript with 98.7% accuracy. In addition, when evaluated by human annotators, GPT-4o generates goal model refinement relationships among extracted goals with 72.2% accuracy.},
  keywords={Accuracy;Reviews;Error analysis;Software;Software reliability;Stakeholders;Requirements engineering;Interviews;Software engineering;Business;requirement;elicitation;interview;goal modeling},
  doi={10.1109/RE63999.2025.00019},
  ISSN={2332-6441},
  month={Sep.},
}

@INPROCEEDINGS{11351757,
  author={Hariharan, Mohanakrishnan and Barma, Seshu and Arvapalli, Satish and Sheela, Evangeline},
  booktitle={2025 IEEE International Conference on Data and Software Engineering (ICoDSE)},
  title={Agentic RAG for Software Testing with Hybrid Vector-Graph and Multi-Agent Orchestration},
  year={2025},
  volume={},
  number={},
  pages={54-59},
  abstract={We present an approach to automating software testing using Agentic Retrieval-Augmented Generation (RAG) systems for creating Quality Engineering (QE) artifacts. This approach combines autonomous AI agents with hybrid vector-graph knowledge systems to automate the generation of test plans and test cases. The scope of this paper is limited to the test cases and plan generation. Our approach addresses traditional software test case authoring limitations by leveraging LLMs such as Gemini and Mistral, multi-agent orchestration, and enhanced contextualization. The system achieves remarkable accuracy improvements from 65% to 94.8% while ensuring comprehensive document traceability throughout the quality engineering lifecycle. Experimental validation of enterprise Corporate Systems Engineering and SAP migration projects demonstrates an 85% reduction in testing timeline, an 85% improvement in test suite efficiency, and projected 35% cost savings, resulting in a 6-month acceleration of go-live.},
  keywords={Software testing;Costs;Automation;Retrieval augmented generation;Knowledge based systems;Life estimation;Systems engineering and theory;Hybrid power systems;Software;Software engineering;agentic systems;retrieval-augmented generation;software testing;quality engineering;multi-agent orchestration;hybrid vector-graph;test automation;SAP testing;enterprise systems},
  doi={10.1109/ICoDSE68111.2025.11351757},
  ISSN={2640-0227},
  month={Oct},
}

@INPROCEEDINGS{11388648,
  author={Han, Lili and Ma, Bo and Zhou, Yan and QiangMin},
  booktitle={2025 IEEE 6th International Conference on Computer, Big Data, Artificial Intelligence (ICCBD+AI)},
  title={KNSE-Code: A Knowledge-Aware, Safety-Enhanced, Rule-Driven Framework for Aviation Safety-Critical Software Code Generation},
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Due to the extremely strict requirements for safety and compliance, the automatic generation of codes for aviation safety-critical software still faces challenges. Although large language models (LLMs) demonstrate amazing progress in code generation, the codes they produce often fail to meet essential safety criteria. Such codes may lack traceability to requirements, compliance with filed regulations, and alignment with established engineering practices—each of these being critical in safety-critical domains. This paper introduces KNSE-Code, a knowledge-guided framework designed to integrate formally verified engineering knowledge directly into the code generation process. By dynamically injecting structured rules from a domain-specific knowledge graph into the prompts, the framework ensures that safety standards are inherently respected during code generation, rather than through post-hoc inspection. Three software requirements from a safety-critical aircraft system, which span the domains of mode transition, control logic, and data processing, were selected for the validation of the KNSE model. comparing it against manual coding and direct LLM generation. The results show that KNSE-Code matches 100% functional complete, reduces safety violations by up to 85% compared to direct LLM generation, and completely avoids high-severity violations. The generated code is fully traceable and annotated, supporting auditability and long-term maintainability. This approach highlights the value of integrating domain knowledge with LLMs to build trustworthy, compliant, and maintainable software for safety-critical domains.},
  keywords={Knowledge engineering;Codes;Large language models;Knowledge graphs;Manuals;Software;Regulation;Safety;Logic;Standards;Intelligent code generation;large language models;aviation safety-critical software;rule-driven;knowledge graph;traceability},
  doi={10.1109/ICCBDAI66607.2025.11388648},
  ISSN={},
  month={Nov},
}

@INPROCEEDINGS{11519800,
  author={Slimene, Imededdine Ben and Roa, Maximo A. and Leidner, Daniel and Stelzer, Martin},
  booktitle={2026 IEEE Aerospace Conference},
  title={Automated Extraction and Cross-Document Analysis of Aerospace Project Requirements Using LLMs},
  year={2026},
  volume={},
  number={},
  pages={1-12},
  abstract={Requirements engineering remains a fundamental yet time-consuming activity for aerospace and other complex systems, where large project documents define mission- and safety-critical specifications. Traditional approaches are challenged by the scale, heterogeneity, and ambiguity of such documents, making it difficult to ensure traceability, consistency, and completeness. This paper introduces a human-in-the-loop requirements analysis pipeline that automates requirement extraction, classification, and verification for aerospace project documentation. The tool employs a hybrid architecture: a document-agnostic, Large Language Model (LLM)assisted parser induces Regular expressions (regex)-based rules to extract requirement blocks into a normalized database, while subsequent analysis pipelines evaluate the requirements from complementary perspectives. The structural pipeline identifies redundancy, traceability gaps, and document coverage issues; the semantic/logic pipeline leverages LLMs to assess ambiguity, conflicts, and requirement clarity. A human-in-the-loop review process validates and refines outputs for reliability in aerospace contexts. While the system is designed for on-premises execution to satisfy exportcontrol and privacy constraints, our experiments were conducted with cloud-hosted LLMs pending local deployment. An initial evaluation on a synthetic European Cooperation for Space Standardization (ECSS)-style corpus representative of spacecraft project documents demonstrates the feasibility of the approach, with strong performance in structured extraction and classification, and clear insights into current limitations of semantic reasoning. Across 225 requirements, leading models achieve Balanced Accuracy (BAcc) of 0.70-0.80 and we have 3% parse errors. The architecture provides a foundation for integration with formal modeling workflows and future verification tasks.},
  keywords={Modeling;Labeling;Pipelines;Equations;Large language models;Printing;Accuracy;Measurement;Reviews;Tagging},
  doi={10.1109/AERO66936.2026.11519800},
  ISSN={2996-2358},
  month={March},
}

@INPROCEEDINGS{11190266,
  author={Huang, Kaicheng and Wang, Fanyu and Huang, Yutan and Arora, Chetan},
  booktitle={2025 IEEE 33rd International Requirements Engineering Conference Workshops (REW)},
  title={Prompt Engineering for Requirements Engineering: A Literature Review and Roadmap},
  year={2025},
  volume={},
  number={},
  pages={548-557},
  abstract={Advancements in large language models (LLMs) have led to a surge of prompt engineering (PE) techniques that can enhance various requirements engineering (RE) tasks. However, current LLMs are often characterized by significant uncertainty and a lack of controllability. This absence of clear guidance on how to effectively prompt LLMs acts as a barrier to their trustworthy implementation in the RE field. We present the first roadmap-oriented systematic literature review of Prompt Engineering for RE (PE4RE). Following Kitchenham’s and Petersen’s secondary-study protocol, we searched six digital libraries, screened 867 records, and analyzed 35 primary studies. To bring order to a fragmented landscape, we propose a hybrid taxonomy that links technique-oriented patterns (e.g., fewshot, Chain-of-Thought) to task-oriented RE roles (elicitation, validation, traceability). Two research questions—with five subquestions—map the tasks addressed, LLM families used, and prompt types adopted, and expose current limitations and research gaps. Finally, we outline a step-by-step roadmap showing how today’s ad-hoc PE prototypes can evolve into reproducible, practitioner-friendly workflows.},
  keywords={Uncertainty;Protocols;Taxonomy;Prototypes;Market research;Libraries;Requirements engineering;Prompt engineering;Surges;Systematic literature review},
  doi={10.1109/REW66121.2025.00081},
  ISSN={2770-6834},
  month={Sep.},
}

@INPROCEEDINGS{10771003,
  author={Elvira, Timothy and Procko, Tyler Thomas and Ochoa, Omar},
  booktitle={2024 Conference on AI, Science, Engineering, and Technology (AIxSET)},
  title={Requirements Elicitation for Machine Learning Applications: A Research Preview},
  year={2024},
  volume={},
  number={},
  pages={218-221},
  abstract={The development of software systems is preceded by an important first phase, requirements elicitation, wherein developers establish the intended functionality of a system to be developed in a series of interviews with a customer. These requirements can often be raw, requiring refinement in an iterative process. Traditional software requirements are of the form 'The system shall … ‘, where each requirement is written to be clear, concise, consistent, complete, testable and traceable through development. Because Machine Learning (ML) is stochastic, or uncertain, in the face of unseen data, ML behavior cannot be precisely defined. As such, it is posited that software requirements specific to ML must delineate a window of acceptable behavior, e.g., a plus/minus value for evaluated model metrics. The provision of such is essential for the quality of future ML software systems, as the current trend of large-scale generative ML has brought about a paradigm of fine-tuning, e.g., of Large Language Models, in which pre-trained large models are taken “off the shelf” and made fit for very specific purposes. These specific purposes vary with different use cases, but they are effectively undeclared requirements. The present paper discusses requirements elicitation in the context of ML by considering the four-software engineering requirement elicitation techniques: conversational, observational, analytic and synthetic, providing future researchers with insight for eliciting quality ML requirements.},
  keywords={Measurement;Technological innovation;Large language models;Software algorithms;Stochastic processes;Prototypes;Machine learning;Software systems;Market research;Iterative methods;Software Engineering;Requirements Engineering;Machine Learning},
  doi={10.1109/AIxSET62544.2024.00042},
  ISSN={},
  month={Sep.},
}

@INPROCEEDINGS{11543709,
  author={Xu, Yao and Cao, Guanyu and Fu, Linjuan and Sun, Jinghua and Zhao, Yige},
  booktitle={2026 International Conference on Multi-scale Artificial Intelligence (MAI)},
  title={Knowledge Graph Construction and Quality Optimization for Airborne Software Requirement Generation},
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Generating High-Level Requirements (HLRs) for airborne software in compliance with DO-178C is traditionally labor-intensive because engineering documents contain complex structures and stringent traceability constraints. Retrieval-Augmented Generation (RAG) can assist this task by grounding Large Language Models (LLMs) in domain evidence, but many existing studies emphasize retrieval efficiency while paying less attention to the construction quality of the underlying knowledge base and the explicit modeling of document logic. To address this gap, this paper proposes a knowledge graph construction and quality optimization method tailored for airborne software requirement generation. First, to preserve hierarchical and referential semantics in airborne engineering documents, we design a structured graph modeling strategy that encodes section hierarchies, cross-document references, and tabular constraints into the graph topology, reducing context fragmentation introduced by conventional chunk-based indexing. Second, to reduce noise from automated extraction, we develop a graph quality optimization mechanism based on LLM self-consistency, where multi-perspective reasoning is used to validate triples and detect logical conflicts. An in-domain evaluation on 14 airborne engineering documents shows that StructuGraphRAG improves Triple F1, Schema-Valid Rate, Provenance Grounding Rate, and downstream HLR traceability coverage over flat and partially ablated baselines, while maintaining structured provenance for certification-oriented review. The proposed approach provides a traceable knowledge-base construction process for assisted development in safety-critical software engineering.},
  keywords={Modeling;Retrieval augmented generation;Construction;Knowledge graphs;Software;Triples (Data structure);Large language models;Printing;Design methodology;Logic;DO-178C;airborne software;requirement generation;knowledge graph;RAG},
  doi={10.1109/MAI69289.2026.11543709},
  ISSN={},
  month={April},
}

@INPROCEEDINGS{10628501,
  author={Abdeen, Waleed and Unterkalmsteiner, Michael and Wnuk, Krzysztof and Chirtoglou, Alexandros and Schimanski, Christoph and Goli, Heja},
  booktitle={2024 IEEE 32nd International Requirements Engineering Conference (RE)},
  title={Multi-Label Requirements Classification with Large Taxonomies},
  year={2024},
  volume={},
  number={},
  pages={264-274},
  abstract={Context and motivation: Classification aids software development activities by organizing requirements in classes for easier access and retrieval. The majority of requirements classification research has, so far, focused on binary or multi-class classification. Question/problem: Multi-label classification with large taxonomies could aid requirements traceability but is prohibitively costly with supervised training. Hence, we investigate zero-short learning to evaluate the feasibility of multi-label requirements classification with large taxonomies. Principal ideas/results: We associated, together with domain experts from the industry, 129 requirements with 769 labels from taxonomies ranging between 250 and 1183 classes. Then, we conducted a controlled experiment to study the impact of the type of classifier, the hierarchy, and the structural characteristics of taxonomies on the classification performance. The results show that: (1) The sentence-based classifier had a significantly higher recall compared to the word-based classifier; however, the precision and F1-score did not improve significantly. (2) The hierarchical classification strategy did not always improve the performance of requirements classification. (3) The total and leaf nodes of the taxonomies have a strong negative correlation with the recall of the hierarchical sentence-based classifier. Contribution: We investigate the problem of multi-label requirements classification with large taxonomies, illustrate a systematic process to create a ground truth involving industry participants, and provide an analysis of different classification pipelines using zero-shot learning.},
  keywords={Industries;Training;Systematics;Zero-shot learning;Large language models;Taxonomy;Pipelines;requirements classification;domain-specific tax-onomy;large-scale;multi-label},
  doi={10.1109/RE59067.2024.00033},
  ISSN={2332-6441},
  month={June},
}

@INPROCEEDINGS{11190112,
  author={Zhang, Liyuan and Li, Zhi and Xiao, Hongbin and Li, Changjin and Huang, Bo and Chen, Xu},
  booktitle={2025 IEEE 33rd International Requirements Engineering Conference Workshops (REW)},
  title={From Causal Graphs to Problem Diagrams: Enhancing Safety Requirement Modeling with LLM},
  year={2025},
  volume={},
  number={},
  pages={133-140},
  abstract={Safety requirements play a crucial role in ensuring the reliability of Cyber-Physical Systems. Causal graphs provide structured support for the generation and validation of safety requirements by revealing the logical links between system behaviours and potential threats. Traditional methods rely on manual experience to analyse failure causality and safety requirement causality, resulting in inefficiency and limited traceability. Although Problem Frames (PF) can effectively describe system requirements and boundaries, they lack explicit causal logic, hindering causality traceability. In this paper, we propose a causal enhancement modelling approach that fuses LLMs with fault analysis. Firstly, the causal graphs are generated through a combination of prompt engineering and manual inspection patterns, and problem diagrams are constructed accordingly. Secondly, the causal logic is embedded in the PF as a semantic layer, and the safety requirement propagation paths between the physical and information domains are explicitly proposed. Finally, a comparative experimental evaluation was conducted using a multi-rotor UAV GPS system as a case study to verify the usability of the proposed method. The results indicate that our method increased the average number of safety requirement domains by 4.47 and interactions between domains by 7.33. Our approach enables fault-driven safety requirements modeling, enhances PF’ semantic expressiveness and interpretability, and offers a semi-automated, reliable solution that bridges AI causal reasoning with formal modeling for complex systems.},
  keywords={Analytical models;Semantics;Cause effect analysis;Manuals;Safety;Reliability;Logic;Requirements engineering;Prompt engineering;Usability;Safety requirements;Problem Frames;causal graphs;fault analysis},
  doi={10.1109/REW66121.2025.00022},
  ISSN={2770-6834},
  month={Sep.},
}

@INPROCEEDINGS{11370116,
  author={Loose, Davis C. and Gunn, Megan E. and Linkov, Igor and Gunn, Matthew C. and Moghadasi, Negin and Collier, Zachary A. and Lambert, James H.},
  booktitle={2025 IEEE International Symposium on Systems Engineering (ISSE)},
  title={Knowledge Automation and Requirements Analysis in E-Commerce Fraud Detection},
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Fraud in e-commerce storefronts undermines consumer trust and inject counterfeit goods into global supply chains. This paper introduces a requirements-driven workflow that couples large language models (LLMs) with the machine learning operations pipeline to continuously refine and adapt storefront-fraud detection models, updating feature sets, thresholds, and evaluation criteria, without adding new data sources, improving performance and maintaining full traceability. The paper reproduces a public benchmark with labelled e-commerce storefront URLs and associated fraud indicators to establish a transparent baseline (random forest accuracy ≈ 0.970). An LLM module augmented with content from prior benchmarks, design docs, and other relevant information is used to iteratively revise the algorithm requirements during the model-creation, training, and testing phases. Several enhancements to the baseline are tested, with best results from a stacking ensemble model that showed statistically significant improvement in recall, with nominal improvements across four other metrics. The LLM-augmented method for requirements engineering in machine learning is adaptable to other supply-chain risk analytics where lightweight models must keep pace with evolving threats. Results indicate that coupling an LLM feedback layer with minimal-feature classifiers is a practical method to improve detection performance as fraud tactics evolve.},
