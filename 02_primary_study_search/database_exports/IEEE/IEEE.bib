@INPROCEEDINGS{11293702,
  author={Popescu-Cevei, P.L. and Santa, I.},
  booktitle={2025 IEEE 31st International Symposium for Design and Technology in Electronic Packaging (SIITME)},
  title={Reimagining Requirements Engineering for Automotive Systems: Boosting Efficiency with a Generative AI Assistant},
  year={2025},
  volume={},
  number={},
  pages={134-141},
  abstract={Requirements Engineering (RE) in automotive development faces growing challenges from increasing system complexity, strict safety standards, and the need for audit-ready documentation. Traditional RE processes depend on extensive manual effort and expert judgment to ensure clarity, testability, and compliance (e.g., ISO/IEC 29148, INCOSE guidelines), but often struggle to scale. Our work introduces the use of an enterprise-grade generative AI language model assistant, Copilot, to automate critical but repetitive tasks such as drafting, classifying, and refining requirements. The generative AI assistant transforms ambiguous stakeholder inputs into clear, testable requirements and streamlines workflow management ticket generation. Early trials demonstrate time savings of up to 50% for requirements classification and up to 90% for ticket description, driven by structured prompting and prompt-refinement. This approach improves consistency, traceability, and auditability while reducing manual overhead and accelerating time-to-specification.},
  keywords={Generative AI;Requirements management;Refining;Manuals;Transforms;Safety;Requirements engineering;Stakeholders;Standards;Automotive engineering;Requirements Engineering;Requirements Management;Automotive;ADAS;EARS;Generative AI;Copilot},
  doi={10.1109/SIITME67657.2025.11293702},
