@INPROCEEDINGS{11574122,
  author={Iatrellis, Omiros and Kosmopoulou, Ioanna and Panagiotakopoulos, Theodor and Samaras, Nicholas S.},
  booktitle={2026 IEEE Global Engineering Education Conference (EDUCON)},
  title={A Knowledge-Grounded and Generative Framework for Personalized Academic Advising},
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={The rapid rise of large language models (LLMs) has renewed interest in AI-enabled academic advising, yet purely neural approaches remain limited in high-stakes settings that require explainability, traceability, and policy alignment. This paper presents EDUC8EU, a semantically interoperable and explainable advising framework developed within the INVEST European University Alliance. EDUC8EU combines ontological knowledge representation, semantic rule reasoning, and fuzzy inference to produce transparent, personalized recommendations spanning career exploration, targeted pathway guidance, program eligibility checks, and institutional web integration. Building on this knowledge-grounded core, the system introduces a conversational layer powered by a constrained LLM that renders the platform’s structured outputs into an accessible, student-facing dialogue while remaining grounded in the underlying evidence and decision logic. The conversational interface supports reflective, one-question-at-a-time exploration and optional style adaptivity. A working web prototype was evaluated with 145 final-year Computer Science and Engineering students at the University of Thessaly. Learners used the system to explore two MSc programs (Software Engineering for Internet & Mobile Applications; Modern Communication Systems & IoT) embedded in the knowledge base. Survey results indicated high usability, strong perceived relevance, and increased confidence in academic choices; a follow-up survey six months post-graduation reported sustained satisfaction among those who pursued postgraduate study. Taken together, EDUC8EU demonstrates how a hybrid symbolic-generative approach can deliver the usability of conversational AI while preserving the auditability, curricular semantics, and institutional compliance required for responsible advising particularly in engineering-aligned contexts.},
  keywords={Ontologies;Programming;Modeling;Cognition;Cognitive systems;Large language models;Grounding;Educational institutions;Engineering profession;Printing;Academic Advising;Explainable AI;Fuzzy inference;Ontology-based Systems},
