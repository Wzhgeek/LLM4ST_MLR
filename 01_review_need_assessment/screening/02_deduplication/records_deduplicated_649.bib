@article{review_unique_0429,
  author = {C. Peter Keller},
  title = {Letting The User Talk: New Insights Into Cartographic Products},
  journal = {Geomatica},
  year = {1995},
  volume = {49},
  number = {1},
  pages = {31-36},
  doi = {10.5623/geomat-1995-0004},
  url = {https://www.sciencedirect.com/science/article/pii/S1195103624008656},
  abstract = {The computer revolution and associated advances in digital information packaging have opened hitherto unthinkable opportunities for the design and distribution of cartographic products. A new generation of sophisticated digital cartography products is emerging on the market. This new generation of products is driven by innovations in computing technology with little attention given to the user community’s wants, needs, technology know-how and technology access. This paper identifies the need for market research and user surveys to parallel innovations in the design and delivery of map and atlas products. A call is made for cartographic user surveys to evaluate the market's reaction to conventional and innovative cartographic products, and to test the users' willingness to use and pay for them. The paper introduces ongoing research into cartographic user surveys conducted at the Spatial Sciences Laboratories at the University of Victoria and highlights some of the preliminary research findings. La révolution informatique et les progrès qu’elle a engendrés dans la présentation des informations numériques ont ouvert la voie à des possibilités en matière de conception et de distribution de produits cartographiques inimaginables jusqu'ici. Une nouvelle génération de produits cartographiques numériques sophistiqués apparaît sur le marché. Elle se caractérise par des innovations en technologie informatique et ne laisse que peu de place aux goûts et aux besoins des usagers, ainsi qu’au savoir-faire et à l’accès technologiques. Cet article souligne la nécessité d'effectuer une étude de marché et des enquêtes relatives aux consommateurs pour allier innovations conceptuelles et distribution des cartes et des atlas. Il conviendrait également d effectuer des enquêtes sur les utilisateurs de produits cartographiques pour évaluer la réaction du marché devant des produits cartographiques conventionnels et novateurs, et pour savoir s’ils sont prêts à utiliser et à payer ces produits. L'article présente une recherche en cours portant sur l’utilisateur de produits cartographiques, que mènent les Spatial Sciences Laboratories (laboratoires de sciences spatiales) de l’université de Victoria, et souligne quelques unes des conclusions qui ont découlé de la recherche préliminaire.},
  issn = {1195-1036},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:KELLER199531},
  duplicate_count = {1},
}

@article{review_unique_0430,
  author = {Isra S. Ezad and Joshua J. Shea and Stephen F. Foley},
  title = {Hydrous minerals are sinks for first row transition elements in the mantle: An experimental partitioning study},
  journal = {Chemical Geology},
  year = {2025},
  volume = {690},
  pages = {122883},
  doi = {10.1016/j.chemgeo.2025.122883},
  url = {https://www.sciencedirect.com/science/article/pii/S0009254125002736},
  abstract = {Pyroxenites containing hydrous phases are increasingly recognised as contributing significant melt fractions to many primitive melts such as alkaline basalts, basanites, and lamproites. Although hydrous ultramafic rocks are minor components in the mantle, their low-temperature solidi compared to other mantle lithologies drives high melt productivity, making them significant contributors during fractional melting of heterogenous mantle domains. These hydrous ultramafic rocks contain phlogopite, amphibole, and apatite, and upon partial melting they produce distinct alkaline melts enriched in rare earth and high field strength elements when compared to basalts derived from peridotites. First row transition elements (FRTEs) are widely used indicators for identifying dry pyroxenite mantle lithologies in mantle sources, yet the partitioning behaviour of FRTEs between hydrous phases and alkaline melts remains poorly constrained. We present the first complete set of experimentally constrained partition coefficients for FRTEs between phlogopite, amphibole, and apatite and alkaline melts. Our results demonstrate that several FRTEs, Cr and Ni are compatible to highly compatible in phlogopite whilst Sc, Cr, Co and Ni are highly compatible in amphibole. We further demonstrate that coupling rare earth element concentrations with first-row transition elements is a powerful tool for discerning the mantle sources for basanites and lamproites globally.},
  keywords = {Mineral-melt partition coefficients, First-row transition elements, Hydrous minerals, Alkaline melts},
  issn = {0009-2541},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:EZAD2025122883},
  duplicate_count = {1},
}

@article{review_unique_0431,
