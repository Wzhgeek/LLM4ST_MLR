  journal = {Information and Software Technology},
  year = {2026},
  volume = {197},
  pages = {108164},
  doi = {10.1016/j.infsof.2026.108164},
  url = {https://www.sciencedirect.com/science/article/pii/S0950584926001539},
  abstract = {Context: Software systems increasingly rely on large ecosystems of libraries, frameworks, and platforms. While this interconnectedness accelerates development, it also gives rise to the persistent challenge of software license incompatibility. Rapid evolution of dependencies, heterogeneous execution environments, and the risk of deprecated or inconsistent APIs can lead to hidden costs, degraded reliability, and even security vulnerabilities. Objective: Such license incompatibilities often emerge late in the development lifecycle, where they are more difficult and costly to address. Detecting incompatibilities at early stages is therefore essential for ensuring robustness and sustainability. Method: In this paper, we introduce a novel approach that integrates Knowledge Graphs (KGs) with Large Language Models (LLMs) through a Retrieval-Augmented Generation (RAG) mechanism, enabling the automated detection of potential license incompatibilities and providing context-rich, citation-backed explanations. Results: Evaluation on 4000 Python open-source and 100 proprietary projects demonstrates that our approach achieves 98.1\% license detection accuracy, 96.2\% compatibility F1 score, and significantly enhanced explainability compared to existing methods. Conclusion: We expect that the proposed system, named LARK, will help mitigate legal risks and deliver a practical, scalable solution for detecting software license incompatibilities.},
  keywords = {Software license, Incompatibility detection, Large language models, Retrieval-Augmented Generation, Knowledge graph},
  issn = {0950-5849},
