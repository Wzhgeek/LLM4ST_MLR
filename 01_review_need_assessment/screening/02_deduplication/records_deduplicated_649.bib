@article{review_unique_0259,
  author = {Duraid Thamer Salim and Manmeet Mahinderjit Singh and Pantea Keikhosrokiani},
  title = {A systematic literature review for APT detection and Effective Cyber Situational Awareness (ECSA) conceptual model},
  journal = {Heliyon},
  year = {2023},
  volume = {9},
  number = {7},
  pages = {e17156},
  doi = {10.1016/j.heliyon.2023.e17156},
  url = {https://www.sciencedirect.com/science/article/pii/S2405844023043645},
  abstract = {Advancements in computing technology and the growing number of devices (e.g., computers, mobile) connected to networks have contributed to an increase in the amount of data transmitted between devices. These data are exposed to various types of cyberattacks, one of which is advanced persistent threats (APTs). APTs are stealthy and focus on sophisticated, specific targets. One reason for the detection failure of APTs is the nature of the attack pattern, which changes rapidly based on advancements in hacking. The need for future researchers to understand the gap in the literature regarding APT detection and to explore improved detection techniques has become crucial. Thus, this systematic literature review (SLR) examines the different approaches used to detect APT attacks directed at the network system in terms of approach and assessment metrics. The SLR includes papers on computer, mobile, and internet of things (IoT) technologies. We performed an SLR by searching six leading scientific databases to identify 75 studies that were published from 2012 to 2022. The findings from the SLR are discussed in terms of the literature's research gaps, and the study provides essential recommendations for designing a model for early APT detection. We propose a conceptual model known as the Effective Cyber Situational Awareness Model to Detect and Predict Mobile APTs (ECSA-tDP-MAPT), designed to effectively detect and predict APT attacks on mobile network traffic.},
  keywords = {APT malware, Network traffic, Intrusion detection system, Machine learning, Attack behaviour, Situation awareness model},
  issn = {2405-8440},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:SALIM2023e17156},
  duplicate_count = {1},
}

@article{review_unique_0260,
  author = {Y. Zhang and Q.Y. Su and X. Song and X. Zhang and N. Sun and X. Duan and C. Wei and X. Jiang and S.X. Zhang},
  title = {ABS0684 THE IMPACT OF LIFESTYLE HABITS ON DISEASE ACTIVITY AND IMMUNE PROFILES IN MYOSITIS PATIENTS: A COMPREHENSIVE STUDY},
  journal = {Annals of the Rheumatic Diseases},
  year = {2025},
  volume = {84},
  pages = {1689-1691},
  doi = {10.1016/j.ard.2025.06.1123},
  url = {https://www.sciencedirect.com/science/article/pii/S0003496725031760},
  abstract = {Background: Myositis encompasses a group of autoimmune inflammatory muscle diseases that can affect individuals across all age groups, leading to proximal muscle weakness, typical skin lesions, and involvement of multiple organs [1]. Recent studies have highlighted the role of lifestyle factors, such as body mass index (BMI), smoking, and alcohol consumption, in the pathogenesis of various autoimmune diseases [2]. These factors are believed to significantly impact disease activity in myositis patients. However, the specific mechanisms by which these lifestyle habits influence myositis remain poorly understood. Understanding these relationships is crucial for developing personalized treatment strategies and improving patient outcomes. Objectives: This study aimed to evaluate the correlation between BMI and changes in lymphocyte subsets, as well as their impact on disease activity in myositis patients. Additionally, we explored the combined effects of BMI, smoking, and alcohol consumption on disease severity. Methods: We recruited 591 myositis patients from the Department of Rheumatology, Shanxi Medical University, and 192 healthy individuals. Disease activity in patients with dermatomyositis (DM) was quantified using the Dermatomyositis Disease Area and Severity Index (CDASI) and the Dermatomyositis Skin Severity Index (DSSI). Lymphocyte subsets were analyzed using analysis of variance (ANOVA) and independent samples t-tests. A p-value of less than 0.05 (two-tailed) was considered statistically significant. Results: Myositis patients exhibited significantly reduced numbers and percentages of Th1 cells and Treg cells compared to healthy individuals. Additionally, the ratios of Th1/Treg and Th17/Treg were significantly increased, indicating disordered immune function in myositis patients. The CDASI and DSSI scores were lower in patients with low BMI compared to those with high and medium BMI. Smoking patients with low BMI had higher CDASI scores. For patients with medium BMI, smokers and drinkers had higher CDASI activity indices than non-drinkers, suggesting that alcohol consumption may be associated with increased disease activity. The DSSI and CDASI scores of the high BMI non-smoking group were higher than those of the medium BMI smoking group, indicating that the effect of BMI on disease activity may be greater than that of smoking. Conclusion: Our findings demonstrate that obesity is associated with higher disease activity in myositis patients, and poor lifestyle habits, such as smoking and alcohol consumption, can significantly affect disease progression. These results highlight the importance of lifestyle modifications, including maintaining a healthy weight, smoking cessation, and alcohol abstinence, in the management of myositis. Clinicians should emphasize lifestyle interventions as a critical component of comprehensive treatment strategies to improve disease control and patient outcomes. Figure 1Comparison of CDASI in Myositis Patients with Different BMI.*P<0.05. Figure 2Comparison of DSSI in Myositis Patients with Different BMI.*P<0.05, ** P<0.01. Figure 3Comparison of peripheral CD4 + T cell subset levels between IIM patients and HC. *P<0.05, ** P<0.01, *** P<0.001. Figure 4Comparison of disease activity in IIM patients with different BMI versus smoking and alcohol or not.*P<0.05. Figure 5Comparison of disease activity between IIM patients with different BMI versus smoking or not. *P<0.05. REFERENCES: [1] Caoilfhionn M Connolly, Julie J Paik. Clinical pearls and promising therapies in myositis.Expert Rev Clin Immunol. 2023 Jul-Dec;19(7):797-811. PMID: 37158055 PMCID: PMC10330909 DOI: 10.1080/1744666X.2023.2212162. [2] Frederick W Miller, Janine A Lamb, Jens Schmidt, Kanneboyina Nagaraju. Risk factors and disease mechanisms in myositis. Nat Rev Rheumatol. 2018 Apr 20;14(5):255-268. PMID: 29674613 PMCID: PMC6745704 DOI: 10.1038/nrrheum.2018.48. Acknowledgements: This project was supported by grants from the Natural Science Foundation of Shanxi Province (No. 202203021221269). Disclosure of Interests: None declared. © The Authors 2025. This abstract is an open access article published in Annals of Rheumatic Diseases under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/). Neither EULAR nor the publisher make any representation as to the accuracy of the content. The authors are solely responsible for the content in their abstract including accuracy of the facts, statements, results, conclusion, citing resources etc.},
  keywords = {Health services research, Diet and nutrition, Lifestyles},
  note = {EULAR 2025: European Congress of Rheumatology},
  issn = {0003-4967},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:ZHANG20251689},
  duplicate_count = {1},
}

@article{review_unique_0261,
  author = {Jean-Michel Arnal and Sonia Khirani},
  title = {Monitoring home mechanical ventilation: Polysomnography or built-in ventilator software?},
  journal = {Respiratory Medicine},
  year = {2026},
  volume = {253},
  pages = {108713},
  doi = {10.1016/j.rmed.2026.108713},
  url = {https://www.sciencedirect.com/science/article/pii/S0954611126000818},
  abstract = {Monitoring of home mechanical ventilation (HMV) and continuous positive airway pressure (CPAP) is essential to guarantee an efficient ventilation. Hospital attended polysomnography (PSG), or at least respiratory polygraphy, remains the gold standard for the monitoring of HMV/CPAP. However, it is time-consuming, costly and not practical. Built-in ventilator software data represent a good alternative, but some limitations have to be acknowledged. Adherence, leaks and patient-ventilator asynchrony (PVA) are among the main data to monitor, and the analysis of these data can be easily done using built-in ventilator software. Residual respiratory events can also be monitored using built-in ventilator software, with the limitation that their identification and characterization are not always optimal. PSG may be indicated when the analysis of breath-by-breath waveforms of built-in ventilator software is not conclusive. PSG or thoraco-abdominal belts connected to a ventilator may also be useful to identify PVA related to an insufficient pressure support. This review summarizes the information available when using built-in ventilator software data, highlighting their advantages and drawbacks as compared to PSG for the monitoring of HMV/CPAP, and addresses the situations where one approach may be more appropriate than the other. The availability of thoraco-abdominal belts for additional ventilators may represent a valuable development, enabling an improved monitoring of HMV/CPAP, particularly in settings with limited resources.},
  keywords = {HMV, CPAP, Monitoring, Polysomnography, Built-in ventilator software},
  issn = {0954-6111},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:ARNAL2026108713},
  duplicate_count = {1},
}

@article{review_unique_0262,
  author = {Carliss Y. Baldwin and Marcel L.A.M. Bogers and Rahul Kapoor and Joel West},
  title = {Focusing the ecosystem lens on innovation studies},
  journal = {Research Policy},
  year = {2024},
  volume = {53},
  number = {3},
  pages = {104949},
  doi = {10.1016/j.respol.2023.104949},
  url = {https://www.sciencedirect.com/science/article/pii/S0048733323002330},
  abstract = {For nearly a century, the key role of innovation in economic growth has been acknowledged and studied. Today, innovations are increasingly understood as being embedded in ecosystems of autonomous actors, whether firms, other organizations, or individuals. These actors contribute in complementary ways to create a value proposition that is greater than the sum of the parts, with the integration of their products and processes made possible by modular interfaces between actors. Here we review the emergence of the ecosystem lens within innovation studies in the context of the Special Issue on Innovation Ecosystems and Ecosystem Innovation. After summarizing the history of the special issue, we review the nine articles in the special issue and show how they relate to defining the actors, joint value creation by the actors, coordinating the actors, value capture by the actors, and then the large issue of analyzing ecosystems as the unit of analysis. From this, we offer suggestions for future ecosystem research, including opportunities to combine the ecosystem lens with other lenses used in innovation studies, and new methods for studying ecosystem phenomena.},
  keywords = {Ecosystems, Platforms, Value creation, Value capture, Complementarity, Ecosystem governance},
  issn = {0048-7333},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:BALDWIN2024104949},
  duplicate_count = {1},
}

