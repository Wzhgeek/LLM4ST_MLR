@inproceedings{review_unique_0158,
  author = {Li, Jiandong and Liu, Shaoying and Liu, Ai and Huang, Runhe},
  title = {Multilevel Traceability Links Establishments Between SOFL Formal Specifications and Java Codes Using Multi-dimensional Similarity Measures},
  journal = {IEEE International Conference on Software Quality, Reliability and Security, QRS},
