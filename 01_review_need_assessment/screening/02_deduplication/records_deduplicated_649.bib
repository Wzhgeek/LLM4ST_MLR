}

@article{review_unique_0290,
  author = {Fiona A. Wilkes and David Jakabek and Mark Walterfang and Dennis Velakoulis and Govinda R. Poudel and Julie C. Stout and Phyllis Chua and Gary F. Egan and Jeffrey C.L. Looi and Nellie Georgiou-Karistianis},
  title = {The shape of things to come. Mapping spatiotemporal progression of striatal morphology in Huntington disease: The IMAGE-HD study},
  journal = {Psychiatry Research: Neuroimaging},
  year = {2023},
  volume = {335},
  pages = {111717},
  doi = {10.1016/j.pscychresns.2023.111717},
  url = {https://www.sciencedirect.com/science/article/pii/S0925492723001270},
  abstract = {Mapping the spatiotemporal progression of neuroanatomical change in Huntington's Disease (HD) is fundamental to the development of bio-measures for prognostication. Statistical shape analysis to measure the striatum has been performed in HD, however there have been a limited number of longitudinal studies. To address these limitations, we utilised the Spherical Harmonic Point Distribution Method (SPHARM-PDM) to generate point distribution models of the striatum in individuals, and used linear mixed models to test for localised shape change over time in pre-manifest HD (pre-HD), symp-HD (symp-HD) and control individuals. Longitudinal MRI scans from the IMAGE-HD study were used (baseline, 18 and 30 months). We found significant differences in the shape of the striatum between groups. Significant group-by-time interaction was observed for the putamen bilaterally, but not for caudate. A differential rate of shape change between groups over time was observed, with more significant deflation in the symp-HD group in comparison with the pre-HD and control groups. CAG repeats were correlated with bilateral striatal shape in pre-HD and symp-HD. Robust statistical analysis of the correlates of striatal shape change in HD has confirmed the suitability of striatal morphology as a potential biomarker correlated with CAG-repeat length, and potentially, an endophenotype.},
  keywords = {Striatum, Endophenotype, Biomarker, Huntington's disease},
  issn = {0925-4927},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:WILKES2023111717},
  duplicate_count = {1},
}

@article{review_unique_0291,
  author = {V. Cantu-Martinez and R.L. Polina-Lugo and F.M. Garcia-Carrillo and D.A. Mejia-Rodriguez and E.S. Reyna-Hernandez and J.A. {Cardenas-de la Garza} and R.I. Arvizu-Rivera and M.A. Villarreal-Alarcon},
  title = {ABS0663 A COMPREHENSIVE CARE PROGRAM FOR THE EARLY CANCER DETECTION IN PATIENTS WITH IDIOPATHIC INFLAMMATORY MYOPATHIES},
  journal = {Annals of the Rheumatic Diseases},
  year = {2025},
  volume = {84},
  pages = {1688-1689},
  doi = {10.1016/j.ard.2025.06.1121},
  url = {https://www.sciencedirect.com/science/article/pii/S0003496725031747},
  abstract = {Background: The elevated risk of developing cancer in Idiopathic Inflammatory Myopathies (IIM) has been well-documented, with the highest risk occurring within the first 3 to 5 years following the disease diagnosis. Given that cancer represents the leading cause of mortality in IIM, implementing effective screening strategies is crucial for enabling early detection and timely intervention. Studies indicate that cancer prevalence in IIM ranges from 15 to 25\%, with dermatomyositis posing the highest risk. The most common malignancies include ovarian, lung, breast and colorectal cancers, which vary geographically based on patient demographics. Furthermore, specific serological markers, such as anti-TIF1γ and anti-NXP2 antibodies, have been associated with a greater risk of cancer. This underscores the necessity of establishing a comprehensive multidisciplinary management program that integrates cancer screening according to risk stratification into routine care, addressing the complex needs of these patients. This approach not only improves therapeutic and prognostic outcomes but also underscores the necessity of establishing a comprehensive multidisciplinary management program to address the complex needs of these patients. Objectives: To describe the model for the early detection of cancer in patients with IIM in our center's multidisciplinary care program for patients with rheumatic diseases. Methods: The Early Cancer Detection Program is part of the Rheumatology Clinic at Dr. José Eleuterio González University Hospital in Nuevo León, Mexico, starting March 1, 2024. It targets patients over 18 years old with a diagnosis of IIM. The program has three main objectives: a)Stratify Cancer Risk in IIM Patients: This is achieved through a digital calculator based on the International Guideline for Idiopathic Inflammatory Myopathy-Associated Cancer Screening, developed by rheumatologists. Patients are classified into high, intermediate, or low-risk categories.b)Educate Patients on the Importance of Early Cancer Detection: The program emphasizes the importance of screening tests according to each patient's risk level. These tests include low-dose computed tomography (CT), fecal immunochemical test (FIT), mammography and cervical cytology for women, and prostate-specific antigen (PSA) for men.c)Identify Common Cancers in IIM Patients: If a screening test yields a positive result, patients are referred for oncology consultation to optimize their clinical prognosis. If the test result is negative, patients are monitored through individualized follow-up. As quality indicators for our objectives, the following metrics have been established: 1Percentage of patients who underwent screening based on age and sex.2Time from IIM diagnosis to completion of age- and sex-specific screening.3Percentage of patients with a positive screening result.4Percentage of patients who have not undergone screening. Data are presented with descriptive statistics. Categorical variables are presented as total and percentages, and continuous variables are presented as mean, standard deviation (SD), median, and interquartile range (IQR). Results: A total of 53 patients with IIM were recruited (Table 1): 45 women and 8 men, with an average age of 47.3±17.1 years. Screening rates were highest in the high-risk group (80\%) and lowest in the intermediate-risk group (38\%). Screening completion varied significantly, the median time to undergo at least one screening and the diagnostic delay for IIM was 8.0 (3.5-12.0) months. Women over 40 took the longest time for procedures like colon screening (23.5 ± 24.7 months) and mammography (26.5 ± 66.9 months). Regarding lung cancer screening, 100\% procedures were performed in men over 40 years old. Breast and cervix screenings were performed in 80\% and 83.3\% of women over 40, respectively, while colon and prostate screenings were less frequent. Regarding the screening results (Table 2), lung screening was the most common, with positive findings in 5.6\% of patients, but no neoplasms were diagnosed upon follow-up. One of three positive breast cancer screenings was positive for breast adenocarcinoma and one of four positive cervical cancer screenings confirmed a high-grade squamous intraepithelial lesion. There were 22 negative screenings for colorectal cancer and the rest were not performed. Conclusion: Our findings reveal that most patients with IIM were classified as high cancer risk, underscoring the clinical importance of risk stratification based on established guidelines. Despite these insights, gaps in cancer screening, particularly in intermediate-risk patients, highlight the urgent need for targeted education and intervention strategies. Enhancing screening adherence and addressing comorbidities in IIM patients can significantly improve early detection, patient outcomes, and overall quality of care. Additionally, multidisciplinary efforts and the implementation of personalized management plans are crucial for optimizing cancer prevention strategies in this vulnerable population. REFERENCES: [1] Patasova K, Lundberg IE, Holmqvist M. Genetic influences in Cancer‐Associated myositis. Arthritis \& Rheumatology [Internet]. 2022 Sep 2;75(2):153–63. Available from: https://doi.org/10.1002/art.42345. [2] Trallero-Araguás E, Gil-Vila A, Martínez-Gómez X, Pinal-Fernández I, Alvarado-Cardenas M, Simó-Perdigó M, et al. Cancer screening in idiopathic inflammatory myopathies: Ten years experience from a single center. Seminars in Arthritis and Rheumatism [Internet]. 2021 Dec 31;53:151940. Available from: https://doi.org/10.1016/j.semarthrit.2021.12.008. Acknowledgements: NIL. Disclosure of Interests: None declared. © The Authors 2025. This abstract is an open access article published in Annals of Rheumatic Diseases under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/). Neither EULAR nor the publisher make any representation as to the accuracy of the content. The authors are solely responsible for the content in their abstract including accuracy of the facts, statements, results, conclusion, citing resources etc.},
  keywords = {Health services research, Oncology, Descriptive Studies, Quality of care},
  note = {EULAR 2025: European Congress of Rheumatology},
  issn = {0003-4967},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:CANTUMARTINEZ20251688},
  duplicate_count = {1},
}

@article{review_unique_0292,
  author = {Mélissa Duplessis and Tom C. Wright and Masoumeh Bejaei},
  title = {A survey of Canadian dairy nutritionists to assess current trace element formulation practices},
  journal = {Journal of Dairy Science},
  year = {2023},
  volume = {106},
  number = {6},
  pages = {4030-4041},
  doi = {10.3168/jds.2022-22943},
  url = {https://www.sciencedirect.com/science/article/pii/S0022030223002047},
  abstract = {ABSTRACT The purpose of this study was to identify current practices and perceptions around trace element feeding for dairy cows through a Canadian dairy nutritionist survey. An online survey with 23 questions was used to collect data from Canadian dairy nutritionists with the help of professional associations and social media. The survey was active from November 2021 to April 2022. The first 7 questions collected descriptive information on respondents, and the subsequent 16 questions focused on trace element feeding. A total of 92 participants from all over Canada filled out the survey, and about 26\% of Canadian herds and cows were represented by these respondents. The participants had diverse views on the importance of diet formulations for trace elements to optimize cow health and productivity, with perceptions varying from very important to not important. In comparison, macronutrients and selenium were consistently rated as very important by between 58\% and 74\% of respondents. Software reference values were used by 54\%, 72\%, and 73\% of participants to estimate trace element concentrations of forages, cereals, and protein sources, respectively, highlighting the importance of regularly updating the feed library of the software. More than 60\% of nutritionists participating in this study had intentionally formulated diets above trace element software recommendations, considered mineral interactions occurring in the rumen, and used a trace element source known for its better bioavailability (e.g., organic, chelate) when they formulated diets. Herds with more than 80 cows were more likely to be given trace element supplements known for their greater bioavailability. The most used supplement with enhanced bioavailability was selenium. In addition, different trace element feeding strategies pertaining to different stages of lactation and breeds were reported. This finding can be explained by the absence of clear recommendations on trace element feeding by breed. The participants who adjusted trace element feeding according to the stages of lactation considered the transition period as the most challenging period, and they identified the need for a source of trace element known for its greater bioavailability for this period. Further research should aim to identify environmental risk of trace element overfeeding using the One Health approach. Moreover, strategies to avoid trace element overfeeding should be evaluated.},
  keywords = {dairy cattle, questionnaire, trace mineral, advisor, recommendation},
  issn = {0022-0302},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:DUPLESSIS20234030},
  duplicate_count = {1},
}

@article{review_unique_0293,
  author = {Sonia Khirani and Alessandro Amaddeo and Lucie Griffon and Marine Dosso and Meryl Vedrenne-Cloquet and Clément Poirault and Benjamin Dudoignon and Brigitte Fauroux},
  title = {Home paediatric CPAP/NIV: the basics},
  journal = {Sleep Medicine},
