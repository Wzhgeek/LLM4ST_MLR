  url = {https://www.sciencedirect.com/science/article/pii/S1546223426000407},
  abstract = {ABSTRACT The proliferation of digital services has led to a surge in cyber crimes, while traditional detection methods face bottlenecks such as labeled data scarcity, data imbalance, and poor adaptability to zero-day attacks. To address these issues, this study proposes CRAD-Defender, an end-to-end framework integrating self-supervised learning (SSL), graph neural networks (GNNs), and reinforcement learning (RL). It fuses MoCo v3 and GraphSAGE-GAT to capture individual behavioral features and cross-entity relational risks, adopts One-Class SVM for initial anomaly detection, and leverages DQN for closed-loop optimization of detection parameters. Experimental evaluations on UNSW-NB15 and CSE-CIC-IDS2019 datasets show CRAD-Defender outperforms baseline models with an F1-score of 0.91 and 0.89, ultra-low FPR of 1.1\% and 1.3\%, and low detection latency. Ablation studies verify the synergistic effectiveness of each core module, demonstrating the framework’s superiority in accurate, real-time cyber crime risk classification and anomaly detection.},
  keywords = {Self-Supervised Learning, Cyber Crime Detection, Anomaly Detection, Graph Neural Networks, Reinforcement Learning},
  issn = {1546-2234},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
