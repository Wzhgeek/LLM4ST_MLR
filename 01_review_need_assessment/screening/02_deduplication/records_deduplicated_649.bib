  title = {Understanding the Characteristics of Visual Contents in Open Source Issue Discussions: A Case Study of Jupyter Notebook},
  booktitle = {Proceedings of the 26th International Conference on Evaluation and Assessment in Software Engineering},
  series = {EASE '22},
  publisher = {Association for Computing Machinery},
  year = {2022},
  pages = {249–254},
