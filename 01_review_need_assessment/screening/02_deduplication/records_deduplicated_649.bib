  author = {Yuanbang Li and Tianping Zhang and Rong Peng and Xiaomin Wang and Shiyan Chen},
  title = {VATAL: Virtual Adversarial Training and Adaptive Hybrid Loss based on pre-trained language model for issue-commit link recovery},
  journal = {Journal of Systems and Software},
  year = {2026},
  volume = {241},
  pages = {112938},
  doi = {10.1016/j.jss.2026.112938},
  url = {https://www.sciencedirect.com/science/article/pii/S0164121226001718},
  abstract = {In recent years, pre-trained large language models have achieved strong performance in issue–commit traceability link prediction. However, existing approaches remain vulnerable to minor variations in textual artifacts, leading to unstable predictions, and often fail to effectively capture the consistency among links of the same type. Such limitations hinder reliable traceability in real-world software development environments, where artifact descriptions are frequently noisy and heterogeneous. To address these challenges, this paper proposes VATAL, a robust traceability framework that integrates virtual adversarial training and an adaptive loss optimization strategy. The proposed method jointly enhances prediction stability against input perturbations and strengthens intraclass feature cohesion during model training. Experimental results on five benchmark datasets demonstrate that VATAL consistently outperforms the state-of-the-art baseline BTLink, achieving an average F1-score improvement of 4.35\%, which is statistically significant (p-value = 0.0134). Further analysis confirms that the proposed strategy improves both robustness and discriminative representation learning for traceability tasks.},
  keywords = {Large language model, Virtual adversarial training, Adaptive Hybrid Loss, Issue–commit link recovery, Artificial intelligence},
  issn = {0164-1212},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:LI2026112938},
  duplicate_count = {1},
}

@article{review_unique_0298,
  author = {Gilmar Pagoto and Luiz Eduardo Galvão Martins and Jefferson Seide Molléri},
