@article{review_unique_0379,
  author = {Enliang Ren and Li Wang and Xuanhao Qiu and Qi Wang and Liping Wang and Ruxin Zhang and Qi Liu and Zhongyi Qu},
  title = {Calcium-carbon interactions via citric acid activation and lanthanum modification of high-Ca fly ash: A novel route for saline-alkali land reclamation},
  journal = {Environmental Technology \& Innovation},
  year = {2025},
  volume = {40},
  pages = {104416},
  doi = {10.1016/j.eti.2025.104416},
  url = {https://www.sciencedirect.com/science/article/pii/S235218642500402X},
  abstract = {The dual constraints of saline-alkali stress and organic carbon deficiency pose significant challenges to agricultural sustainability, while the utilization of industrial solid wastes for soil remediation remains in exploratory stages. Particularly, the potential of calcium-rich fly ash (CFA) to achieve simultaneous desalination and carbon enhancement through chemical activation has not been systematically investigated. This study developed a novel soil amendment based on synergistic citric-acid activation and lanthanum modification of high-calcium fly ash. Through systematic optimization of citric-acid concentration (0.01–2 mol·L−1), liquid-solid ratio (5–25 mL·g−1), CFA particle size (0.045–0.425 mm), reaction temperature (0–80 °C), and time (10–160 min), a targeted transformation of Ca-C species in CFA was achieved, boosting its organic-carbon content to 15.84 g·kg−1 (2.3-fold increase over raw CFA). Fourier transform infrared spectroscopy, Raman spectroscopy, X-ray diffraction, scanning electron microscopy, and mineral liberation analysis demonstrated that citric acid, via proton exchange and carboxylate chelation, converts inorganic Ca into soluble calcium-citrate complexes, while La3+ incorporation stabilizes the Ca-C coordination network, inhibits Ca-salt recrystallization, and reinforces the organic-carbon framework. Greenhouse pot amended with 10 wt\% lanthanum-co-modified CFA reduced soil pH by 1.01 units (11.56 \%), soluble salts by 17.25 \%, and significantly enriched soil organic-carbon pools (soil and active organic carbon), confirming that CFA co-modified with citric acid and lanthanum can simultaneously mitigate salinity and rebuild soil carbon stocks. These findings provide significant implications for industrial waste management, soil quality improvement strategies, and sustainable agriculture in salt-affected regions, addressing both environmental pollution and food security challenges.},
  keywords = {High-calcium fly ash, Citric acid, Lanthanum, Calcium speciation regulation, Saline-alkali soil amelioration},
  issn = {2352-1864},
  retrieval_databases = {ScienceDirect},
  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:REN2025104416},
  duplicate_count = {1},
}

