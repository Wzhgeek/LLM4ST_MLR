}

@article{review_unique_0629,
  author = {Andreassen, Rune and Bråten, Ivar},
  title = {Teachers' source evaluation self-efficacy predicts their use of relevant source features when evaluating the trustworthiness of web sources on special education},
  journal = {British Journal of Educational Technology},
  year = {2013},
  volume = {44},
  number = {5},
