  retrieval_source_files = {ScienceDirect/SD.bib},
  retrieval_query_ids = {SD},
  retrieval_original_keys = {SD.bib:ROSA2023111729},
  duplicate_count = {1},
}

@article{review_unique_0461,
  author = {Da-peng ZHU and Huan LI and Wei-cheng JIANG and Chong WANG and Xiao-Jun HU and Hua KONG},
  title = {Ore-forming environment of Pb−Zn mineralization related to granite porphyry at Huangshaping skarn deposit, Nanling Range, South China},
