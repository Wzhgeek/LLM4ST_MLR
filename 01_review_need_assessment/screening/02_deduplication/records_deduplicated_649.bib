  author = {Janarthanan Sekar and Meenambigai Ganesan and Kavitha Manivel and Pazhamalai Srinivasan},
  title = {Physiochemical properties optimization of synthetic bio-destructible 2,6-bisarylidene-4-(t.-butyl)cyclohexanones to select a potential anti-cancer drug contender},
  journal = {Journal of Molecular Structure},
  year = {2025},
