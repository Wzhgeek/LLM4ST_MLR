  author = {Wong, L. and Buechler, G. and Downs, W. and Sjogren, W. and Muller, P. and Gottlieb, P.},
  title = {A surface-layer representation of the lunar gravitational field},
  journal = {Journal of Geophysical Research (1896-1977)},
  year = {1971},
