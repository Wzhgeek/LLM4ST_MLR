	author = {Kita, Yoshihiro and Tokuoka, Suzumi M. and Oda, Yoshiya and Shimizu, Takao},
	title = {TRACES: A Lightweight Browser for Liquid Chromatography–Multiple Reaction Monitoring–Mass Spectrometry Chromatograms},
