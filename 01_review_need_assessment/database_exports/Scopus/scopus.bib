	keywords = {Automation; Learning systems; Life cycle; Regulatory compliance; Software design; Supervised learning; Change management; Deep learning; Language model; Machine learning approaches; Machine-learning; Software artefacts; Software development life-cycle; Software traceability; Systematic literature review; Transfer learning; Deep learning},
