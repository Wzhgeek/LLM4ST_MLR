@inbook{doi:https://doi.org/10.1002/9781119312451.ch7,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781119312451},
title = {Verification and Validation},
booktitle = {Software Quality Assurance},
chapter = {7},
pages = {249-294},
doi = {https://doi.org/10.1002/9781119312451.ch7},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119312451.ch7},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781119312451.ch7},
year = {2017},
keywords = {customer requirements, development life cycle, implementation plan, international standards, software verification and validation activities, software-based system safety, traceability},
abstract = {Abstract The introduction of innovative products associated with software that contain an increasing number of functions often involves increasing the number of computer processing units and size of software. This chapter presents verification and validation (V\&V) for software. It explains the concepts of V\&V and the intended benefits and costs. The chapter then presents the international standards and models that define V\&V activities or impose them in certain situations. It also presents a brief discussion on the importance of independent V\&V (IV\&V) in critical projects. The chapter provides more detail for one of the V\&V activities often required for safety: traceability. Verification aims to show that an activity was done correctly, in accordance with its implementation plan and has not introduced defects in its output. Validation is composed of a series of activities which start, early in the development life cycle, with the validation of customer requirements.}
}
