author = {Chaoqing Feng and Lizhuang Zhang and Rui Wang and Hongbin Yang and Zhao Xu and Suying Yan},
keywords = {Greenhouse, Coverage, Dimming, Temperature control},
abstract = {A new type of greenhouse cover plate with light and temperature control function is proposed. The optical software is used to simulate the concentrating characteristics of the cover plate. The simulation results show that the new cover plate has the characteristics of higher receiving rate when the incident angle is small, higher transmittance when the incident angle is large, and this tendency is more obvious when the position of fluid channel become higher and the radius become smaller. The experimental samples were processed and the acceptance rate and transmission rate were tested in typical sunny weather. The experimental and simulation results are matched well. At noon, the transmittance of the new cover plate reaches about 35% of the lowest in a day, while that of the double glass cover plate is about 70%. This new type of cover can not only realize the light control function, but also realize the efficient thermal utilization of solar energy, so it has a broad application prospect.}
}
@article{FOURNIER2005727,
